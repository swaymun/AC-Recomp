#!/bin/bash
# Original host only. App bundles, device IDs and captures remain ignored.
set -euo pipefail
cd "$(dirname "$0")/.."
case "${1:---input-test}" in
  --input-test|--simulators) ;;
  *) echo 'usage: scripts/check-ios-host [--input-test|--simulators]' >&2; exit 2 ;;
esac
[[ $# -le 1 ]] || { echo 'Expected one mode' >&2; exit 2; }
exec python3 - "${1:---input-test}" <<'PY'
import datetime
import hashlib
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import time
import uuid

root = Path.cwd()
private = root / '.local/ios-launch-rescue-026'
private.mkdir(parents=True, exist_ok=True)
if subprocess.run(['git', 'check-ignore', '-q', str(private)], timeout=10).returncode:
    raise SystemExit('Refusing non-ignored evidence directory')
run = private / ('run-' + datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ') + '-' + uuid.uuid4().hex[:6])
run.mkdir()
print('private_evidence=' + str(run), flush=True)
log = (run / 'commands.log').open('w')
summary = {'unit': 'IOS-LAUNCH-RESCUE-026', 'mode': sys.argv[1], 'minimum_target': '26.0',
           'runtime': '26.5', 'results': {}, 'game_runtime_integrated': False,
           'ui_touch_injection': 'not exercised by this command; separate visible UI evidence is required'}

def command(args, timeout=30, check=True):
    args = list(map(str, args))
    log.write('$ ' + ' '.join(args) + '\n'); log.flush()
    started = time.monotonic()
    child = subprocess.Popen(args, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                             start_new_session=True)
    try:
        output, _ = child.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        # Own child group only: compiler helpers cannot escape a timed-out build.
        os.killpg(child.pid, signal.SIGKILL)
        output, _ = child.communicate(timeout=5)
        log.write(output + '\nTIMEOUT seconds=' + str(timeout) + '\n'); log.flush()
        raise RuntimeError('bounded command timed out: ' + ' '.join(args))
    result = subprocess.CompletedProcess(args, child.returncode, output)
    log.write('elapsed_seconds=' + str(round(time.monotonic() - started, 3)) + '\n')
    log.write(result.stdout + '\nexit_code=' + str(result.returncode) + '\n'); log.flush()
    if check and result.returncode:
        raise RuntimeError('command failed: ' + ' '.join(args) + '\n' + result.stdout)
    return result

runtime = 'com.apple.CoreSimulator.SimRuntime.iOS-26-5'
bundle = 'local.acs.launch-rescue-026'
families = {'iPhone': 'com.apple.CoreSimulator.SimDeviceType.iPhone-17-Pro',
            'iPad': 'com.apple.CoreSimulator.SimDeviceType.iPad-Pro-11-inch-M5-12GB'}
devices = {}
booted_here = []
before = None

def inventory():
    return json.loads(command(['xcrun', 'simctl', 'list', 'devices', '--json']).stdout)

def owned(family):
    entry = devices[family]
    expected = {'name': 'ACS IOS-LAUNCH-RESCUE-026 ' + family, 'runtime': runtime,
                'type': families[family]}
    if any(entry.get(k) != v for k, v in expected.items()):
        raise RuntimeError('Registry ownership mismatch for ' + family)
    matches = [d for d in inventory()['devices'].get(runtime, []) if d['udid'] == entry['udid']]
    if len(matches) != 1 or matches[0]['name'] != expected['name'] or matches[0]['deviceTypeIdentifier'] != expected['type'] or not matches[0]['isAvailable']:
        raise RuntimeError('Refusing non-task simulator ' + family)
    return matches[0]

def sim(family, action, *args, **kwargs):
    # Recheck ownership immediately before every device operation. Never 'booted'.
    d = owned(family)
    return command(['xcrun', 'simctl', action, d['udid'], *args], **kwargs)

def completion(docs, token, family):
    end = time.monotonic() + 20
    while time.monotonic() < end:
        if (docs / 'failure.json').exists():
            raise RuntimeError((docs / 'failure.json').read_text())
        if (docs / 'completed.json').exists():
            report = json.loads((docs / 'completed.json').read_text())
            if report.get('evidence_run') == token:
                if (report['completed_gpu_frames'] < 60 or report['simulator'] != 1 or
                    report['runtime'] != '26.5' or report['bundle'] != bundle or
                    report['view_size'][0] <= report['view_size'][1]):
                    raise RuntimeError('Incorrect app completion metadata: ' + family)
                stages = [json.loads(line) for line in (docs / 'startup.jsonl').read_text().splitlines()]
                stages = [entry for entry in stages if entry['evidence_run'] == token]
                required = {'main', 'did-finish-launching', 'scene-connect', 'window-visible',
                            'scene-active', 'first-draw', 'first-gpu-completed'}
                if not required.issubset({entry['stage'] for entry in stages}):
                    raise RuntimeError('Missing UIKit/Metal callbacks: ' + family)
                if {entry['pid'] for entry in stages} != {report['pid']}:
                    raise RuntimeError('Journal/renderer PID disagreement: ' + family)
                return report
        time.sleep(.25)
    raise RuntimeError('No fresh completed GPU report: ' + family)

try:
    summary['source_head'] = command(['git', 'rev-parse', 'HEAD']).stdout.strip()
    summary['source_sha256'] = {str(p): hashlib.sha256((root / p).read_bytes()).hexdigest()
        for p in map(Path, ['ports/ios/App.mm', 'ports/ios/InputBridge.h', 'ports/ios/InputBridge.cpp',
                            'ports/ios/Info.plist', 'scripts/check-ios-host', 'tests/test_ios_input.cpp'])}
    if sys.argv[1] == '--input-test':
        command(['xcrun', 'clang', '-x', 'c', '-std=c11', '-Wall', '-Wextra', '-Werror', '-fsyntax-only', 'ports/ios/InputBridge.h'])
        binary = run / 'test_ios_input'
        command(['xcrun', 'clang++', '-std=c++17', '-Wall', '-Wextra', '-Werror', '-pthread',
                 'ports/ios/InputBridge.cpp', 'tests/test_ios_input.cpp', '-o', binary])
        result = command([binary])
        (run / 'input-test.txt').write_text(result.stdout)
        summary['results']['input'] = {'exit_code': 0, 'output': result.stdout.strip()}
        print(result.stdout, end='', flush=True)
    else:
        command(['xcodebuild', '-version'])
        available = json.loads(command(['xcrun', 'simctl', 'list', 'runtimes', '--json']).stdout)
        (run / 'runtimes.json').write_text(json.dumps(available, indent=2))
        if not any(r['identifier'] == runtime and r['isAvailable'] for r in available['runtimes']):
            raise RuntimeError('iOS 26.5 runtime unavailable')
        sdk = command(['xcrun', '--sdk', 'iphonesimulator', '--show-sdk-path']).stdout.strip()
        app = run / 'ACSRescue.app'
        app.mkdir()
        shutil.copyfile(root / 'ports/ios/Info.plist', app / 'Info.plist')
        command(['xcrun', '--sdk', 'iphonesimulator', 'clang++', '-std=c++17', '-fobjc-arc',
                 '-Wall', '-Wextra', '-Werror', '-target', 'arm64-apple-ios26.0-simulator',
                 '-isysroot', sdk, '-framework', 'UIKit', '-framework', 'Metal', '-framework', 'MetalKit',
                 '-framework', 'QuartzCore', '-framework', 'Foundation', '-framework', 'CoreGraphics',
                 'ports/ios/App.mm', 'ports/ios/InputBridge.cpp', '-o', app / 'ACSRescue'], timeout=120)
        command(['codesign', '--force', '--sign', '-', '--timestamp=none', app])
        command(['codesign', '--verify', '--strict', '--verbose=2', app])
        signature = command(['codesign', '-dvv', app]).stdout
        (run / 'signature.txt').write_text(signature)
        summary['app_sha256'] = hashlib.sha256((app / 'ACSRescue').read_bytes()).hexdigest()
        before = inventory()
        (run / 'devices-before.json').write_text(json.dumps(before, indent=2))
        registry = private / 'devices.json'
        devices = json.loads(registry.read_text()) if registry.exists() else {}
        for family, device_type in families.items():
            name = 'ACS IOS-LAUNCH-RESCUE-026 ' + family
            if family not in devices:
                if any(d['name'] == name for group in before['devices'].values() for d in group):
                    raise RuntimeError('Unregistered device has task name; refusing adoption: ' + name)
                udid = command(['xcrun', 'simctl', 'create', name, device_type, runtime]).stdout.strip()
                devices[family] = {'udid': udid, 'name': name, 'runtime': runtime, 'type': device_type}
                registry.write_text(json.dumps(devices, indent=2))
            if owned(family)['state'] != 'Shutdown':
                raise RuntimeError('Task device is in use; refusing to replace active session: ' + family)
        (run / 'devices.json').write_text(json.dumps(devices, indent=2))
        for family in families:
            docs = None
            try:
                d = owned(family)
                # Register cleanup before boot, including partial boot failures.
                booted_here.append(family)
                sim(family, 'boot')
                sim(family, 'bootstatus', '-b', timeout=120)
                sim(family, 'install', app)
                sim(family, 'terminate', bundle, check=False)
                container = Path(sim(family, 'get_app_container', bundle, 'data').stdout.strip())
                # A fresh completion from this launch is required even when reusing app data.
                docs = container / 'Documents'
                docs.mkdir(exist_ok=True)
                for name in ('completed.json', 'failure.json', 'input-events.jsonl', 'input-state.json', 'startup.jsonl'):
                    path = docs / name
                    if path.exists():
                        shutil.copyfile(path, run / (family + '-previous-' + name))
                        path.unlink()
                print('Launching ' + family + ' ' + d['udid'], flush=True)
                launch = sim(family, 'launch', bundle, '--evidence-run', run.name, timeout=15).stdout.strip()
                initial = completion(docs, run.name, family)
                installed = sim(family, 'get_app_container', bundle, 'app').stdout.strip()
                process = command(['ps', '-p', str(initial['pid']), '-o', 'pid=,command=']).stdout.strip()
                if installed + '/ACSRescue' not in process or run.name not in process:
                    raise RuntimeError('Live app PID/path/token mismatch: ' + family)
                (run / (family + '-process.txt')).write_text(process + '\n')
                sim(family, 'io', 'screenshot', run / (family + '.png'))
                # Actual simctl capture of this exact task device; graceful SIGINT finalizes MP4.
                d = owned(family)
                video = run / (family + '.mp4')
                video_args = ['xcrun', 'simctl', 'io', d['udid'], 'recordVideo', '--codec=h264', str(video)]
                log.write('$ ' + ' '.join(video_args) + '\n'); log.flush()
                with (run / (family + '-recording.log')).open('w') as capture_log:
                    recording = subprocess.Popen(video_args, stdout=capture_log, stderr=subprocess.STDOUT,
                                                 start_new_session=True)
                    try:
                        time.sleep(5)
                    finally:
                        recording.send_signal(signal.SIGINT)
                        try:
                            code = recording.wait(timeout=30)
                        except subprocess.TimeoutExpired:
                            os.killpg(recording.pid, signal.SIGKILL); recording.wait(timeout=5)
                            raise RuntimeError('Recording did not finalize: ' + family)
                if code != 0 or not video.exists() or video.stat().st_size < 1024:
                    raise RuntimeError('Invalid video capture: ' + family)
                probe = json.loads(command(['ffprobe', '-v', 'error', '-show_entries',
                         'format=duration:stream=codec_name,width,height', '-of', 'json', video]).stdout)
                if float(probe['format']['duration']) < 2:
                    raise RuntimeError('Recording too short: ' + family)
                command(['ffmpeg', '-v', 'error', '-i', video, '-f', 'null', '-'])
                (run / (family + '-video.json')).write_text(json.dumps(probe, indent=2))
                sim(family, 'io', 'screenshot', run / (family + '-later.png'))
                final = completion(docs, run.name, family)
                if final['completed_gpu_frames'] <= initial['completed_gpu_frames']:
                    raise RuntimeError('GPU completion did not advance: ' + family)
                for name in ('completed.json', 'input-state.json', 'input-events.jsonl'):
                    shutil.copyfile(docs / name, run / (family + '-' + name))
                # A second cold process must reconnect the saved scene session.
                sim(family, 'terminate', bundle)
                cold_token = run.name + '-cold'
                cold_launch = sim(family, 'launch', bundle, '--evidence-run', cold_token, timeout=15).stdout.strip()
                cold = completion(docs, cold_token, family)
                if cold['pid'] == initial['pid'] or cold['input']['active_touches'] or cold['input']['buttons']:
                    raise RuntimeError('Cold relaunch did not start a fresh neutral process: ' + family)
                shutil.copyfile(docs / 'completed.json', run / (family + '-cold-completed.json'))
                sim(family, 'io', 'screenshot', run / (family + '-cold.png'))
                summary['results'][family] = {'exit_code': 0, 'device': d, 'launch': launch,
                    'app_completion': final, 'initial_completed_gpu_frames': initial['completed_gpu_frames'],
                    'cold_launch': cold_launch, 'cold_completion': cold,
                    'screenshot': family + '-later.png', 'video': family + '.mp4', 'video_probe': probe}
                print(f"PASS {family}: runtime={final['runtime']} minimum=26.0 landscape={final['view_size']} "
                      f"GPU_frames={initial['completed_gpu_frames']}->{final['completed_gpu_frames']} "
                      f"cold_pid={cold['pid']} input={cold['input']} video_seconds={probe['format']['duration']}", flush=True)
            except Exception as error:
                summary['results'][family] = {'exit_code': 1, 'failure': str(error)}
                summary['results'][family]['next_action'] = (
                    'Request parent visible launch of ACS Rescue Preflight on ' + devices[family]['udid'] +
                    '; if launch RPC timed out, use one bounded minimal UIKit comparison. No launch retry loop.')
                summary['failure'] = 'One or more simulator families failed; see results'
                (run / (family + '-failure.txt')).write_text(str(error))
                print('FAIL ' + family + ': ' + str(error), file=sys.stderr, flush=True)
            finally:
                # Preserve app-side progress even when the launch RPC never returns.
                if docs is not None:
                    for name in ('startup.jsonl', 'completed.json', 'failure.json',
                                 'input-state.json', 'input-events.jsonl'):
                        if (docs / name).exists():
                            shutil.copyfile(docs / name, run / (family + '-' + name))
        (run / 'devices-after.json').write_text(json.dumps(inventory(), indent=2))
except Exception as error:
    summary['failure'] = str(error)
    (run / 'failure.txt').write_text(str(error))
    print('FAIL: ' + str(error), file=sys.stderr, flush=True)
finally:
    # Restore only devices booted by this invocation; never erase/delete a device.
    for family in reversed(booted_here):
        try:
            if owned(family)['state'] == 'Booted': sim(family, 'shutdown')
        except Exception as error:
            summary['cleanup_failure'] = str(error)
    if sys.argv[1] == '--simulators' and devices and before is not None:
        try:
            after = inventory()
            (run / 'devices-final.json').write_text(json.dumps(after, indent=2))
            task_ids = {entry['udid'] for entry in devices.values()}
            def other_states(value):
                return {d['udid']: d['state'] for group in value['devices'].values() for d in group
                        if d['udid'] not in task_ids}
            summary['unrelated_device_states_preserved'] = other_states(before) == other_states(after)
            if not summary['unrelated_device_states_preserved']:
                summary['cleanup_failure'] = 'Unrelated device state changed during verification'
        except Exception as error:
            summary['cleanup_failure'] = str(error)
    (run / 'summary.json').write_text(json.dumps(summary, indent=2))
    log.close()
sys.exit(1 if 'failure' in summary or 'cleanup_failure' in summary else 0)
PY
