#!/bin/bash
# Source wrapper and measurements stay gitignored.
set -euo pipefail
cd "$(dirname "$0")/.."
mode="${1:---native}"
case "$mode" in --native|--native-profile) ;; *) echo 'usage: scripts/check-apple-memory [--native|--native-profile]' >&2; exit 2;; esac
exec python3 - "$mode" <<'PY'
import datetime
import json
import os
from pathlib import Path
import subprocess
import sys
import uuid

root = Path.cwd()
private = root / '.local/orchestrate/2026-10-18/apple-preflight'
private.mkdir(parents=True, exist_ok=True)
run = private / ('run-' + datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ') + '-' + uuid.uuid4().hex[:6])
run.mkdir()
print('private_evidence=' + str(run), flush=True)
log = (run / 'commands.log').open('w')
summary = {'mode': sys.argv[1], 'results': {}}

def command(args, timeout=60, check=True):
    log.write('$ ' + ' '.join(map(str, args)) + '\n'); log.flush()
    result = subprocess.run(list(map(str, args)), text=True, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, timeout=timeout)
    log.write(result.stdout + '\nexit_code=' + str(result.returncode) + '\n'); log.flush()
    if check and result.returncode:
        raise RuntimeError('command failed: ' + ' '.join(map(str, args)) + '\n' + result.stdout)
    return result

mode = sys.argv[1]
try:
    command(['xcodebuild', '-version'])
    command(['sw_vers'])
    native_failed = False
    profile_mode = mode == '--native-profile'
    fixed_flags = []
    # Profile policy checks compile memory functions from an isolated
    # copy of the actual pinned source after applying our patch.
    if profile_mode:
        source = Path(os.environ.get('APPLE_MEMORY_SOURCE', str(private / 'source'))).resolve()
        pin = command(['git', '-C', source, 'rev-parse', 'HEAD']).stdout.strip()
        if pin != '010ed7a596a621c15d3a8dfa5795ca8c3668b066':
            raise RuntimeError('Refusing wrong upstream source revision')
        patched = run / 'patched'
        for name in ('runtime/src/platform_mac.cpp', 'runtime/include/nx/cpu.h', 'runtime/include/nx/runtime.h'):
            target = patched / name
            target.parent.mkdir(parents=True, exist_ok=True)
            # Read committed blobs, never copy another worktree's uncommitted edits.
            target.write_text(command(['git', '-C', source, 'show', 'HEAD:' + name]).stdout)
        patch = root / 'runtime/patches/apple-memory.patch'
        command(['git', '-C', patched, 'apply', '--check', patch])
        command(['git', '-C', patched, 'apply', patch])
        text = (patched / 'runtime/src/platform_mac.cpp').read_text()
        memory = text[text.index('bool reserve('):text.index('// ---- threads and time')]
        header = run / 'patched_memory.h'
        header.write_text('namespace nx::plat {\n' + memory + '\n}\n')
        fixed_flags = ['-DAPPLE_MEMORY_PATCH_HEADER="' + str(header) + '"']
        summary['runtime_patch'] = {'pin': pin, 'applied': True, 'fixture': 'patched_memory.h'}
        summary['profile'] = 'apple-high-v1'
        summary['allocator_overrides'] = {}
    if mode in ('--native', '--native-profile'):
        binary = run / 'apple_memory'
        command(['xcrun', 'clang++', '-std=c++17', '-Wall', '-Wextra', '-Werror',
                 root / 'probes/apple_memory.cpp', '-o', binary])
        result = command([binary], check=False)
        (run / 'macos.txt').write_text(result.stdout)
        summary['results']['macOS'] = {'exit_code': result.returncode, 'report': 'macos.txt'}
        native_failed = result.returncode != 0 or 'RESULT status=PASS exit_code=0' not in result.stdout
        print(result.stdout, flush=True)
        if profile_mode:
            # Keep the original baseline and its nonzero exit visible. Policy
            # validation is a separate result; it never relabels the baseline.
            baseline_failed = native_failed
            summary['baseline_failed'] = baseline_failed
            binary = run / 'apple_memory_high'
            command(['xcrun', 'clang++', '-std=c++17', '-Wall', '-Wextra', '-Werror',
                     '-DAPPLE_MEMORY_HIGH_PROFILE', *fixed_flags,
                     root / 'probes/apple_memory.cpp', '-o', binary])
            native_failed = False
            summary['results']['macOS-profile'] = []
            for attempt in range(5):
                result = command([binary], check=False)
                report = 'macos-high-' + str(attempt) + '.txt'
                (run / report).write_text(result.stdout)
                summary['results']['macOS-profile'].append({'exit_code': result.returncode, 'report': report})
                native_failed |= result.returncode != 0 or 'RESULT status=PASS exit_code=0' not in result.stdout
                print('apple-high-v1 attempt=' + str(attempt) + '\n' + result.stdout, flush=True)
    if native_failed: raise RuntimeError('Native mapping/process constraints failed')
    (run / 'success.txt').write_text('Selected policy checks passed; consult summary.json for the separate baseline outcome.\n')
except Exception as exc:
    (run / 'failure.txt').write_text(type(exc).__name__ + ': ' + str(exc) + '\n')
    print('FAIL: ' + str(exc) + '\nEvidence: ' + str(run), file=sys.stderr, flush=True)
    sys.exit(1)
finally:
    (run / 'summary.json').write_text(json.dumps(summary, indent=2) + '\n')
    log.close()
PY
