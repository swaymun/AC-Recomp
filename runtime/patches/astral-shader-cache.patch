--- /dev/null
+++ b/runtime/src/nvn/nvn_shader_cache.h
@@ -0,0 +1,112 @@
+// Private cache data only. No game bytes are shipped with this format.
+#pragma once
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+#include "nvn_shaders.h"
+#if defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include "platform.h"
+#endif
+
+namespace nx::nvn::shader_cache {
+constexpr size_t max_payload = 64u << 20;
+inline void u32(std::string& out, uint32_t value) {
+    for (unsigned n = 0; n < 4; ++n) out.push_back(char(value >> (8 * n)));
+}
+inline bool take_u32(const std::string& in, size_t& pos, uint32_t& value) {
+    if (pos > in.size() || in.size() - pos < 4) return false;
+    value = 0;
+    for (unsigned n = 0; n < 4; ++n) value |= uint32_t(uint8_t(in[pos++])) << (8 * n);
+    return true;
+}
+inline std::string encode(const std::string& key, const std::string& payload) {
+    if (key.empty() || key.size() > 4096 || payload.size() > max_payload) return {};
+    std::string out = "ACSC0001";
+    u32(out, uint32_t(key.size())); u32(out, uint32_t(payload.size()));
+    // Detect accidental corruption before any opaque bytes reach the driver.
+    std::string checked = key + payload;
+    out += sha1_hex(checked.data(), checked.size());
+    return out + key + payload;
+}
+inline bool decode(const std::string& bytes, const std::string& key, std::string& payload) {
+    payload.clear();
+    if (bytes.size() < 56 || bytes.compare(0, 8, "ACSC0001") != 0) return false;
+    size_t pos = 8; uint32_t k = 0, n = 0;
+    if (!take_u32(bytes, pos, k) || !take_u32(bytes, pos, n) || !k || k > 4096 || n > max_payload ||
+        bytes.size() != 56ull + k + n || bytes.compare(56, k, key) != 0) return false;
+    if (bytes.compare(16, 40, sha1_hex(bytes.data() + 56, size_t(k) + n)) != 0) return false;
+    payload.assign(bytes, 56 + k, n);
+    return true;
+}
+inline bool read(const std::string& path, std::string& bytes, size_t limit = max_payload + 4152) {
+    bytes.clear();
+#if defined(_WIN32)
+    FILE* f = plat::fopen_utf8(path, "rb");
+#else
+    FILE* f = std::fopen(path.c_str(), "rb");
+#endif
+    if (!f) return false;
+    bool ok = std::fseek(f, 0, SEEK_END) == 0;
+    long n = ok ? std::ftell(f) : -1;
+    ok = ok && n >= 0 && uint64_t(n) <= limit && std::fseek(f, 0, SEEK_SET) == 0;
+    if (ok) {
+        bytes.resize(size_t(n));
+        ok = std::fread(bytes.data(), 1, bytes.size(), f) == bytes.size();
+    }
+    std::fclose(f);
+    if (!ok) bytes.clear();
+    return ok;
+}
+inline bool load(const std::string& path, const std::string& key, std::string& payload) {
+    payload.clear();
+    std::string bytes;
+    return read(path, bytes) && decode(bytes, key, payload);
+}
+// A failed write/rename leaves the previous file intact. Callers serialize writers.
+inline bool save(const std::string& path, const std::string& key, const std::string& payload) {
+    std::string bytes = encode(key, payload);
+    if (bytes.empty()) return false;
+    std::string tmp = path + ".tmp";
+#if defined(_WIN32)
+    auto wide = [](const std::string& utf8) {
+        int n = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, utf8.c_str(), -1, nullptr, 0);
+        if (!n) return std::wstring{};
+        std::wstring result(size_t(n), L'\0');
+        if (!MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, utf8.c_str(), -1, result.data(), n)) return std::wstring{};
+        return result;
+    };
+    const auto destination = wide(path), temporary = wide(tmp);
+    if (destination.empty() || temporary.empty()) return false;
+    FILE* f = plat::fopen_utf8(tmp, "wb");
+#else
+    FILE* f = std::fopen(tmp.c_str(), "wb");
+#endif
+    if (!f) return false;
+    bool ok = std::fwrite(bytes.data(), 1, bytes.size(), f) == bytes.size();
+    ok = std::fclose(f) == 0 && ok;
+#if defined(_WIN32)
+    if (ok && MoveFileExW(temporary.c_str(), destination.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) return true;
+    DeleteFileW(temporary.c_str());
+#else
+    if (ok && std::rename(tmp.c_str(), path.c_str()) == 0) return true;
+    std::remove(tmp.c_str());
+#endif
+    return false;
+}
+}  // namespace nx::nvn::shader_cache
+
+#if defined(NX_ASTRAL_STRICT) && (defined(__APPLE__) || defined(_WIN32) || (defined(__linux__) && !defined(__ANDROID__)))
+namespace nx::nvn {
+bool shader_cache_enabled();
+const std::string& shader_cache_key();
+void shader_prewarm();  // boot barrier; compiler thread never accesses guest memory
+void shader_records_save();  // caller holds the GPU lock
+const char* shader_compile_phase();
+}
+#endif
