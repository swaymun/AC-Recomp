diff --git a/runtime/src/nvn/nvn_linux_staging.h b/runtime/src/nvn/nvn_linux_staging.h
new file mode 100644
--- /dev/null
+++ b/runtime/src/nvn/nvn_linux_staging.h
@@ -0,0 +1,40 @@
+// Linux upload staging: free storage is bounded; in-flight storage is never reused.
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <cstddef>
+#include <vector>
+namespace nx::nvn {
+template<class T> class RetiredStaging {
+    struct Entry { uint64_t serial, size, bytes; T allocation; };
+    std::vector<Entry> pending_, free_;
+    uint64_t bytes_ = 0;
+public:
+    static constexpr uint64_t max_bytes = 256ull << 20;
+    static constexpr std::size_t max_buffers = 32;
+    uint64_t reused = 0, released = 0, peak_bytes = 0;
+    bool acquire(uint64_t size, T& allocation) {
+        auto best = free_.end();
+        for (auto it = free_.begin(); it != free_.end(); ++it)
+            if (it->size >= size && it->size - size <= size &&
+                (best == free_.end() || it->size < best->size)) best = it;
+        if (best == free_.end()) return false;
+        bytes_ -= best->bytes; allocation = best->allocation; free_.erase(best); ++reused;
+        return true;
+    }
+    void submit(uint64_t serial, uint64_t size, uint64_t bytes, T allocation) {
+        pending_.push_back({serial, size, bytes, allocation});
+    }
+    template<class Dispose> void retire(uint64_t completed, Dispose dispose) {
+        for (auto it = pending_.begin(); it != pending_.end();) {
+            if (it->serial > completed) { ++it; continue; }
+            if (free_.size() < max_buffers && it->bytes <= max_bytes - bytes_) {
+                bytes_ += it->bytes; free_.push_back(*it); peak_bytes = std::max(peak_bytes, bytes_);
+            } else { dispose(it->allocation); ++released; }
+            it = pending_.erase(it);
+        }
+    }
+    uint64_t retained_bytes() const { return bytes_; }
+    std::size_t pending_count() const { return pending_.size(); }
+};
+} // namespace nx::nvn
