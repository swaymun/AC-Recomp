@@ -0,0 +1,96 @@
+// Linux (ELF) host stack switch for the fiber bridge. No guest instructions or addresses.
+// nx_fiber_swap(from, to): save the caller's callee-saved host state in *from and resume *to.
+// nx_fiber_enter: first-entry trampoline; calls entry(arg) on the fresh host stack and never returns.
+#if defined(__x86_64__)
+// System V AMD64: rbx, rbp, r12-r15, the x87 control word and the MXCSR control bits are callee-saved. They are
+// pushed on the outgoing stack and HostContext holds only the stack pointer (offset 0). hle_fiber.cpp prepares a
+// fresh stack as [fpcw][mxcsr][r15][r14][r13][r12][rbx][rbp][ret=nx_fiber_enter], low to high.
+    .text
+    .p2align 4
+    .globl nx_fiber_swap
+    .type nx_fiber_swap,@function
+nx_fiber_swap:
+    pushq %rbp
+    pushq %rbx
+    pushq %r12
+    pushq %r13
+    pushq %r14
+    pushq %r15
+    subq $0x10, %rsp
+    fnstcw (%rsp)
+    stmxcsr 8(%rsp)
+    movq %rsp, (%rdi)
+    movq (%rsi), %rsp
+    fldcw (%rsp)
+    ldmxcsr 8(%rsp)
+    addq $0x10, %rsp
+    popq %r15
+    popq %r14
+    popq %r13
+    popq %r12
+    popq %rbx
+    popq %rbp
+    ret
+    .size nx_fiber_swap, .-nx_fiber_swap
+
+    .p2align 4
+    .globl nx_fiber_enter
+    .type nx_fiber_enter,@function
+nx_fiber_enter:
+    // Reached by ret with a 16-byte aligned rsp: rbx = argument, r12 = entry.
+    movq %rbx, %rdi
+    callq *%r12
+    ud2
+    .size nx_fiber_enter, .-nx_fiber_enter
+#elif defined(__aarch64__)
+// AAPCS64, the layout of fiber_context_mac.S: x19..x30 at 0, sp at 96, q8..q15 at 112, fpcr/fpsr at 240.
+    .text
+    .p2align 2
+    .globl nx_fiber_swap
+    .type nx_fiber_swap,%function
+nx_fiber_swap:
+    stp x19, x20, [x0, #0]
+    stp x21, x22, [x0, #16]
+    stp x23, x24, [x0, #32]
+    stp x25, x26, [x0, #48]
+    stp x27, x28, [x0, #64]
+    stp x29, x30, [x0, #80]
+    mov x9, sp
+    str x9, [x0, #96]
+    stp q8, q9, [x0, #112]
+    stp q10, q11, [x0, #144]
+    stp q12, q13, [x0, #176]
+    stp q14, q15, [x0, #208]
+    mrs x9, fpcr
+    mrs x10, fpsr
+    stp x9, x10, [x0, #240]
+    ldp x19, x20, [x1, #0]
+    ldp x21, x22, [x1, #16]
+    ldp x23, x24, [x1, #32]
+    ldp x25, x26, [x1, #48]
+    ldp x27, x28, [x1, #64]
+    ldp x29, x30, [x1, #80]
+    ldr x9, [x1, #96]
+    mov sp, x9
+    ldp q8, q9, [x1, #112]
+    ldp q10, q11, [x1, #144]
+    ldp q12, q13, [x1, #176]
+    ldp q14, q15, [x1, #208]
+    ldp x9, x10, [x1, #240]
+    msr fpcr, x9
+    msr fpsr, x10
+    ret
+    .size nx_fiber_swap, .-nx_fiber_swap
+
+    .p2align 2
+    .globl nx_fiber_enter
+    .type nx_fiber_enter,%function
+nx_fiber_enter:
+    mov x0, x19
+    blr x20
+    brk #0
+    .size nx_fiber_enter, .-nx_fiber_enter
+#else
+#error fiber_context_linux.S supports x86-64 and aarch64
+#endif
+    .section .note.GNU-stack,"",%progbits
