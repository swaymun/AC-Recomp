+[[noreturn]] void enter(void*);
+// A fresh host stack whose first swap runs nx_fiber_enter, which calls enter(nullptr).
+void prepare_entry(HostContext& h, uintptr_t top) {
+#if defined(__aarch64__)
+    h.sp=top;
+    h.x[0]=0;h.x[1]=reinterpret_cast<uint64_t>(&enter);
+    h.x[11]=reinterpret_cast<uint64_t>(&nx_fiber_enter);
+#else
+    auto* s=reinterpret_cast<uint64_t*>(top);
+    uint16_t fpcw=0;
