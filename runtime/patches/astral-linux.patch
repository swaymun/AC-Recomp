+    s[-3]=reinterpret_cast<uint64_t>(&nx_fiber_enter); // return slot: rsp is 16-byte aligned after ret
+    s[-4]=0;                                            // rbp
+    s[-5]=0;                                            // rbx: argument
+    s[-6]=reinterpret_cast<uint64_t>(&enter);           // r12: entry
+    s[-7]=s[-8]=s[-9]=0;                                // r13, r14, r15
+    s[-11]=fpcw;
+    s[-10]=__builtin_ia32_stmxcsr();
+    h.sp=reinterpret_cast<uint64_t>(&s[-11]);
+#endif
+}
