# Native macOS overlay order for the pinned SuperMarioWonderRecomp runtime (one patch per line, applied top to bottom
# with `git apply`). This is the one authoritative list: tools/acr_build.py applies it, and
# tests/test_acr_build.py (SeriesTest) checks it against the order the overlay tests compose (NATIVE_ORDER and its successors).
# apple-memory.patch must precede astral-bootstrap.patch. astral-sqshl.patch changes only the recompiler
# (recomp/emit_neon.py); the lift stage applies it on its own to a separate checkout.
apple-memory.patch
astral-bootstrap.patch
astral-control-import.patch
astral-sqshl.patch
astral-notifications.patch
astral-apm.patch
astral-audio.patch
astral-ipc-buffer.patch
astral-applet.patch
astral-hid.patch
astral-controller-support.patch
astral-vi.patch
astral-nvn-init.patch
astral-nvn-texture.patch
astral-nvn-program.patch
astral-fiber.patch
astral-hwopus.patch
astral-prepo.patch
astral-fs-commit.patch
astral-nvn-window-depth.patch
astral-nvn-bc-zero-fill.patch
astral-nvn-cube-storage.patch
astral-shared-font.patch
astral-swkbd.patch
astral-perf-hud.patch
astral-audio-dump.patch
astral-launcher.patch
astral-touch.patch
astral-upscale.patch
astral-save-profiles.patch
astral-controls-ui.patch
astral-fps-variant.patch
astral-texel-coalesce.patch
