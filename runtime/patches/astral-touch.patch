+#if defined(NX_ASTRAL_STRICT)
+// Astral strict: the touch screen from plat::read_touches (docs/ASTRAL_TOUCH.md).
+// nn::hid::TouchScreenState<N> (libnx HidTouchScreenState / HidTouchState; docs/ASTRAL_TOUCH.md):
+//   0x00 s64 sampling number, 0x08 s32 count, 0x0c reserved, 0x10 TouchState[N] of 0x28 bytes:
+//   0x00 s64 delta time (ns), 0x08 u32 attributes (bit 0 start, bit 1 end), 0x0c u32 finger id, 0x10 u32 x,
+//   0x14 u32 y (1280 x 720 screen pixels), 0x18 u32 diameter x, 0x1c u32 diameter y, 0x20 s32 rotation (degrees),
+//   0x24 reserved.
+constexpr size_t kTouchMax = 16, kTouchSize = 0x28, kTouchHeader = 0x10;
+constexpr uint32_t kTouchStart = 1, kTouchEnd = 2;
+constexpr uint32_t kTouchW = 1280, kTouchH = 720;
+struct TouchSlot {
+    bool used = false;
+    uint64_t host = 0;
+    uint64_t since = 0;  // monotonic ns of the contact's first sample
+    uint32_t x = 0, y = 0;  // its last position
+};
+std::mutex touch_lock;
+std::array<TouchSlot, kTouchMax> touch_slots;
+uint64_t touch_sampling = 0;  // the last sampling number written
+int32_t touch_last_count = 0;
+constexpr uint64_t kTouchPeriodNs = 16'666'667;  // HID samples the touch screen at 60 Hz
+// Window fraction -> Switch screen pixels. The picture is fitted into the window keeping 16:9 (nvn_present.cpp), so
+// the bars outside it clamp to the nearest edge.
+void touch_to_screen(float fx, float fy, uint32_t& x, uint32_t& y) {
+    uint32_t w = 0, h = 0;
+    window_size(w, h);
+    float bw = 1, bh = 1;
+    if (w && h) {
+        float aspect = float(w) / float(h), picture = float(kTouchW) / float(kTouchH);
+        if (aspect > picture) bw = picture / aspect;
+        else bh = aspect / picture;
+    }
+    float u = (fx - (1 - bw) / 2) / bw, v = (fy - (1 - bh) / 2) / bh;
+    x = uint32_t(std::clamp(u * float(kTouchW), 0.0f, float(kTouchW - 1)));
+    y = uint32_t(std::clamp(v * float(kTouchH), 0.0f, float(kTouchH - 1)));
+}
+// Writes TouchScreenState<n> at `out` (n <= 16) from the platform's current contacts.
+void fill_touch_state(uint8_t* out, size_t n) {
+    std::memset(out, 0, kTouchHeader + n * kTouchSize);
+    TouchPoint points[kTouchMax];
+    size_t count = std::min(read_touches(points, kTouchMax), n);
+    std::lock_guard lk(touch_lock);
+    uint64_t now = monotonic_ns();
+    std::array<bool, kTouchMax> seen{};
+    int32_t written = 0;
+    for (size_t k = 0; k < count; ++k) {
+        size_t slot = kTouchMax;
+        for (size_t s = 0; s < kTouchMax; ++s)
+            if (touch_slots[s].used && touch_slots[s].host == points[k].id) slot = s;
+        uint32_t attributes = 0;
+        if (slot == kTouchMax) {  // a new contact: the lowest free finger id
+            for (size_t s = 0; s < kTouchMax && slot == kTouchMax; ++s)
+                if (!touch_slots[s].used) slot = s;
+            if (slot == kTouchMax) continue;
+            touch_slots[slot] = TouchSlot{true, points[k].id, now, 0, 0};
+            attributes = kTouchStart;
+        }
+        seen[slot] = true;
+        uint32_t x = 0, y = 0;
+        touch_to_screen(points[k].x, points[k].y, x, y);
+        touch_slots[slot].x = x, touch_slots[slot].y = y;
+        uint8_t* t = out + kTouchHeader + size_t(written) * kTouchSize;
+        int64_t delta = int64_t(now - touch_slots[slot].since);
+        uint32_t finger = uint32_t(slot), diameter = 15;
+        std::memcpy(t + 0x00, &delta, 8);
+        std::memcpy(t + 0x08, &attributes, 4);
+        std::memcpy(t + 0x0c, &finger, 4);
+        std::memcpy(t + 0x10, &x, 4);
+        std::memcpy(t + 0x14, &y, 4);
+        std::memcpy(t + 0x18, &diameter, 4);
+        std::memcpy(t + 0x1c, &diameter, 4);
+        ++written;
+    }
+    // Contacts that went away this sample: reported once more with the end attribute, then their finger id is free.
+    for (size_t s = 0; s < kTouchMax; ++s) {
+        if (!touch_slots[s].used || seen[s]) continue;
+        if (size_t(written) < n) {
+            uint8_t* t = out + kTouchHeader + size_t(written) * kTouchSize;
+            int64_t delta = int64_t(now - touch_slots[s].since);
+            uint32_t attributes = kTouchEnd, finger = uint32_t(s), diameter = 15;
+            std::memcpy(t + 0x00, &delta, 8);
+            std::memcpy(t + 0x08, &attributes, 4);
+            std::memcpy(t + 0x0c, &finger, 4);
+            std::memcpy(t + 0x10, &touch_slots[s].x, 4);
+            std::memcpy(t + 0x14, &touch_slots[s].y, 4);
+            std::memcpy(t + 0x18, &diameter, 4);
+            std::memcpy(t + 0x1c, &diameter, 4);
+            ++written;
+        }
+        touch_slots[s] = TouchSlot{};
+    }
+    // The sampling number follows host time at the 60 Hz sampling rate, not the number of calls: polling twice in one
+    // sample period reads the same number (a new contact still gets its start attribute once).
+    uint64_t next = std::max(now / kTouchPeriodNs + 1, touch_sampling);  // never backwards
+    if (next == touch_sampling && written != touch_last_count) ++next;     // the contacts changed within one period
+    touch_sampling = next, touch_last_count = written;
+    int64_t sampling = int64_t(next);
+    std::memcpy(out, &sampling, 8);
+    std::memcpy(out + 8, &written, 4);
+}
+void GetTouchScreenState(CPU& c) {
+    require_memory(c.x[0], kTouchHeader + kTouchMax * kTouchSize, 2);
+    fill_touch_state(reinterpret_cast<uint8_t*>(c.x[0]), kTouchMax);
+    static std::atomic<bool> logged{false};
+    if (!logged.exchange(true)) log("hid: touch screen polled (TouchScreenState<16> from plat::read_touches)");
+    const int32_t count = ld<int32_t>(c.x[0] + 8);
+    static std::atomic<uint64_t> contacts{0};
+    if (count > 0 && contacts.fetch_add(1) % 300 == 0) log("hid: touch screen: %d contact(s)", count);
+}
