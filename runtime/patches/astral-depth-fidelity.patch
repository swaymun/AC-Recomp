+// Replace GLSL.std.450 UnpackHalf2x16 with explicit IEEE binary16 -> binary32 bits.
+// Subnormals use exact uint->float * 2^-24; signs (including -0), Inf and NaNs survive.
+bool expand_half_unpack(const std::vector<uint32_t>& in, std::vector<uint32_t>& out) {
