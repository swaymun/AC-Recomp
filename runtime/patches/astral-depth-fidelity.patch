+// Astral depth/MRT fidelity. Original implementation informed by Puddz/AstralChain-PC
+// d627f49 (MIT), vulkan/exec.c:3289-3293,3330-3338 and maxwell/translate.c:1758-1766.
+// No game instructions, assets or third-party implementation are embedded here.
+#pragma once
+#include <cstdlib>
+#include "nvn_shaders.h"
+
+namespace nx::nvn {
+inline bool depth_fidelity_option(const char* name, bool default_on = false) {
+#if defined(NX_ASTRAL_STRICT) && defined(_WIN32)
+    const char* e = std::getenv(name);
+    return e ? e[0] == '1' : default_on;
+#else
+    (void)name; (void)default_on;
+    return false;  // preserve Metal and other profiles pending hardware evidence
+#endif
+}
+inline bool exact_equal_enabled() {
+    static const bool on = depth_fidelity_option("NX_EXACT_EQUAL", true);
+    return on;
+}
+// Guest 3 is EQUAL. The old no-write relaxation applies only when exact mode is disabled.
+inline uint32_t fidelity_depth_func(uint32_t func, bool write, bool exact) {
+    return !exact && func == 3 && !write ? 4 : func;
+}
+// Location coverage, rather than channel coverage: an unwritten attachment must retain
+// its previous contents. Arrays span locations; component-qualified outputs share one.
+inline uint32_t fragment_output_locations(const ShaderInfo* fs) {
+    uint32_t mask = 0;
+    if (!fs || fs->stage != ShaderStage::Fragment) return mask;
+    for (const ShaderIo& io : fs->refl.fragment_outputs())
+        for (uint32_t n = 0; n < io.array && io.location < 8 && n < 8 - io.location; ++n)
+            mask |= 1u << (io.location + n);
+    return mask;
+}
+inline uint32_t fragment_color_mask(uint32_t guest, uint32_t outputs, uint32_t target) {
+    return target < 8 && ((outputs >> target) & 1u) ? guest & 0xfu : 0u;
+}
+inline uint32_t effective_fragment_outputs(const ShaderInfo* fs) {
+    static const bool on = depth_fidelity_option("NX_FRAG_OUTPUT_MASK");
+    return on ? fragment_output_locations(fs) : 0xffu;
+}
+bool expand_half_unpack(const std::vector<uint32_t>& in, std::vector<uint32_t>& out);
+}  // namespace nx::nvn
