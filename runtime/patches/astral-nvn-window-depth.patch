diff --git a/runtime/src/nvn/nvn_queue.cpp b/runtime/src/nvn/nvn_queue.cpp
--- a/runtime/src/nvn/nvn_queue.cpp
+++ b/runtime/src/nvn/nvn_queue.cpp
@@ -549,6 +549,9 @@ void QueuePresentTexture(CPU& c) {
 void WindowSetCrop(CPU& c) {
     if (auto* w = get<Window>(c.x[0])) {
         int32_t v[4] = {int32_t(c.x[1]), int32_t(c.x[2]), int32_t(c.x[3]), int32_t(c.x[4])};
+#if defined(NX_ASTRAL_STRICT)
+        std::memcpy(w->guest_crop, v, sizeof v), w->crop_set = true;
+#endif
         uw_crop(v);  // NX_ULTRAWIDE
         if (std::memcmp(v, w->crop, sizeof v) != 0) {
             static int logged = 0;
@@ -558,9 +561,68 @@ void WindowSetCrop(CPU& c) {
     }
 }
 
+#if defined(NX_ASTRAL_STRICT)
+// Astral sets the depth mode once at start-up, before any pipeline exists. Pipelines are not rebuilt for another
+// mode, so a change once one was created (pipeline_depth_mode) is refused rather than half applied.
+std::mutex g_depth_lock;
+int g_depth_mode = 0;  // NVN's default, NEAR_IS_MINUS_W
+bool g_depth_frozen = false, g_depth_changed = false;
+
+// void (NVNdevice*, NVNdepthMode). One device: the mode is global.
+void DeviceSetDepthMode(CPU& c) {
+    const int mode = int32_t(c.x[1]);
+    if (mode != 0 && mode != 1) fatal("strict NVN: nvnDeviceSetDepthMode with an unknown mode %d", mode);
+    // NX_CLIP_Z_PATCH rewrites vertex z from -w..w to 0..w; applied to NEAR_IS_ZERO output it would halve depth.
+    if (mode == 1 && depth_remap()) fatal("strict NVN: NX_CLIP_Z_PATCH=1 conflicts with nvnDeviceSetDepthMode NEAR_IS_ZERO");
+    std::lock_guard<std::mutex> lock(g_depth_lock);
+    if (mode == g_depth_mode) return;
+    if (g_depth_frozen) fatal("strict NVN: nvnDeviceSetDepthMode changed after a pipeline was created");
+    if (g_depth_changed) fatal("strict NVN: nvnDeviceSetDepthMode changed after start-up");
+    g_depth_mode = mode, g_depth_changed = true;
+    log("nvn: device depth mode %d (%s)", mode, mode ? "near is zero" : "near is -w");
+}
+
+void DeviceGetDepthMode(CPU& c) { c.x[0] = uint64_t(device_depth_mode()); }
+
+// void (const NVNwindow*, NVNrectangle* crop): writes {int x, y, width, height}. Astral reads it every frame to size
+// its screen targets and viewports; without it the engine read an unwritten rectangle (zero/garbage viewports).
+// Before nvnWindowSetCrop the crop covers the whole of the window's first texture. It is the game's own rectangle,
+// not the NX_ULTRAWIDE-widened one the presentation uses.
+void WindowGetCrop(CPU& c) {
+    int32_t v[4] = {};
+    auto* w = get<Window>(c.x[0]);
+    if (!w) fatal("strict NVN: nvnWindowGetCrop of an unknown window");
+    if (w->crop_set) {
+        std::memcpy(v, w->guest_crop, sizeof v);
+    } else {
+        auto* t = w->textures.empty() ? nullptr : get<Texture>(w->textures[0]);
+        if (!t) fatal("strict NVN: nvnWindowGetCrop before SetCrop on a window without a known texture");
+        v[2] = int32_t(t->width), v[3] = int32_t(t->height);
+    }
+    if (c.x[1])
+        for (int k = 0; k < 4; k++) st<int32_t>(c.x[1] + 4 * uint64_t(k), v[k]);
+}
+#endif
+
 }  // namespace
 
 NX_HLE("nvnWindowSetCrop", WindowSetCrop);
+#if defined(NX_ASTRAL_STRICT)
+NX_HLE("nvnWindowGetCrop", WindowGetCrop);
+NX_HLE("nvnDeviceSetDepthMode", DeviceSetDepthMode);
+NX_HLE("nvnDeviceGetDepthMode", DeviceGetDepthMode);
+
+int device_depth_mode() {
+    std::lock_guard<std::mutex> lock(g_depth_lock);
+    return g_depth_mode;
+}
+
+int pipeline_depth_mode() {
+    std::lock_guard<std::mutex> lock(g_depth_lock);
+    g_depth_frozen = true;
+    return g_depth_mode;
+}
+#endif
 NX_HLE("nvnSyncInitialize", SyncInitialize);
 NX_HLE("nvnSyncFinalize", SyncFinalize);
 NX_HLE("nvnSyncWait", SyncWait);
