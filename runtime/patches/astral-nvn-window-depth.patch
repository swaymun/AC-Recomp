@@ -374,7 +383,11 @@ VkPipeline graphics_pipeline(const PipelineKey& key, const ProgramLayout& layout
     clip.negativeOneToOne = VK_TRUE;  // NVN depth mode 0 (Wonder): clip-space z in -1..1
