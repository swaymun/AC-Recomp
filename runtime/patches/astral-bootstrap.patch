     if (addr == trace_addr())
         log("arb: thread %x waits on %llx type %u value %d (memory %d) timeout %lld", t_self ? t_self->handle : 0,
             (unsigned long long)addr, type, value, int32_t(load32(addr)), (long long)timeout);
