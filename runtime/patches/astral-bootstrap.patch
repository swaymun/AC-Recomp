     if (addr == trace_addr())
         log("arb: thread %x signals %llx type %u value %d count %d (memory %d)", t_self ? t_self->handle : 0,
             (unsigned long long)addr, type, value, count, int32_t(load32(addr)));
     std::unique_lock lk(g_k);
