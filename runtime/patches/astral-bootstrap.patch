 // HIPC/CMIF service framework.
 #pragma once

 #include <cstring>
 #include <functional>
 #include <map>
 #include <memory>
 #include <string>
 #include <vector>

 #include "kernel.h"

 namespace nx {

 struct Buffer {
     uint64_t addr = 0, size = 0;
 };

 struct Service;

 struct IpcCtx {
     CPU* cpu = nullptr;
     uint32_t cmd = 0;
     uint32_t type = 0;
     const uint8_t* in = nullptr;  // raw arguments (after the SFCI header)
     size_t in_size = 0;
     std::vector<uint32_t> in_copy, in_move;
-    uint64_t pid = 0;
-    std::vector<Buffer> a, b, x, c;  // send, receive, pointer (X), receive list (C)
+private:
+    uint64_t caller_pid_ = 0;
+    uint64_t kernel_pid_ = 0;
+    bool pid_descriptor_ = false;
+    friend uint32_t ipc_request(CPU&, uint32_t, uint64_t, uint64_t, const KernelCaller*);
+public:
+    // Zero without a descriptor; only the kernel bridge can authenticate it.
+    uint64_t pid() const { return caller_pid_; }
+    uint64_t authenticated_pid() const { return kernel_pid_; }
+    bool has_pid_descriptor() const { return pid_descriptor_; }
+    std::vector<Buffer> a, b, x, c, w;  // send, receive, pointer (X), receive list (C)
     std::vector<uint32_t> in_objects;  // domain objects passed in

     std::vector<uint8_t> out;
     std::vector<uint32_t> out_copy, out_move;
     std::vector<std::shared_ptr<Service>> out_objects;

     template <typename T>
     T arg(size_t off) const {
         T v{};
         if (off + sizeof(T) <= in_size) std::memcpy(&v, in + off, sizeof(T));
         return v;
     }
     template <typename T>
     void push(const T& v) {
         size_t o = out.size();
         out.resize(o + sizeof(T));
         std::memcpy(out.data() + o, &v, sizeof(T));
     }
     void push_object(std::shared_ptr<Service> s) { out_objects.push_back(std::move(s)); }
     // Buffer of either kind for "the n-th input/output buffer" (A or X / B or C).
     Buffer in_buf(size_t n) const { return n < a.size() && a[n].addr ? a[n] : (n < x.size() ? x[n] : Buffer{}); }
     Buffer out_buf(size_t n) const { return n < b.size() && b[n].addr ? b[n] : (n < c.size() ? c[n] : Buffer{}); }
