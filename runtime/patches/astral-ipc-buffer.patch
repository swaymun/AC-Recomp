+
+bool IpcCtx::receive_size_table(size_t argument_bytes, size_t count, ReceiveSizeTable& table) const {
+    table = {};
+    const auto& f = framing_;
+    // These limits also bound all following additions and multiplications.
+    if (!f.raw_data || type >= 16 || count > c.size() || count > 13 ||
+        f.raw_size > 4092 || argument_bytes > f.raw_size ||
+        f.domain_object_count > 255) return false;
+    if (f.domain && (f.domain_data_size < 16 || argument_bytes != f.domain_data_size - 16)) return false;
+    const size_t objects = f.domain_object_count * 4;
+    const size_t cmif_header = f.domain ? 32 : 16;
+    // CMIF reserves 16 bytes for alignment, independently of the actual pad.
+    const size_t relative = (16 + cmif_header + argument_bytes + objects + 1) & ~size_t(1);
+    const size_t bytes = count * 2;
+    if (relative > f.raw_size || bytes > f.raw_size - relative) return false;
+    if (((relative + bytes + 3) & ~size_t(3)) != f.raw_size) return false;
+    // The table must follow arguments AND domain object IDs, not overlap them.
+    if (f.aligned_offset < f.raw_offset ||
+        f.aligned_offset - f.raw_offset + cmif_header + argument_bytes + objects > relative) return false;
+    table.offset = f.raw_offset + relative;
+    for (size_t i = 0; i < count; ++i) {
+        uint16_t value;
+        std::memcpy(&value, f.raw_data + relative + i * 2, sizeof value);
+        table.values.push_back(value);
+    }
+    return true;
 }

