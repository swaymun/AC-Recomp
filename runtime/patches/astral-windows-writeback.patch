+inline bool narrow_writeback_on() {
+    static const bool on = [] { const char* e=std::getenv("NX_NARROW_WRITEBACK"); return e && std::atoi(e)>0; }();
+    return on;
+}
+inline bool resident_flights_on() {
+    // This mode keeps eager CPU visibility for EVERY compute write-back. No raw guest read is trapped.
+    static const bool on = [] {
+        const char* e=std::getenv("NX_FRAMES_IN_FLIGHT"), *r=std::getenv("NX_RESIDENT");
+        return e && std::atoi(e)>0 && r && std::atoi(r)>0;
+    }();
+    return on;
+}
+constexpr uint64_t kWritebackBlock = 4096;
+template<class Merge> void changed_blocks(uint64_t size, const uint32_t* flags, Merge merge) {
+    if (!flags) { merge(0,size); return; }
+    for (uint64_t at=0; at<size; at+=kWritebackBlock) {
+        const uint64_t bytes=(std::min)(kWritebackBlock,size-at);
+        // The GPU compares complete words only. Always scan a partial final word on the CPU.
+        if (flags[at/kWritebackBlock] || (bytes%4)) merge(at,bytes);
+    }
+}
+// New flags must never make the current submit wrap over its own live upload data.
+// Older slots may be retired normally by upload_alloc; current-slot exhaustion stays eager.
+inline bool writeback_flags_fit(uint64_t head,uint64_t begin,uint64_t capacity,uint64_t bytes,
+                                uint64_t align,bool wrap) {
+    if (!capacity || !align || (align&(align-1)) || bytes>capacity || head<begin ||
+        head>(std::numeric_limits<uint64_t>::max)()-(align-1)) return false;
+    uint64_t at=(head+align-1)&~(align-1);
+    if (wrap && at%capacity>capacity-bytes) {
+        const uint64_t pad=capacity-at%capacity;
+        if (at>(std::numeric_limits<uint64_t>::max)()-pad) return false;
+        at+=pad;
+    }
+    return at>=begin && at-begin<=capacity-bytes;
+}
+struct FlightPolicy {
+    static constexpr uint32_t limit=2;
+    static bool eager(bool writebacks, bool cpu_observer) { return writebacks || cpu_observer; }
+    static bool later_storage_may_write(uint64_t mask,uint32_t binding) { return binding>=64 || mask!=0; }
+    static bool early(bool first,bool last,bool observer,bool same,uint64_t before,uint64_t after) {
+        return first && last && !observer && same && before==after;
+    }
+    template<class Writes> static bool same_ranges(const Writes& a,const Writes& b) {
+        if (a.size()!=b.size()) return false;
+        for (size_t i=0;i<a.size();++i)
+            if (a[i].from!=b[i].from || a[i].to!=b[i].to || a[i].size!=b[i].size || a[i].before!=b[i].before) return false;
+        return true;
+    }
+    static bool throttle(uint32_t in_flight) { return in_flight>limit; }
+    template<class Merge,class Publish> static void retire(uint64_t serial,Merge merge,Publish publish) {
+        merge(); publish(serial);  // NVN completion never precedes required guest-memory materialization.
+    }
+};
