+layout(local_size_x=64) in;
+layout(set=0,binding=0,std430) readonly buffer Current { uint now[]; };
+layout(set=0,binding=1,std430) readonly buffer Snapshot { uint before[]; };
+layout(set=0,binding=2,std430) writeonly buffer Changes { uint flags[]; };
+layout(push_constant) uniform Params { uint words; } pc;
+shared uint changed;
+void main() {
+    uint lane=gl_LocalInvocationID.x, page=gl_WorkGroupID.x;
+    if (lane==0) changed=0;
+    barrier();
+    for (uint k=page*1024+lane; k<min((page+1)*1024,pc.words); k+=64) {
+        if (now[k]!=before[k]) { atomicOr(changed,1); break; }
+    }
+    barrier();
+    if (lane==0) flags[page]=changed;
