+        m.running_fps = running_fps(self);
         m.profiles = saves::list(plat::data_root());
         // NX_SAVE_PROFILE decides only when it is a usable name; otherwise the picker shows, with a warning, and
         // the choice replaces it.
@@ -1289,6 +1398,14 @@ bool start() {
         if (!m.profile_env) setenv("NX_SAVE_PROFILE", s.save_profile.c_str(), 1);  // the picker's choice
     }
     input::export_env(s);
+    // The frame rate is the binary (docs/ASTRAL_60FPS.md): the .app wrapper starts the one settings.ini names, so
+    // this only acts when the player changed it in the launcher. NX_FPS (exported above) overrides settings.ini.
+    if (shown) {
+        const char* fps = std::getenv("NX_FPS");
+        bool want60 = fps && std::string(fps) == "60";
+        std::string self = self_exe(), want = fps_variant(self, want60);
+        if (!want.empty() && want != self) reexec(want, want60 ? "60 fps" : "30 fps");
