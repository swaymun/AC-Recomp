+// ---- running another binary of the same build ----
+
+std::string self_exe() {
+    std::error_code ec;
+#if defined(__APPLE__)
+    uint32_t n = 0;
+    _NSGetExecutablePath(nullptr, &n);
+    std::string p(n + 1, '\0');
+    if (_NSGetExecutablePath(p.data(), &n) != 0) return "";
+    p.resize(std::strlen(p.c_str()));
+    std::filesystem::path c = std::filesystem::canonical(p, ec);
+    return ec ? p : c.string();
+#else
+    std::filesystem::path c = std::filesystem::read_symlink("/proc/self/exe", ec);
+    return ec ? "" : c.string();
+#endif
+}
+
+std::string fps_variant(const std::string& self, bool want60) {
+    static const std::string kTag = "-60fps";
+    if (self.empty()) return "";
+    std::filesystem::path p(self);
+    std::string name = p.filename().string();
+    bool is60 = name.size() > kTag.size() && name.compare(name.size() - kTag.size(), kTag.size(), kTag) == 0;
+    if (want60 == is60) return self;
+    std::string base = is60 ? name.substr(0, name.size() - kTag.size()) : name;
+    std::string other = (p.parent_path() / (want60 ? base + kTag : base)).string();
+    return access(other.c_str(), X_OK) == 0 ? other : "";
+}
+
+int running_fps(const std::string& self) {
+#if defined(NX_SINGLE_FPS)
+    (void)self;
+    return NX_SINGLE_FPS;
+#else
+    static const std::string kTag = "-60fps";
+    std::string name = std::filesystem::path(self).filename().string();
+    return name.size() > kTag.size() && name.compare(name.size() - kTag.size(), kTag.size(), kTag) == 0 ? 60 : 30;
+#endif
+}
+
+static std::vector<std::string> own_args() {
+    std::vector<std::string> out;
+#if defined(__APPLE__)
+    char** argv = *_NSGetArgv();
+    for (int i = 0, n = *_NSGetArgc(); i < n; i++) out.push_back(argv[i] ? argv[i] : "");
+#else
+    std::string text;
+    if (FILE* f = std::fopen("/proc/self/cmdline", "rb")) {
+        char buf[4096];
+        size_t got;
+        while ((got = std::fread(buf, 1, sizeof buf, f)) > 0) text.append(buf, got);
+        std::fclose(f);
+    }
+    for (size_t at = 0; at < text.size();) {
+        size_t end = text.find('\0', at);
+        if (end == std::string::npos) end = text.size();
+        out.push_back(text.substr(at, end - at));
+        at = end + 1;
+    }
+#endif
+    return out;
+}
+
+bool reexec(const std::string& exe, const char* why) {
+    setenv("NX_SKIP_LAUNCHER", "1", 1);  // the player already chose: the new image goes straight to the game
+    setenv("NX_REEXEC", "1", 1);         // the same session: loader.cpp appends to nx.log instead of rotating it
+    std::vector<std::string> args = own_args();
+    if (args.empty()) args.push_back(exe);
+    args[0] = exe;
+    std::vector<char*> argv;
+    for (std::string& a : args) argv.push_back(a.data());
+    argv.push_back(nullptr);
+    nx::log("launcher: running %s (%s)", exe.c_str(), why);
+    std::fflush(nullptr);
+#if defined(__APPLE__)
+    // Apple's Metal HUD (platform_mac.cpp): a HUD this process turned on from the settings is decided afresh by the
+    // new image from the exported settings; one the player set (MTL_HUD_ENABLED) stays.
+    if (const char* a = std::getenv("NX_METAL_HUD_AUTO"); a && *a == '1') unsetenv("MTL_HUD_ENABLED");
+#endif
+    SDL_InitFlags was = SDL_WasInit(0);
+    SDL_Quit();
+    execv(exe.c_str(), argv.data());
+    int err = errno;
+    SDL_Init(was);
+    nx::log("launcher: could not run %s (%s); staying in this binary", exe.c_str(), std::strerror(err));
+    return false;
+}
