@@ -270,3 +270,60 @@ endif()
 if(NX_HWOPUS)
     target_link_libraries(${NX_GAME} PRIVATE "$<LINK_ONLY:PkgConfig::NX_OPUS>")
 endif()
+
+# Astral, SDL3 desktop hosts: a second executable, ${NX_GAME}-${NX_MAIN_VARIANT_NAME}, from another lift of main (the
+# 60 fps build, docs/ASTRAL_60FPS.md). tools/acr_build.py writes NX_MAIN_VARIANT_LIST: "dir <variant gen dir>", then
+# "compile <file>" for each generated main file that differs from NX_GEN_DIR/main (or is new) and "exclude <file>" for
+# each base file it replaces or drops. The executable links the base executable's own objects, game_sdk and the base
+# game_main objects except the excluded ones, so only the changed files compile twice.
+set(NX_MAIN_VARIANT_LIST "" CACHE FILEPATH "Variant main file list (tools/acr_build.py)")
+set(NX_MAIN_VARIANT_NAME "60fps" CACHE STRING "Suffix of the variant executable")
+# A one-rate build (acr_build --fps 30|60): the launcher shows that rate on its Frame rate row.
+set(NX_SINGLE_FPS "" CACHE STRING "Frame rate of a one-rate build (30 or 60), empty with both")
+if(NX_GAME STREQUAL "astral" AND NX_SINGLE_FPS MATCHES "^(30|60)$" AND NOT ANDROID AND NOT IOS AND NOT WIN32)
+    set_property(SOURCE runtime/src/launcher.cpp APPEND PROPERTY COMPILE_DEFINITIONS NX_SINGLE_FPS=${NX_SINGLE_FPS})
+endif()
+if(NX_GAME STREQUAL "astral" AND NX_MAIN_VARIANT_LIST AND NOT ANDROID AND NOT IOS AND NOT WIN32)
+    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${NX_MAIN_VARIANT_LIST}")
+    file(STRINGS "${NX_MAIN_VARIANT_LIST}" nx_variant_lines)
+    set(nx_variant_dir "")
+    set(nx_variant_src "")
+    set(nx_variant_drop "")
+    foreach(line IN LISTS nx_variant_lines)
+        if(line MATCHES "^dir (.+)$")
+            set(nx_variant_dir "${CMAKE_MATCH_1}")
+        elseif(line MATCHES "^compile ([A-Za-z0-9_.-]+)$")
+            list(APPEND nx_variant_src "${nx_variant_dir}/${CMAKE_MATCH_1}")
+        elseif(line MATCHES "^exclude ([A-Za-z0-9_.-]+)$")
+            string(REPLACE "." "\\." nx_name "${CMAKE_MATCH_1}")
+            list(APPEND nx_variant_drop "${nx_name}")
+        endif()
+    endforeach()
+    if(NOT IS_DIRECTORY "${nx_variant_dir}")
+        message(FATAL_ERROR "NX_MAIN_VARIANT_LIST: no variant directory (${nx_variant_dir})")
+    endif()
+    set(nx_variant ${NX_GAME}-${NX_MAIN_VARIANT_NAME})
+    set(nx_main_objects "$<TARGET_OBJECTS:game_main>")
+    if(nx_variant_drop)
+        list(JOIN nx_variant_drop "|" nx_drop)
+        set(nx_main_objects "$<FILTER:${nx_main_objects},EXCLUDE,/(${nx_drop})\\.o$>")
+    endif()
+    set(nx_delta "")
+    if(nx_variant_src)
+        add_library(game_main_${NX_MAIN_VARIANT_NAME} OBJECT ${nx_variant_src})
+        target_include_directories(game_main_${NX_MAIN_VARIANT_NAME} PRIVATE runtime/include "${nx_variant_dir}")
+        get_target_property(nx_opts game_main COMPILE_OPTIONS)
+        if(nx_opts)
+            target_compile_options(game_main_${NX_MAIN_VARIANT_NAME} PRIVATE ${nx_opts})
+        endif()
+        set(nx_delta "$<TARGET_OBJECTS:game_main_${NX_MAIN_VARIANT_NAME}>")
+    endif()
+    add_executable(${nx_variant} "$<TARGET_OBJECTS:${NX_GAME}>" "${nx_main_objects}" ${nx_delta})
+    get_target_property(nx_libs ${NX_GAME} LINK_LIBRARIES)
+    list(REMOVE_ITEM nx_libs game_main)
+    target_link_libraries(${nx_variant} PRIVATE ${nx_libs})
+    get_target_property(nx_link_opts ${NX_GAME} LINK_OPTIONS)
+    if(nx_link_opts)
+        target_link_options(${nx_variant} PRIVATE ${nx_link_opts})
+    endif()
+endif()
