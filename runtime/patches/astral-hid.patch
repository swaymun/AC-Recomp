+void clear_history() { for (auto& h : histories) for (auto& s : h) s.clear(); }
+void require_init() { if (!initialized) fatal("hid: Npad not initialized"); }
+bool connected(uint32_t id) { return initialized && id == 0 && ids[0] && (styles & 1) && !disconnected; }
+void InitializeNpad(CPU&) {
+    std::lock_guard lk(hid_lock);
+    if (initialized) return;
+    initialized = true; // Configuration remains explicit; no styles/ids enabled by initialization.
+}
+void SetStyles(CPU& c) {
+    std::lock_guard lk(hid_lock); require_init();
+    if (uint32_t(c.x[0]) & ~31u) fatal("hid: unsupported Npad style bits");
+    styles = uint32_t(c.x[0]); clear_history();
+}
+void SetIds(CPU& c) {
+    std::lock_guard lk(hid_lock); require_init();
+    uint64_t n = c.x[1];
+    if (n > 10) fatal("hid: invalid Npad id count");
+    if (n) require_memory(c.x[0], n*4,1);
+    std::array<bool,33> next{};
+    for (uint64_t i=0; i<n; ++i) {
+        auto id=id_at(c.x[0]+i*4);
+        if (next[id]) fatal("hid: duplicate Npad id");
+        next[id]=true;
+    }
+    ids=next; clear_history();
+}
+void SetHandheldMode(CPU& c) {
+    std::lock_guard lk(hid_lock); require_init();
+    if (uint32_t(c.x[0]) > 2) fatal("hid: invalid handheld activation mode");
+    handheld_mode=uint32_t(c.x[0]); clear_history(); // No handheld endpoint is advertised.
+}
+void SetHoldType(CPU& c) {
+    std::lock_guard lk(hid_lock); require_init();
+    if (uint32_t(c.x[0]) > 1) fatal("hid: invalid Joy hold type");
+    hold_type=uint32_t(c.x[0]);
+}
+void GetNpadStyleSet(CPU& c) {
+    std::lock_guard lk(hid_lock); auto id=id_at(c.x[0]); require_init();
+    c.x[0]=connected(id) ? kStyleFullKey : 0;
+}
+unsigned current_style() {
+    std::string n=hle_current_name();
+    if (n.find("FullKey")!=std::string::npos) return 0;
+    if (n.find("Handheld")!=std::string::npos) return 1;
+    if (n.find("JoyDual")!=std::string::npos) return 2;
+    if (n.find("JoyLeft")!=std::string::npos) return 3;
+    return 4;
+}
+Sample sample(uint32_t id, unsigned style) {
+    Sample s{};
+    auto number=++sampling; std::memcpy(s.data(),&number,8);
+    if (style || !connected(id)) return s;
+    PadState p{}; read_pad(p);
+    p.lx=std::clamp(p.lx,-kStickMax,kStickMax); p.ly=std::clamp(p.ly,-kStickMax,kStickMax);
+    p.rx=std::clamp(p.rx,-kStickMax,kStickMax); p.ry=std::clamp(p.ry,-kStickMax,kStickMax);
+    constexpr int t=kStickMax/2;
+    if(p.lx < -t) p.buttons|=kStickLLeft; if(p.lx > t) p.buttons|=kStickLRight;
+    if(p.ly < -t) p.buttons|=kStickLDown; if(p.ly > t) p.buttons|=kStickLUp;
+    if(p.rx < -t) p.buttons|=kStickRLeft; if(p.rx > t) p.buttons|=kStickRRight;
+    if(p.ry < -t) p.buttons|=kStickRDown; if(p.ry > t) p.buttons|=kStickRUp;
+    std::memcpy(s.data()+8,&p.buttons,8);
+    std::memcpy(s.data()+16,&p.lx,4); std::memcpy(s.data()+20,&p.ly,4);
+    std::memcpy(s.data()+24,&p.rx,4); std::memcpy(s.data()+28,&p.ry,4);
+    uint32_t attr=1; std::memcpy(s.data()+32,&attr,4);
+    return s;
