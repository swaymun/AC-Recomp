+        if (a < lo || a >= hi || (a & 4095) || !g_pages->invalidate(a,4096)) {
+            g_pages = nullptr; return false;
+        }
+    }
+    dirty += count; epoch = g_pages->epoch; pages = g_pages->capture(addr,size); return true;
+}
+void write_watch_invalidate(uint64_t p, uint64_t size) {
+    std::lock_guard lock(g_watch_lock);
+    if (g_pages && g_pages->contains(p,size) && !g_pages->invalidate(p,size)) g_pages = nullptr;
+}

