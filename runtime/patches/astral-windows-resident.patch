+bool write_watch_pages(const uint8_t* p, uint64_t size, std::vector<uint64_t>& pages, uint64_t& epoch,
+                       uint64_t& dirty) {
+    std::lock_guard lock(g_watch_lock);
+    const uint64_t addr = reinterpret_cast<uint64_t>(p);
+    if (!g_pages || !g_pages->contains(addr, size)) return false;
+    const uint64_t lo = addr & ~4095ull, hi = (addr + size + 4095) & ~4095ull;
+    // Capacity covers EVERY page, so even an all-dirty range cannot overflow it. Combined query+reset
+    // preserves CPU writes racing the harvest; separate GetWriteWatch and ResetWriteWatch would lose them.
+    std::vector<void*> written((hi-lo)/4096);
+    ULONG_PTR count = written.size(); ULONG granularity = 0;
+    const UINT result = GetWriteWatch(WRITE_WATCH_FLAG_RESET, reinterpret_cast<void*>(lo), hi-lo,
+                                     written.data(), &count, &granularity);
+    if (result || granularity != 4096 || count > written.size()) {
+        // Never retain a clean stamp after an incomplete harvest.
+        if (!g_pages->invalidate(lo, hi-lo)) g_pages = nullptr;
+        return false;
+    }
+    for (ULONG_PTR i = 0; i < count; ++i) {
