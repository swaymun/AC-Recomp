new file mode 100644
index 0000000..6c34eff
--- /dev/null
+++ b/runtime/src/win_page_generations.h
@@ -0,0 +1,55 @@
+// Original implementation. Independent-consumer generation idea: Puddz/AstralChain-PC (MIT),
+// runtime/nvn_hle.h:241-350. CPU dirty pages never identify GPU-changed words.
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+#include <vector>
+namespace nx::plat {
+struct PageGenerations {
+    static constexpr uint64_t page = 4096;
+    uint64_t base, size, clock = 1, epoch = 1;
+    std::vector<uint64_t> pages;
+    PageGenerations(uint64_t b, uint64_t n) : base(b), size(n), pages(n / page, 1) {}
+    bool contains(uint64_t p, uint64_t n) const {
+        return n && p >= base && n <= size && p - base <= size - n;
+    }
+    uint64_t next() {
+        if (clock == (std::numeric_limits<uint64_t>::max)()) {
+            std::fill(pages.begin(), pages.end(), 1); clock = 1;
+            // Epoch rollover cannot alias a live stamp: disable tracking instead.
+            if (epoch == (std::numeric_limits<uint64_t>::max)()) return 0;
+            ++epoch;
+        }
+        return ++clock;
+    }
+    bool invalidate(uint64_t p, uint64_t n) {
+        if (!contains(p, n)) return false;
+        const uint64_t g = next(); if (!g) return false;
+        const uint64_t lo = (p - base) / page, hi = (p - base + n - 1) / page + 1;
+        std::fill(pages.begin() + lo, pages.begin() + hi, g); return true;
+    }
+    std::vector<uint64_t> capture(uint64_t p, uint64_t n) const {
+        if (!contains(p,n)) return {};
+        const uint64_t lo = (p - base) / page, hi = (p - base + n - 1) / page + 1;
+        return {pages.begin() + lo, pages.begin() + hi};
+    }
+};
+// Consumer generations are published only after these bytes have been copied. Capturing BEFORE
+// copying means a CPU write during the copy stays dirty for the next harvest/consumer.
+struct PageConsumer {
+    uint64_t epoch = 0;
+    std::vector<uint64_t> seen;
+    template<class Copy> uint64_t refresh(uint64_t address, uint64_t size, uint64_t current_epoch,
+                                         const std::vector<uint64_t>& current, Copy copy) {
+        uint64_t bytes = 0;
+        const uint64_t first = address & ~4095ull;
+        for (size_t i = 0; i < current.size(); ++i) {
+            if (epoch == current_epoch && seen.size() == current.size() && seen[i] == current[i]) continue;
+            uint64_t lo = (std::max)(address, first + i * 4096), hi = (std::min)(address + size, first + (i+1)*4096);
+            copy(lo - address, hi - lo); bytes += hi - lo;
+        }
+        seen = current; epoch = current_epoch; return bytes;
+    }
+};
+}  // namespace nx::plat
