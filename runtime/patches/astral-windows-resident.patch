new file mode 100644
--- /dev/null
+++ b/runtime/src/nvn/nvn_resident.h
@@ -0,0 +1,149 @@
+// Bounded synchronous resident bindings. Original implementation; persistent dirty-page binding ideas
+// from Puddz/AstralChain-PC (MIT), nvn_hle.h:241-350 and las/nvn/vulkan/exec.c:2619-2861.
+// No Puddz code or whole-range GPU->CPU memcpy is used. Eager changed-word merge remains authoritative.
+#pragma once
+#include <map>
+#include <tuple>
+#include "nvn_vk.h"
+#include "platform.h"
+#include "win_page_generations.h"
+#include "win_write_watch.h"
+namespace nx::nvn::replay {
+using namespace nx::vk;
+struct ResidentCounters {
+    uint64_t copied = 0, snapshot = 0, dirty = 0, hits = 0, misses = 0, bypass = 0;
+    uint64_t wb_scanned = 0, wb_changed = 0, query_ns = 0, fence_ns = 0;
+};
+inline ResidentCounters g_resident_stats;
+inline ResidentCounters& resident_stats() { return g_resident_stats; }
+#if defined(_WIN32) && defined(NX_ASTRAL_STRICT)
+// Installed at device initialization only when NX_MEM_TRACE=1. Keeping optional observers
+// here lets the cache remain self-contained for its portable Vulkan-call fixtures.
+struct ResidentMemoryTrace {
+    inline static uint32_t (*begin)() = nullptr;
+    inline static void (*end)(uint32_t) = nullptr;
+    inline static std::shared_ptr<std::vector<uint8_t>> (*snapshot)(uint64_t) = nullptr;
+    uint32_t previous = begin ? begin() : 0;
+    ~ResidentMemoryTrace() { if (end) end(previous); }
+};
+#endif
+struct ResidentEntry {
+    Upload up;
+    plat::PageConsumer consumer;
+    std::shared_ptr<std::vector<uint8_t>> before;
+    uint64_t used = 0;
+};
+inline std::map<std::tuple<uint64_t,uint64_t,uint64_t,bool>, ResidentEntry> g_resident;
+inline VkBuffer g_resident_buffer = VK_NULL_HANDLE;
+inline VkDeviceMemory g_resident_memory = VK_NULL_HANDLE;
+inline uint8_t* g_resident_ptr = nullptr;
+inline uint64_t g_resident_capacity = 256ull << 20, g_resident_head = 0, g_resident_submit = 0;
+inline bool g_resident_full = false, g_resident_failed = false;
+inline bool g_resident_graphics_writer = false;
+inline void resident_note_graphics_writes() {
+    // Baseline only merges compute storage. A graphics SSBO may therefore mutate a read
+    // allocation without touching guest pages. Preserve within-submit aliases, but never
+    // reuse read allocations across submits after seeing such a shader (including an
+    // untraceable pointer, whose conservative written mask is all ones). No arena is freed
+    // here: recorded descriptors may still reference it; compute snapshots remain valid.
+    if (!g_resident_graphics_writer) log("resident: graphics storage writer; read persistence disabled");
+    g_resident_graphics_writer = true;
+}
+inline bool resident_on() {
+    const char* r = std::getenv("NX_RESIDENT");
+    // No cache refresh while any earlier GPU submission can use these allocations.
+    return r && std::atoi(r) != 0 && !async_gpu() && !g_resident_failed;
+}
+inline bool resident_init() {
+    if (g_resident_ptr) return true;
+#if defined(_WIN32) && defined(NX_ASTRAL_STRICT)
+    ResidentMemoryTrace memory_scope;
+#endif
+    VkBufferCreateInfo bi{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO}; bi.size = g_resident_capacity; bi.usage = kUploadUsage;
+    VkDevice d = vk_device();
+    if (p_vkCreateBuffer(d,&bi,nullptr,&g_resident_buffer) != VK_SUCCESS) return false;
+    VkMemoryRequirements req{}; p_vkGetBufferMemoryRequirements(d,g_resident_buffer,&req);
+    VkMemoryAllocateInfo ai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO}; ai.allocationSize = req.size;
+    ai.memoryTypeIndex = upload_memory_type(req.memoryTypeBits);
+    void* mapped = nullptr;
+    if (p_vkAllocateMemory(d,&ai,nullptr,&g_resident_memory) == VK_SUCCESS &&
+        p_vkBindBufferMemory(d,g_resident_buffer,g_resident_memory,0) == VK_SUCCESS &&
+        p_vkMapMemory(d,g_resident_memory,0,VK_WHOLE_SIZE,0,&mapped) == VK_SUCCESS) {
+        g_resident_ptr = static_cast<uint8_t*>(mapped); return true;
+    }
+    p_vkDestroyBuffer(d,g_resident_buffer,nullptr); g_resident_buffer = VK_NULL_HANDLE;
+    if (g_resident_memory) p_vkFreeMemory(d,g_resident_memory,nullptr);
+    g_resident_memory = VK_NULL_HANDLE; return false;
+}
+inline void resident_begin() {
+    if (!resident_on()) return;
+    ++g_resident_submit;
+    // draw_begin_submit follows completion AND eager writeback of the prior synchronous submit.
+    // Never recycle during recording: earlier commands may still reference a replaced entry.
+    if (g_resident_full || g_resident_submit == 0) {
+        g_resident.clear(); g_resident_head = 0; g_resident_full = false; g_resident_submit = 1;
+    }
+}
+inline bool resident_upload(const uint8_t* p, uint64_t size, uint64_t padded, uint64_t align,
+                            bool storage, Upload& out, std::shared_ptr<std::vector<uint8_t>>* before = nullptr) {
+    auto& stats = resident_stats();
+    // Querying a tiny constant block costs more than copying it (WIN-RESIDENT-022 A/B).
+    // Keep large meshes/ranges resident; the original dedup path handles small read-only inputs.
+    static const uint64_t min_read = [] {
+        const char* v = std::getenv("NX_RESIDENT_MIN_READ");
+        return v ? uint64_t(std::strtoull(v,nullptr,10)) : uint64_t(4096);
+    }();
+    const char* part = std::getenv(storage ? "NX_RESIDENT_STORAGE" : "NX_RESIDENT_READ");
+    if ((!storage && (size < min_read || g_resident_graphics_writer)) || (part && std::atoi(part) == 0) || !resident_on() || !p || !size || padded < size || size > (64ull<<20) || align > 256 || !align) {
+        ++stats.bypass; return false;
+    }
+    uint64_t epoch = 0; std::vector<uint64_t> pages;
+    const uint64_t q0 = plat::monotonic_ns();
+    const bool watched = plat::write_watch_pages(p,size,pages,epoch,stats.dirty);
+    stats.query_ns += plat::monotonic_ns()-q0;
+    if (!watched) { ++stats.bypass; return false; }
+    if (!resident_init()) { g_resident_failed = true; ++stats.bypass; return false; }
+    const auto key = std::make_tuple(reinterpret_cast<uint64_t>(p),size,padded,storage);
+    auto it = g_resident.find(key);
+    // Same-submit invalidation/copy-on-write: never mutate memory already referenced by recorded work.
+    // Per-submit dedup / written regions serve repeated reads without reaching this path.
+    if (it != g_resident.end() && it->second.used == g_resident_submit) it = g_resident.end();
+    if (it == g_resident.end()) {
+        const uint64_t at = (g_resident_head+255)&~255ull;
+        if (padded > g_resident_capacity-at) { g_resident_full = true; ++stats.bypass; return false; }
+        ResidentEntry e; e.up = {g_resident_buffer,at,g_resident_ptr+at};
+        if (padded>size) std::memset(e.up.ptr+size,0,padded-size);
+#if defined(_WIN32) && defined(NX_ASTRAL_STRICT)
+        if (storage) e.before = ResidentMemoryTrace::snapshot ? ResidentMemoryTrace::snapshot(size)
+                                                            : std::make_shared<std::vector<uint8_t>>(size);
+#else
+        if (storage) e.before = std::make_shared<std::vector<uint8_t>>(size);
+#endif
+        g_resident_head = at+padded;
+        it = g_resident.insert_or_assign(key,std::move(e)).first; ++stats.misses;
+    } else ++stats.hits;
+    auto& entry = it->second;
+    stats.copied += entry.consumer.refresh(reinterpret_cast<uint64_t>(p),size,epoch,pages,[&](uint64_t off,uint64_t n) {
+        std::memcpy(entry.up.ptr+off,p+off,n);
+        if (storage) { std::memcpy(entry.before->data()+off,entry.up.ptr+off,n); stats.snapshot += n; }
+    });
+    // Storage descriptors expose the padded tail too. A previous dispatch may have written it;
+    // the original path zeroed it on every new binding, so a retained allocation must do so too.
+    if (storage && padded > size) std::memset(entry.up.ptr+size,0,padded-size);
+    entry.used = g_resident_submit; out = entry.up;
+    if (before) *before = entry.before;
+    return true;
+}
+inline void resident_present() {
+    static const bool counters = std::getenv("NX_RESIDENT_LOG") != nullptr;
+    if (!counters) return;
+    const auto& s = resident_stats();
+    log("resident frame ts_ns=%llu copied=%llu snapshot=%llu dirty_pages=%llu hits=%llu misses=%llu bypass=%llu "
+        "wb_scanned=%llu wb_changed=%llu query_ns=%llu arena=%llu fence_ns=%llu",
+        (unsigned long long)plat::monotonic_ns(),(unsigned long long)s.copied,(unsigned long long)s.snapshot,
+        (unsigned long long)s.dirty,(unsigned long long)s.hits,(unsigned long long)s.misses,
+        (unsigned long long)s.bypass,(unsigned long long)s.wb_scanned,(unsigned long long)s.wb_changed,
+        (unsigned long long)s.query_ns,(unsigned long long)g_resident_head,(unsigned long long)s.fence_ns);
+    resident_stats() = {};
+}
+}  // namespace nx::nvn::replay
