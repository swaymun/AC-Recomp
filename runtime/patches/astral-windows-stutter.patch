+        lock.unlock();wake.notify_one();return true;
+    }
+    Counts snapshot() { std::lock_guard lock(mutex);return counts; }
+    void flush() { std::unique_lock lock(mutex);drained.wait(lock,[&] { return !jobs; }); }
+    ~Store() {
+        { std::lock_guard lock(mutex);stopping=true; }
+        wake.notify_one();worker.join();
+    }
+};
+// Published/read only by the serialized GPU owner; worker counters use its mutex.
+inline Store* active_store=nullptr;
+} // namespace nx::astc_cache
