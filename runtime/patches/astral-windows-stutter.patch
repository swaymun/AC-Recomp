+    static constexpr size_t limit=65536;
+    FILE* file=nullptr;
+    explicit Trace(const char* path) {
+        if (!path || !*path) return;
+        file=plat::fopen_utf8(path,"wb");
+        if (!file) return;
+        std::fwrite("ACST0001",1,8,file);
+        pending.reserve(limit);
+        std::thread([this] {
+            std::vector<Event> batch; batch.reserve(limit);
+            for (;;) {
+                std::this_thread::sleep_for(std::chrono::milliseconds(100));
+                uint64_t dropped=0;
+                { std::lock_guard guard(lock); batch.swap(pending); dropped=lost; lost=0; }
+                if (dropped) { Event e{0,0,dropped,0,0}; std::fwrite(&e,sizeof e,1,file); }
+                if (!batch.empty()) std::fwrite(batch.data(),sizeof(Event),batch.size(),file);
+                std::fflush(file); batch.clear();
+            }
+        }).detach();
+    }
+    void append(const Event& e) {
+        std::lock_guard guard(lock);
+        if (pending.size()<limit) pending.push_back(e); else ++lost;
+    }
+};
