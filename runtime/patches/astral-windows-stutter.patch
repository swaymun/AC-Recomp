+// Optional bounded persistence worker. Only owned decoded CPU bytes cross threads.
+#pragma once
+#include "win_astc_cache.h"
+#include <condition_variable>
+#include <deque>
+#include <functional>
+#include <mutex>
+#include <thread>
+namespace nx::astc_cache {
+class Store {
+public:
+    using Write=std::function<bool(const Digest&,const std::vector<uint8_t>&,uint64_t)>;
+    struct Counts { uint64_t queued=0, skipped=0, saved=0, failed=0; };
+    static constexpr uint64_t byte_limit=128ull<<20;
+    static constexpr size_t job_limit=16;
+private:
+    struct Job { Digest key;std::vector<uint8_t> bytes;uint64_t invalid; };
+    std::mutex mutex;
+    std::condition_variable wake, drained;
+    std::deque<Job> queue;
+    uint64_t held=0;
+    size_t jobs=0;
+    Counts counts;
+    const uint64_t capacity;
+    const size_t slots;
+    Write write;
+    bool stopping=false;
+    std::thread worker;
+    void run() {
+        for (;;) {
+            Job job;
+            {
+                std::unique_lock lock(mutex);
+                wake.wait(lock,[&] { return stopping || !queue.empty(); });
+                if(queue.empty())return;
+                job=std::move(queue.front());queue.pop_front();
+            }
+            bool ok=false;
+            try { ok=write(job.key,job.bytes,job.invalid); } catch (...) { /* optional cache failure */ }
+            const auto size=job.bytes.size();
+            // Release the snapshot before returning its capacity to the producer.
+            std::vector<uint8_t>().swap(job.bytes);
+            {
+                std::lock_guard lock(mutex);
+#if defined(_WIN32) && defined(NX_ASTRAL_STRICT)
+                if (memtrace::enabled()) memtrace::ledger().payload_free(memtrace::Pool::DecodedStore, size);
+#endif
+                held-=size;--jobs;
+                if(ok)++counts.saved;else ++counts.failed;
+                if(!jobs)drained.notify_all();
+            }
+        }
+    }
+public:
+    explicit Store(Write callback,uint64_t bytes=byte_limit,size_t limit=job_limit)
+        : capacity((std::min)(bytes,byte_limit)),slots((std::min)(limit,job_limit)),
+          write(std::move(callback)),worker([this] { run(); }) {}
+    Store(const Store&)=delete;
+    Store& operator=(const Store&)=delete;
+    bool submit(const Digest& key,const std::vector<uint8_t>& bytes,uint64_t invalid) {
+        std::unique_lock lock(mutex);
+        // The in-flight job counts toward both limits. Saturation skips persistence,
+        // never waits for disk or changes the already decoded/uploaded texture.
+        if(stopping || bytes.empty() || bytes.size()>Cache::max_payload ||
+           bytes.size()>capacity-held || jobs>=slots) { ++counts.skipped;return false; }
+        try { queue.push_back(Job{key,bytes,invalid}); }
+        catch (...) { ++counts.skipped;return false; }
+#if defined(_WIN32) && defined(NX_ASTRAL_STRICT)
+        if (memtrace::enabled()) memtrace::ledger().payload_add(memtrace::Pool::DecodedStore, bytes.size());
+#endif
