+#else
+struct Span { explicit Span(Kind,uint64_t=0,bool=true) {} };
+inline void mark(Kind,uint64_t=0) {}
+#endif
+inline bool pace_before_present() {
+#if defined(_WIN32) && defined(NX_ASTRAL_STRICT)
+    static const bool on=[] {
