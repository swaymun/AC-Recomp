@@ -0,0 +1,58 @@
+// Bounded console mirror. The primary NX_LOG file remains synchronous.
+#pragma once
+#include <condition_variable>
+#include <cstddef>
+#include <deque>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <utility>
+namespace nx::winlog {
+class Sink {
+    std::mutex lock;
+    std::condition_variable ready, space, drained;
+    std::deque<std::string> queue;
+    const size_t capacity;
+    void (*write)(const char*);
+    bool stopping=false, busy=false;
+    std::thread worker;
+    void run() {
+        for (;;) {
+            std::string line;
+            {
+                std::unique_lock guard(lock);
+                ready.wait(guard,[&] { return stopping || !queue.empty(); });
+                if (queue.empty()) return;
+                line=std::move(queue.front()); queue.pop_front(); busy=true;
+            }
+            space.notify_one();
+            write(line.c_str());
+            {
+                std::lock_guard guard(lock); busy=false;
+                if (queue.empty()) drained.notify_all();
+            }
+        }
+    }
+public:
+    // Production lines are bounded by nx::log's 2048-byte format buffer.
+    explicit Sink(void (*output)(const char*),size_t bound=256)
+        : capacity(bound ? bound : 1),write(output),worker([this] { run(); }) {}
+    Sink(const Sink&)=delete;
+    Sink& operator=(const Sink&)=delete;
+    void submit(std::string line) {
+        std::unique_lock guard(lock);
+        // Backpressure preserves every line and bounds retained input lifetimes.
+        space.wait(guard,[&] { return queue.size()<capacity; });
+        queue.push_back(std::move(line));
+        guard.unlock(); ready.notify_one();
+    }
+    void flush() {
+        std::unique_lock guard(lock);
+        drained.wait(guard,[&] { return queue.empty() && !busy; });
+    }
+    ~Sink() {
+        { std::lock_guard guard(lock); stopping=true; }
+        ready.notify_one(); worker.join(); // drains all queued lines before exit
+    }
+};
+} // namespace nx::winlog
