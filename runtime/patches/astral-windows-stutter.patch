+        if (t) e={plat::monotonic_ns(),0,arg,uint32_t(plat::current_thread_id()),uint32_t(kind)};
+    }
+    ~Span() { if (t) { e.end=plat::monotonic_ns(); t->append(e); } }
+};
+inline void mark(Kind kind,uint64_t arg=0) {
+    if (auto* t=trace()) { auto n=plat::monotonic_ns(); t->append({n,n,arg,uint32_t(plat::current_thread_id()),uint32_t(kind)}); }
