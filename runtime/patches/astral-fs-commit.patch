+// Existing result policy: target-not-found for mounts/handles, path-not-found
+// for host I/O failures. The latter is an approximation, not a verified SDK I/O code.
+bool flush_stream(File& file, bool sync) {
+    bool ok = std::fflush(file.f) == 0;
+    ok = !std::ferror(file.f) && ok;
+    if (ok && sync) {
+#if defined(_WIN32)
+        ok = _commit(_fileno(file.f)) == 0;
+#else
+        int result;
+        do { result = fsync(fileno(file.f)); } while (result != 0 && errno == EINTR);
+        ok = result == 0;
+#endif
+    }
+    if (!ok && file.owner) file.owner->failed = true;
+    return ok;
+}
+
+void Commit(CPU& c) {
+    std::lock_guard lk(g_fs);
+    std::string name = cstr(c.x[0]);
