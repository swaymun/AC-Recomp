diff --git a/runtime/src/nvn/nvn_upscale.h b/runtime/src/nvn/nvn_upscale.h
new file mode 100644
index 0000000..e7c285a
--- /dev/null
+++ b/runtime/src/nvn/nvn_upscale.h
@@ -0,0 +1,51 @@
+// How the game's picture is scaled to the window (docs/ASTRAL_UPSCALE.md): NX_UPSCALE=bilinear|fsr (the
+// launcher's Upscaling setting, settings.ini `upscale`; metalfx is an alias for fsr), NX_UPSCALE_SHARPNESS in stops
+// (FSR 1's RCAS: 0 the most, 2 none, default 0.2). Unset, the upstream NX_FSR / NX_FSR_SHARP switches decide, as
+// before. Astral only.
+#pragma once
+#if defined(NX_ASTRAL_STRICT)
+#include <cctype>
+#include <cstdlib>
+#include <string>
+
+namespace nx::nvn::upscale {
+
+enum class Mode { Unset, Bilinear, Fsr, MetalFx, Unknown };
+
+inline Mode parse(const char* e) {
+    if (!e) return Mode::Unset;
+    std::string v;
+    for (const char* c = e; *c; c++)
+        if (!std::isspace(static_cast<unsigned char>(*c))) v += char(std::tolower(static_cast<unsigned char>(*c)));
+    if (v.empty()) return Mode::Unset;
+    if (v == "bilinear" || v == "linear" || v == "off" || v == "0") return Mode::Bilinear;
+    if (v == "fsr" || v == "fsr1" || v == "1") return Mode::Fsr;
+    if (v == "metalfx") return Mode::MetalFx;
+    return Mode::Unknown;
+}
+
+// Whether the present pass upscales with FSR 1. NX_UPSCALE decides when it names a mode; metalfx (MetalFX is not built
+// in this version) is an alias for fsr; an unknown value keeps the bilinear scaling. Unset: NX_FSR=1 as upstream.
+inline bool fsr_wanted(const char* upscale, const char* fsr) {
+    switch (parse(upscale)) {
+    case Mode::Fsr:
+    case Mode::MetalFx: return true;
+    case Mode::Bilinear:
+    case Mode::Unknown: return false;
+    case Mode::Unset: break;
+    }
+    return fsr && fsr[0] == '1';
+}
+
+// RCAS sharpness in stops, clamped to 0..2: NX_UPSCALE_SHARPNESS, else NX_FSR_SHARP, else 0.2 (FSR 1's default).
+inline float sharpness(const char* upscale_sharpness, const char* fsr_sharp) {
+    const char* e = upscale_sharpness && *upscale_sharpness ? upscale_sharpness : fsr_sharp;
+    if (!e || !*e) return 0.2f;
+    char* end = nullptr;
+    float v = std::strtof(e, &end);
+    if (end == e || !(v == v)) return 0.2f;  // not a number
+    return v < 0.0f ? 0.0f : v > 2.0f ? 2.0f : v;
+}
+
+}  // namespace nx::nvn::upscale
+#endif
