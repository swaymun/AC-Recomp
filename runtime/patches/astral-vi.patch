+// Opaque API handles, not SDK objects. Never map or dereference these tokens.
+// One host window/layer is supported. Retired tokens are never reused.
+std::mutex g_vi_mutex;
+uint64_t g_vi_next = kKernelBase - 0x2000;
+uint64_t g_vi_display = 0, g_vi_layer = 0;
+uint64_t g_vi_references = 0;
+constexpr uint32_t kViOperationFailed = 0x272;  // SDK SetLayerScalingMode native-window failure

-void ok(CPU& c) { c.x[0] = 0; }
+uint64_t new_vi_token() {
+    if (g_vi_next < 0x10000) fatal("vi: opaque token space exhausted");
+    uint64_t token = g_vi_next;
+    g_vi_next -= 16;
+    return token;
+}
+
+void vi_output(uint64_t p) {
+    constexpr uint64_t size = sizeof(uint64_t);
+    if (!p || p > std::numeric_limits<uint64_t>::max() - size)
+        fatal("vi: invalid output extent");
+    const uint64_t end = p + size;
+    while (p < end) {
+        auto v = vm_query(p);
+        if (v.addr > p || p - v.addr >= v.size || !(v.perm & 2))
+            fatal("vi: output is not writable");
+        const uint64_t available = v.size - (p - v.addr);
+        p += std::min(available, end - p);
+    }
+}
+
+void vi_ready() {
+    if (!g_vi_references) fatal("vi: not initialized");
+}
+void vi_display(uint64_t p) {
+    vi_ready();
+    if (!p || p != g_vi_display) fatal("vi: invalid, foreign or stale display");
+}
+void vi_layer(uint64_t p) {
+    vi_ready();
+    if (!g_vi_display || !p || p != g_vi_layer) fatal("vi: invalid, foreign or stale layer");
+}
+
+void Initialize(CPU& c) {
+    std::lock_guard lock(g_vi_mutex);
+    if (g_vi_references == std::numeric_limits<uint64_t>::max())
+        fatal("vi: initialize reference overflow");
+    ++g_vi_references;
+    c.x[0] = 0;
+}

+void Finalize(CPU&) {
+    std::lock_guard lock(g_vi_mutex);
+    // SDK Finalize is a no-op at zero; only the final release retires objects.
+    if (g_vi_references && !--g_vi_references) {
+        g_vi_layer = 0;
+        g_vi_display = 0;
+    }
+}
