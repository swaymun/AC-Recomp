+void SetLayerScalingMode(CPU& c) {  // Result (Layer*, ScalingMode); no output pointer
+    std::lock_guard lock(g_vi_mutex);
+    vi_layer(c.x[0]);
+    const uint32_t mode = uint32_t(c.x[1]);  // enum passed in w1
+    if (mode > 4) fatal("vi: invalid scaling mode %u", mode);
