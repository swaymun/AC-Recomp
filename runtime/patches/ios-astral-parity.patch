diff --git a/runtime/src/nvn/nvn_spirv_subgroup.cpp b/runtime/src/nvn/nvn_spirv_subgroup.cpp
new file mode 100644
index 0000000..05503cc
--- /dev/null
+++ b/runtime/src/nvn/nvn_spirv_subgroup.cpp
@@ -0,0 +1,240 @@
+// Subgroup operations at subgroup size 1, iOS simulator only (docs/ASTRAL_IOS_SIM.md). The translated shaders use Maxwell warp operations
+// (vote/ballot/shuffle) as GroupNonUniform SPIR-V. The iOS simulator GPU has no SIMD-group functions: MoltenVK reports
+// subgroup sizes 1..1 and its emulation compiles nothing but Elect, so such a compute pipeline fails, its dispatches
+// are skipped, and the passes that read its output later timed out the GPU. On a device whose subgroups are one
+// invocation wide every one of these operations has an exact single-lane meaning, so the module is rewritten to it:
+//   Elect, AllEqual -> true; All, Any -> the predicate; Broadcast(First), Shuffle(Xor/Up/Down) -> the value itself;
+//   Ballot -> (predicate ? 1 : 0, 0, 0, 0); SubgroupLocalInvocationId -> 0; SubgroupSize -> 1;
+//   Subgroup{Eq,Ge,Le}Mask -> (1, 0, 0, 0); Subgroup{Lt,Gt}Mask -> 0 (Private variables with those initialisers).
+// A shuffle from another lane has no single-lane meaning; it reads the caller's own value (what a size-1 device
+// returns for its only lane). Modules with other subgroup operations are left as they are (false).
+#if defined(NX_ASTRAL_STRICT) && defined(NX_IOS_RUNTIME)  // iOS simulator only (CMakeLists.txt)
+#include <algorithm>
+#include <map>
+#include <set>
+#include <vector>
+
+#include <cstdint>
+
+namespace nx::nvn {
+
+namespace {
+enum : uint32_t {
+    OpExtension = 10, OpEntryPoint = 15, OpCapability = 17, OpTypeBool = 20, OpTypeInt = 21, OpTypeVector = 23,
+    OpTypePointer = 32, OpConstantTrue = 41, OpConstant = 43, OpConstantComposite = 44, OpConstantNull = 46,
+    OpFunction = 54, OpVariable = 59, OpLoad = 61, OpAccessChain = 65, OpInBoundsAccessChain = 66,
+    OpDecorate = 71, OpCompositeConstruct = 80, OpCopyObject = 83, OpSelect = 169,
+    OpElect = 333, OpAll = 334, OpAny = 335, OpAllEqual = 336, OpBroadcast = 337, OpBroadcastFirst = 338,
+    OpBallot = 339, OpShuffle = 345, OpShuffleXor = 346, OpShuffleUp = 347, OpShuffleDown = 348,
+    DecorationBuiltIn = 11, StorageInput = 1, StoragePrivate = 6,
+    BuiltInSubgroupSize = 36, BuiltInSubgroupLocalInvocationId = 41,
+    BuiltInEqMask = 4416, BuiltInGeMask = 4417, BuiltInGtMask = 4418, BuiltInLeMask = 4419, BuiltInLtMask = 4420,
+    CapGroupNonUniform = 61, CapGroupNonUniformQuad = 68,
+};
+struct Inst {
+    size_t at;
+    uint32_t op, len;
+};
+bool subgroup_builtin(uint32_t b) {
+    return b == BuiltInSubgroupSize || b == BuiltInSubgroupLocalInvocationId || (b >= BuiltInEqMask && b <= BuiltInLtMask);
+}
+}  // namespace
+
+bool scalarize_subgroups(const std::vector<uint32_t>& in, std::vector<uint32_t>& out) {
+    if (in.size() < 5) return false;
+    std::vector<Inst> insts;
+    for (size_t i = 5; i < in.size();) {
+        uint32_t len = in[i] >> 16;
+        if (!len || i + len > in.size()) return false;
+        insts.push_back({i, in[i] & 0xffff, len});
+        i += len;
+    }
+    uint32_t bound = in[3];
+    std::map<uint32_t, size_t> def;                // id -> instruction index (types, constants, variables)
+    std::map<uint32_t, uint32_t> builtin_of;       // variable -> subgroup builtin
+    std::map<std::pair<uint32_t, uint32_t>, uint32_t> pointer;  // (storage, pointee) -> pointer type
+    uint32_t bool_type = 0;
+    bool uses = false;
+    size_t first_function = insts.size();
+    for (size_t k = 0; k < insts.size(); k++) {
+        const Inst& n = insts[k];
+        const uint32_t* w = &in[n.at];
+        if (n.op == OpFunction && first_function == insts.size()) first_function = k;
+        if (n.op == OpTypeBool && n.len == 2) bool_type = w[1];
+        if (n.op == OpTypePointer && n.len == 4) pointer[{w[2], w[3]}] = w[1];
+        if (k < first_function && n.len >= 2 &&
+            (n.op == OpTypeInt || n.op == OpTypeVector || n.op == OpTypePointer || n.op == OpTypeBool))
+            def[w[1]] = k;
+        if (n.op == OpVariable && n.len >= 4) def[w[2]] = k;
+        if (n.op == OpDecorate && n.len == 4 && w[2] == DecorationBuiltIn && subgroup_builtin(w[3])) builtin_of[w[1]] = w[3];
+        if (n.op >= OpElect && n.op <= 366) {  // the GroupNonUniform instructions
+            uses = true;
+            const bool handled = n.op == OpElect || n.op == OpAll || n.op == OpAny || n.op == OpAllEqual ||
+                                 n.op == OpBroadcast || n.op == OpBroadcastFirst || n.op == OpBallot ||
+                                 (n.op >= OpShuffle && n.op <= OpShuffleDown);
+            if (!handled) return false;
+        }
+        if (n.op >= 4421 && n.op <= 4432) return false;  // the older KHR subgroup instructions
+    }
+    if (!uses && builtin_of.empty()) return false;
+    // Scalar component type of a (vector) type, and its width.
+    auto component = [&](uint32_t type) -> uint32_t {
+        auto it = def.find(type);
+        if (it == def.end()) return 0;
+        const uint32_t* w = &in[insts[it->second].at];
+        return insts[it->second].op == OpTypeVector ? w[2] : type;
+    };
+    auto count = [&](uint32_t type) -> uint32_t {
+        auto it = def.find(type);
+        if (it == def.end()) return 0;
+        return insts[it->second].op == OpTypeVector ? in[insts[it->second].at + 3] : 1;
+    };
+    // New global declarations, inserted before the first function.
+    std::vector<uint32_t> globals;
+    std::map<uint32_t, uint32_t> zero, one, unit;  // type -> OpConstantNull / scalar 1 / (1, 0, ...) constants
+    uint32_t true_id = 0;
+    auto get_zero = [&](uint32_t type) {
+        uint32_t& id = zero[type];
+        if (!id) id = bound++, globals.insert(globals.end(), {(3u << 16) | OpConstantNull, type, id});
+        return id;
+    };
+    auto get_one = [&](uint32_t scalar) {
+        uint32_t& id = one[scalar];
+        if (!id) id = bound++, globals.insert(globals.end(), {(4u << 16) | OpConstant, scalar, id, 1u});
+        return id;
+    };
+    auto get_unit = [&](uint32_t type) {  // (1, 0, 0, 0) of a uint vector, or 1 of a scalar
+        uint32_t n = count(type), c = component(type);
+        if (n <= 1) return get_one(type);
+        uint32_t& id = unit[type];
+        if (!id) {
+            uint32_t a = get_one(c), z = get_zero(c);
+            id = bound++;
+            globals.push_back(((3u + n) << 16) | OpConstantComposite);
+            globals.push_back(type), globals.push_back(id), globals.push_back(a);
+            for (uint32_t k = 1; k < n; k++) globals.push_back(z);
+        }
+        return id;
+    };
+    auto get_pointer = [&](uint32_t pointee) {
+        auto key = std::make_pair(uint32_t(StoragePrivate), pointee);
+        uint32_t& id = pointer[key];
+        if (!id) id = bound++, globals.insert(globals.end(), {(4u << 16) | OpTypePointer, id, StoragePrivate, pointee});
+        return id;
+    };
+    // Rewritten builtin variables: their pointee and initialiser.
+    std::map<uint32_t, uint32_t> private_type;  // variable -> new pointer type
+    std::map<uint32_t, uint32_t> init;
+    size_t insert_at = first_function;
+    for (auto [var, b] : builtin_of) {
+        auto it = def.find(var);
+        if (it == def.end()) return false;
+        const uint32_t* w = &in[insts[it->second].at];
+        if (w[3] != StorageInput) return false;
+        auto pt = def.find(w[1]);
+        if (pt == def.end()) return false;
+        uint32_t pointee = in[insts[pt->second].at + 3];
+        if (!component(pointee)) return false;
+        private_type[var] = get_pointer(pointee);
+        bool set = b == BuiltInSubgroupSize || b == BuiltInEqMask || b == BuiltInGeMask || b == BuiltInLeMask;
+        init[var] = set ? get_unit(pointee) : get_zero(pointee);
+    }
+    // Everything else the rewrite needs is declared up front too.
+    std::set<uint32_t> needs;  // existing types the new declarations refer to
+    for (const Inst& n : insts) {
+        const uint32_t* w = &in[n.at];
+        if (n.op == OpBallot) {
+            uint32_t c = component(w[1]);
+            if (!c) return false;
+            get_one(c), get_zero(c), needs.insert(c);
+        } else if ((n.op == OpElect || n.op == OpAllEqual) && !true_id) {
+            if (!bool_type) return false;
+            true_id = bound++;
+            globals.insert(globals.end(), {(3u << 16) | OpConstantTrue, bool_type, true_id});
+            needs.insert(bool_type);
+        } else if ((n.op == OpAccessChain || n.op == OpInBoundsAccessChain) && n.len >= 4 && private_type.count(w[3])) {
+            auto pt = def.find(w[1]);
+            if (pt == def.end()) return false;
+            uint32_t pointee = in[insts[pt->second].at + 3];
+            get_pointer(pointee), needs.insert(pointee);
+        }
+    }
+    for (auto [var, b] : builtin_of) {
+        uint32_t pointee = in[insts[def[in[insts[def[var]].at + 1]]].at + 3];
+        needs.insert(pointee), needs.insert(component(pointee));
+    }
+    for (uint32_t t : needs) {
+        auto it = def.find(t);
+        if (it == def.end() || it->second >= insert_at) return false;
+    }
+    // Function bodies: instructions are rewritten in place; the Ballot needs one extra id per use.
+    out.assign(in.begin(), in.begin() + 5);
+    const bool interface_all = in[1] >= 0x10400;  // SPIR-V 1.4+: every global is in the entry point interface
+    for (size_t k = 0; k < insts.size(); k++) {
+        const Inst& n = insts[k];
+        const uint32_t* w = &in[n.at];
+        if (k == insert_at) {  // new declarations, then the rewritten variables (only functions use them)
+            out.insert(out.end(), globals.begin(), globals.end());
+            for (auto [var, type] : private_type)
+                out.insert(out.end(), {(5u << 16) | OpVariable, type, var, StoragePrivate, init[var]});
+        }
+        if (n.op == OpCapability && w[1] >= CapGroupNonUniform && w[1] <= CapGroupNonUniformQuad) continue;
+        if (n.op == OpDecorate && n.len == 4 && w[2] == DecorationBuiltIn && builtin_of.count(w[1])) continue;
+        if (n.op == OpEntryPoint && !interface_all) {
+            size_t p = 3;  // the name: a nul-terminated string
+            while (p < n.len && (w[p] >> 24) != 0) p++;
+            p++;
+            std::vector<uint32_t> e(w, w + std::min<size_t>(p, n.len));
+            for (; p < n.len; p++)
+                if (!builtin_of.count(w[p])) e.push_back(w[p]);
+            e[0] = (uint32_t(e.size()) << 16) | OpEntryPoint;
+            out.insert(out.end(), e.begin(), e.end());
+            continue;
+        }
+        if (n.op == OpVariable && n.len >= 4 && private_type.count(w[2])) {
+            continue;  // declared again as Private before the first function
+        }
+        if ((n.op == OpAccessChain || n.op == OpInBoundsAccessChain) && n.len >= 4 && private_type.count(w[3])) {
+            auto pt = def.find(w[1]);
+            if (pt == def.end()) return false;
+            std::vector<uint32_t> a(w, w + n.len);
+            a[1] = pointer[{StoragePrivate, in[insts[pt->second].at + 3]}];
+            out.insert(out.end(), a.begin(), a.end());
+            continue;
+        }
+        switch (n.op) {
+        case OpElect:
+        case OpAllEqual:
+            out.insert(out.end(), {(4u << 16) | OpCopyObject, w[1], w[2], true_id});
+            continue;
+        case OpAll:
+        case OpAny:
+        case OpBroadcastFirst:
+        case OpBroadcast:
+        case OpShuffle:
+        case OpShuffleXor:
+        case OpShuffleUp:
+        case OpShuffleDown:  // rt, id, scope, value[, lane/mask/delta]
+            out.insert(out.end(), {(4u << 16) | OpCopyObject, w[1], w[2], w[4]});
+            continue;
+        case OpBallot: {  // rt (uvec4), id, scope, predicate
+            uint32_t c = component(w[1]), n4 = count(w[1]);
+            uint32_t bit = bound++;
+            out.insert(out.end(), {(6u << 16) | OpSelect, c, bit, w[4], one[c], zero[c]});
