+// ---- the Controls screen: panels and a drawn controller (original shapes, SDL_Renderer geometry) ----
+
+void poly(Art* a, float cx, float cy, const std::vector<SDL_FPoint>& pts, Rgba c) {  // a fan around (cx, cy)
+    if (pts.size() < 3) return;
+    SDL_FColor col{c.r / 255.f, c.g / 255.f, c.b / 255.f, c.a / 255.f};
+    std::vector<SDL_Vertex> vs(pts.size() + 1);
+    vs[0] = {{X(a, cx), Y(a, cy)}, col, {0, 0}};
+    for (size_t i = 0; i < pts.size(); i++) vs[i + 1] = {{X(a, pts[i].x), Y(a, pts[i].y)}, col, {0, 0}};
+    std::vector<int> idx;
+    for (size_t i = 0; i < pts.size(); i++) idx.insert(idx.end(), {0, int(i + 1), int((i + 1) % pts.size() + 1)});
+    SDL_RenderGeometry(a->r, nullptr, vs.data(), int(vs.size()), idx.data(), int(idx.size()));
+}
+
+void ellipse(Art* a, float cx, float cy, float rx, float ry, float rot, Rgba c) {
+    std::vector<SDL_FPoint> pts;
+    const float cr = std::cos(rot), sr = std::sin(rot);
+    for (int i = 0; i < 64; i++) {
+        float t = 6.2831853f * float(i) / 64, x = rx * std::cos(t), y = ry * std::sin(t);
+        pts.push_back({cx + x * cr - y * sr, cy + x * sr + y * cr});
+    }
+    poly(a, cx, cy, pts, c);
+}
+
+void circle(Art* a, float cx, float cy, float r, Rgba c) { ellipse(a, cx, cy, r, r, 0, c); }
+
+void ring(Art* a, float cx, float cy, float r, float thick, Rgba c) {
+    SDL_FColor col{c.r / 255.f, c.g / 255.f, c.b / 255.f, c.a / 255.f};
+    std::vector<SDL_Vertex> vs;
+    std::vector<int> idx;
+    const int n = 64;
+    for (int i = 0; i < n; i++) {
+        float t = 6.2831853f * float(i) / n;
+        for (float rr : {r, r - thick})
+            vs.push_back({{X(a, cx + rr * std::cos(t)), Y(a, cy + rr * std::sin(t))}, col, {0, 0}});
+        int o = 2 * i, p = 2 * ((i + 1) % n);
+        idx.insert(idx.end(), {o, o + 1, p, p, o + 1, p + 1});
+    }
+    SDL_RenderGeometry(a->r, nullptr, vs.data(), int(vs.size()), idx.data(), int(idx.size()));
+}
+
+void rrect(Art* a, const SDL_FRect& b, float rad, Rgba c) {  // a rounded rectangle, layout space
+    rad = std::min({rad, b.w / 2, b.h / 2});
+    std::vector<SDL_FPoint> pts;
+    const float cx[4] = {b.x + b.w - rad, b.x + rad, b.x + rad, b.x + b.w - rad};
+    const float cy[4] = {b.y + b.h - rad, b.y + b.h - rad, b.y + rad, b.y + rad};
+    for (int q = 0; q < 4; q++)
+        for (int i = 0; i <= 8; i++) {
+            float t = 1.5707963f * (float(q) + float(i) / 8);
+            pts.push_back({cx[q] + rad * std::cos(t), cy[q] + rad * std::sin(t)});
+        }
+    poly(a, b.x + b.w / 2, b.y + b.h / 2, pts, c);
+}
+
+// Text fitted to a width: a smaller size down to `min_em`, then cut with an ellipsis.
+float text_width(Art* a, const std::string& s, float em) {
+    return a->font.ok ? advance(a->font, codepoints(s), em) : float(s.size()) * em * 0.8f;
+}
+
+void fitted(Art* a, std::string s, float x, float y, float em, float min_em, float max_w, Rgba c, Align align) {
+    while (em > min_em && text_width(a, s, em) > max_w) em -= 1;
+    if (text_width(a, s, em) > max_w) {
+        while (!s.empty() && text_width(a, s + "\xe2\x80\xa6", em) > max_w) s.pop_back();
+        s += "\xe2\x80\xa6";
+    }
+    text(a, s, x, y, em, c, align);
+}
+
+const Rgba kHot{255, 204, 112, 255}, kCapture{255, 150, 60, 255}, kInk{20, 22, 40, 255};
+
+// The controller, centred at (cx, cy) in layout space: the control under the cursor (`focus`, an action or -1) is lit.
+void controller(Art* a, float cx, float cy, int focus, bool capturing) {
+    using namespace input;
+    const Rgba hot = capturing ? kCapture : kHot, edge{104, 116, 170, 255}, body{40, 46, 80, 255},
+               part{24, 27, 48, 255}, cap{62, 68, 108, 255}, mark{170, 180, 220, 255};
+    auto lit = [&](int act) { return focus == act; };
+    auto P = [&](float x, float y) { return SDL_FPoint{cx + x, cy + y}; };
+    auto box = [&](float x0, float y0, float x1, float y1) { return SDL_FRect{cx + x0, cy + y0, x1 - x0, y1 - y0}; };
+    // Shoulders: ZL / ZR behind L / R, both behind the body.
+    for (int side : {-1, 1}) {
+        float x0 = side < 0 ? -166 : 78, x1 = side < 0 ? -78 : 166;
+        bool z = lit(side < 0 ? kActZL : kActZR), s = lit(side < 0 ? kActL : kActR);
+        rrect(a, box(x0 - 1, -151, x1 + 1, -117), 13, edge);
+        rrect(a, box(x0, -150, x1, -118), 12, z ? hot : part);
+        text(a, side < 0 ? "ZL" : "ZR", cx + (x0 + x1) / 2, cy - 130, 14, z ? kInk : mark, kCentre);
+        float l0 = side < 0 ? -178 : 70, l1 = side < 0 ? -70 : 178;
+        rrect(a, box(l0 - 1, -127, l1 + 1, -91), 14, edge);
+        rrect(a, box(l0, -126, l1, -92), 13, s ? hot : cap);
+        text(a, side < 0 ? "L" : "R", cx + (l0 + l1) / 2, cy - 107, 14, s ? kInk : mark, kCentre);
+    }
+    // The body: a rounded top and two grips, an edge first, then the fill.
+    for (int pass = 0; pass < 2; pass++) {
+        float g = pass ? 0 : 2;
+        Rgba c = pass ? body : edge;
+        rrect(a, box(-180 - g, -102 - g, 180 + g, 32 + g), 58 + g, c);
+        ellipse(a, cx - 128, cy + 36, 62 + g, 88 + g, 0.32f, c);
+        ellipse(a, cx + 128, cy + 36, 62 + g, 88 + g, -0.32f, c);
+    }
+    // A stick: its well, the cap, a ring when its click is the focus, an arrow for a direction.
+    auto stick = [&](float x, float y, int click, int up) {
+        circle(a, cx + x, cy + y, 31, part);
+        bool dir = focus >= up && focus < up + 4, c = lit(click);
+        circle(a, cx + x, cy + y, 21, c ? hot : cap);
+        circle(a, cx + x, cy + y, 13, c ? Rgba{255, 226, 170, 255} : Rgba{74, 80, 124, 255});
+        if (c) ring(a, cx + x, cy + y, 36, 3, hot);
+        if (dir) {
+            int d = focus - up;  // up, down, left, right
+            float ux = d == 2 ? -1.f : d == 3 ? 1.f : 0.f, uy = d == 0 ? -1.f : d == 1 ? 1.f : 0.f;
+            float tip = 50, base = 36, half = 10;
+            SDL_FPoint p0 = P(x + ux * tip, y + uy * tip), p1 = P(x + ux * base - uy * half, y + uy * base + ux * half),
+                       p2 = P(x + ux * base + uy * half, y + uy * base - ux * half);
+            poly(a, (p0.x + p1.x + p2.x) / 3, (p0.y + p1.y + p2.y) / 3, {p0, p1, p2}, hot);
+            circle(a, cx + x + ux * 6, cy + y + uy * 6, 21, hot);  // the cap pushed that way
+            circle(a, cx + x + ux * 6, cy + y + uy * 6, 13, {255, 226, 170, 255});
+        }
+    };
+    stick(-100, -40, kActLStick, kActLSUp);
+    stick(52, 18, kActRStick, kActRSUp);
+    // Face buttons.
+    struct Face { float x, y; const char* l; int act; };
+    for (const Face& f : {Face{100, -66, "X", kActX}, Face{128, -40, "A", kActA}, Face{100, -14, "B", kActB},
+                          Face{72, -40, "Y", kActY}}) {
+        circle(a, cx + f.x, cy + f.y, 13, lit(f.act) ? hot : part);
+        text(a, f.l, cx + f.x, cy + f.y + 6, 16, lit(f.act) ? kInk : mark, kCentre);
+    }
+    // Minus and Plus; the capture and home buttons are drawn for the look only.
+    for (int side : {-1, 1}) {
+        bool on = lit(side < 0 ? kActMinus : kActPlus);
+        float x = 40.0f * float(side), y = -64;
+        circle(a, cx + x, cy + y, 10, on ? hot : part);
+        Rgba m = on ? kInk : mark;
+        rrect(a, box(x - 5, y - 1.5f, x + 5, y + 1.5f), 1, m);
+        if (side > 0) rrect(a, box(x - 1.5f, y - 5, x + 1.5f, y + 5), 1, m);
+    }
+    rrect(a, box(-31, -34, -19, -22), 3, part);
+    circle(a, cx + 25, cy - 28, 7, part);
+    // The D-pad: a cross, each arm lit on its own, with a small arrow.
+    const float dx = -52, dy = 18;
+    rrect(a, box(dx - 30, dy - 10, dx + 30, dy + 10), 4, part);
+    rrect(a, box(dx - 10, dy - 30, dx + 10, dy + 30), 4, part);
+    for (int d = 0; d < 4; d++) {
+        float ux = d == 2 ? -1.f : d == 3 ? 1.f : 0.f, uy = d == 0 ? -1.f : d == 1 ? 1.f : 0.f;
+        bool on = lit(kActDUp + d);
+        if (on) {
+            float x0 = dx + (ux != 0 ? ux * 30 : -10), x1 = dx + (ux != 0 ? ux * 9 : 10);
+            float y0 = dy + (uy != 0 ? uy * 30 : -10), y1 = dy + (uy != 0 ? uy * 9 : 10);
+            rrect(a, box(std::min(x0, x1), std::min(y0, y1), std::max(x0, x1), std::max(y0, y1)), 4, hot);
+        }
+        float tx = dx + ux * 20, ty = dy + uy * 20;
+        SDL_FPoint p0 = P(tx + ux * 5, ty + uy * 5), p1 = P(tx - uy * 5, ty + ux * 5), p2 = P(tx + uy * 5, ty - ux * 5);
+        poly(a, (p0.x + p1.x + p2.x) / 3, (p0.y + p1.y + p2.y) / 3, {p0, p1, p2}, on ? kInk : mark);
+    }
+}
