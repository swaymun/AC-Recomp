+const std::vector<ControlsPanel>& controls_panels() {
+    using namespace input;
+    static const std::vector<ControlsPanel> panels = {
+        {"Buttons", 60, 112, 300, 1, {kActA, kActB, kActX, kActY, kActPlus, kActMinus}},
+        {"D-pad", 60, 362, 300, 1, {kActDUp, kActDDown, kActDLeft, kActDRight}},
+        {"Left Stick", 376, 112, 300, 1, {kActLStick, kActLSUp, kActLSDown, kActLSLeft, kActLSRight}},
+        {"Right Stick", 376, 330, 300, 1, {kActRStick, kActRSUp, kActRSDown, kActRSLeft, kActRSRight}},
+        {"Triggers", 692, 112, 528, 2, {kActL, kActR, kActZL, kActZR}},
+    };
+    return panels;
+}
+
+SDL_FRect controls_panel_rect(const ControlsPanel& p) {
+    int rows = (int(p.actions.size()) + p.columns - 1) / p.columns;
+    return {p.x, p.y, p.w, 40 + 34.0f * float(rows) + 4};
+}
