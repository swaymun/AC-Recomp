+
+int Menu::controls_step(Nav n) const {
+    const SDL_FRect c = row_rect(cursor);
+    const bool vertical = n == Nav::Up || n == Nav::Down, forward = n == Nav::Down || n == Nav::Right;
+    // Along the move: from the cursor's leading edge to the candidate's near edge. Across: the gap between the two
+    // spans (0 when they overlap). Overlapping candidates win, then the nearest along, the nearest across, centres.
+    auto span = [&](const SDL_FRect& r, bool along) {
+        return along == vertical ? std::pair{r.y, r.y + r.h} : std::pair{r.x, r.x + r.w};
+    };
+    auto [c0, c1] = span(c, true);
+    auto [d0, d1] = span(c, false);
+    int best = cursor;
+    std::array<float, 4> best_score{};
+    for (int i = 0; i < kCtlItems; i++) {
+        if (i == cursor) continue;
+        SDL_FRect r = row_rect(i);
+        if (r.w <= 0) continue;
+        auto [r0, r1] = span(r, true);
+        auto [s0, s1] = span(r, false);
+        float along = forward ? r0 - c1 : c0 - r1;
+        if (along < -1) continue;  // not in that direction
+        float across = std::max({0.0f, s0 - d1, d0 - s1});
+        float centre = std::fabs((s0 + s1) - (d0 + d1)) / 2;
+        std::array<float, 4> score{across > 0 ? 1.0f : 0.0f, std::max(along, 0.0f), across, centre};
+        if (best == cursor || score < best_score) best = i, best_score = score;
+    }
+    return best;
+}
+
+void Menu::controls_nav(Nav n, uint64_t now_ms) {
+    switch (n) {
+    case Nav::Up: case Nav::Down: case Nav::Left: case Nav::Right:
+        cursor = controls_step(n);
+        return;
+    case Nav::Back:
+        return open(Screen::Main, 1);
+    case Nav::Confirm:
+        break;
+    default:
+        return;
+    }
+    if (cursor == kCtlBack) return open(Screen::Main, 1);
+    if (cursor == kCtlTabPad || cursor == kCtlTabKeys) {
+        tab = cursor == kCtlTabPad ? ControlsTab::Gamepad : ControlsTab::Keyboard;
+        notice.clear();
+        return;
+    }
+    if (cursor == kCtlReset) {
+        controls = input::default_controls();
+        controls_dirty = true;
+        notice = "Controls reset to defaults";
+        return;
+    }
+    if (cursor < 0 || cursor >= input::kActionCount) return;
+    capturing = cursor;
+    capture_until = now_ms + kCaptureMs;
+    notice.clear();
+}
