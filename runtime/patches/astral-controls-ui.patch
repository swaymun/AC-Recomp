+    case kActLStick: case kActRStick: return "Click";
+    case kActDUp: case kActLSUp: case kActRSUp: return "Up";
+    case kActDDown: case kActLSDown: case kActRSDown: return "Down";
+    case kActDLeft: case kActLSLeft: case kActRSLeft: return "Left";
