+#if defined(NX_ASTRAL_STRICT)
+namespace {
+// Bytes per 4x4 block of a BC format; 0 for any other.
+uint32_t bc_block_bytes(VkFormat f) {
+    switch (f) {
+        case VK_FORMAT_BC1_RGB_UNORM_BLOCK: case VK_FORMAT_BC1_RGB_SRGB_BLOCK: case VK_FORMAT_BC1_RGBA_UNORM_BLOCK:
+        case VK_FORMAT_BC1_RGBA_SRGB_BLOCK: case VK_FORMAT_BC4_UNORM_BLOCK: case VK_FORMAT_BC4_SNORM_BLOCK: return 8;
+        case VK_FORMAT_BC2_UNORM_BLOCK: case VK_FORMAT_BC2_SRGB_BLOCK: case VK_FORMAT_BC3_UNORM_BLOCK:
+        case VK_FORMAT_BC3_SRGB_BLOCK: case VK_FORMAT_BC5_UNORM_BLOCK: case VK_FORMAT_BC5_SNORM_BLOCK:
+        case VK_FORMAT_BC6H_UFLOAT_BLOCK: case VK_FORMAT_BC6H_SFLOAT_BLOCK: case VK_FORMAT_BC7_UNORM_BLOCK:
+        case VK_FORMAT_BC7_SRGB_BLOCK: return 16;
+        default: return 0;
+    }
+}
+}  // namespace
+
+std::vector<VkBufferImageCopy> bc_zero_fill_regions(const GpuImage& img, const VkImageSubresourceRange& r,
+                                                    uint64_t& total) {
+    std::vector<VkBufferImageCopy> regions;
+    total = 0;
+    const uint32_t block = bc_block_bytes(img.format);
+    if (!block) return regions;
+    const uint32_t end = std::min<uint64_t>(img.levels, uint64_t(r.baseMipLevel) + r.levelCount);
+    for (uint32_t l = r.baseMipLevel; l < end; l++) {
+        // 3D images have one layer and `depth` slices (nvn_image.cpp); every other image has depth 1.
+        const uint32_t w = std::max(1u, img.width >> l), h = std::max(1u, img.height >> l);
+        const uint32_t d = std::max(1u, img.depth >> l);
+        VkBufferImageCopy c{};
+        c.bufferOffset = total;  // tightly packed: bufferRowLength and bufferImageHeight 0
+        c.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, l, r.baseArrayLayer, r.layerCount};
+        c.imageExtent = {w, h, d};
+        regions.push_back(c);
+        total += uint64_t((w + 3) / 4) * ((h + 3) / 4) * d * r.layerCount * block;
+    }
+    return regions;
 }
 
+bool zero_fill_compressed(VkCommandBuffer cb, GpuImage& img, const VkImageSubresourceRange& r) {
+    if (!bc_block_bytes(img.format)) return false;
+    uint64_t total = 0;
+    std::vector<VkBufferImageCopy> regions = bc_zero_fill_regions(img, r, total);
+    if (regions.empty()) return true;
+    // A big fill gets a staging buffer of its own on the same terms as a big texture upload, so a scene load's
+    // fills cannot wrap the ring over the uploads of the same submit (DEBUG-2 #72).
+    Upload u = total >= (1u << 20) && !std::getenv("NX_STAGING_RING") && staging_wanted(total)
+                   ? staging_alloc(total)
+                   : upload_alloc(total, 16);
+    std::memset(u.ptr, 0, total);
+    for (VkBufferImageCopy& c : regions) c.bufferOffset += u.offset;
+    p_vkCmdCopyBufferToImage(cb, u.buffer, img.image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, uint32_t(regions.size()),
+                             regions.data());
+    return true;
+}
