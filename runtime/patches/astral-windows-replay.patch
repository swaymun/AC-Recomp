@@ -0,0 +1,27 @@
+// Original effective graphics-key canonicalization. Device feature policy is unchanged.
+#pragma once
+#include "nvn_pipeline.h"
+namespace nx::nvn {
+inline void canonical_replay_key(PipelineKey& key) {
+    uint32_t used=0, count=0, streams=0;
+    if (key.vs) for (const auto& in : key.vs->refl.inputs)
+        if (in.location<key.attrib_count && in.location<16) used |= 1u<<in.location;
+    for (uint32_t a=0; a<16; ++a) {
+        if (!(used>>a&1)) key.attribs[a] = {};
+        else { count=a+1; if (key.attribs[a].stream<15 && vk_vertex_format(key.attribs[a].format)!=VK_FORMAT_UNDEFINED)
+            streams |= 1u<<key.attribs[a].stream; }
+    }
+    key.attrib_count=count; key.stream_count=0;
+    for (uint32_t s=0; s<16; ++s)
+        if (!(streams>>s&1)) key.streams[s]={}; else key.stream_count=s+1;
+    // Alpha-test and logic-op fields are not consumed by this pipeline builder.
+    key.color.alpha_test=key.color.logic_op=0;
+    for (uint32_t a=0; a<8; ++a) {
+        if (a>=key.color_count) { key.color_formats[a]=VK_FORMAT_UNDEFINED; key.mask.mask[a]=0; key.color.blend_enable[a]=0; }
+        key.mask.mask[a] &= 15;
+        if (!key.color.blend_enable[a] || !key.mask.mask[a]) key.blend[a]={};
+        else key.blend[a].target=0;  // array index, not this metadata field, selects the attachment
+    }
+    if (key.color_count<8) key.ufloat_colors &= (1u<<key.color_count)-1;
+}
+}  // namespace nx::nvn
