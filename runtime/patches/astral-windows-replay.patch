@@ -0,0 +1,33 @@
+// Original Windows command replay experiments. Options freeze before the first recording.
+#pragma once
+#include <cstdlib>
+namespace nx::nvn {
+struct ReplayOptions {
+    bool environment = false, pool = false, keys = false, dynamic = false, scratch = false;
+    bool resident = false, resident_read = true, resident_storage = true;
+};
+inline const ReplayOptions& replay_options() {
+    static const ReplayOptions options = [] {
+        ReplayOptions o;
+#if defined(NX_ASTRAL_STRICT) && defined(_WIN32)
+        auto on = [](const char* name) { const char* e = std::getenv(name); return e && std::atoi(e) != 0; };
+        auto part = [](const char* name) { const char* e = std::getenv(name); return !e || std::atoi(e) != 0; };
+        o.environment = on("NX_REPLAY_ENV"); o.pool = on("NX_REPLAY_POOL");
+        o.keys = on("NX_REPLAY_KEYS"); o.dynamic = on("NX_REPLAY_DYNAMIC"); o.scratch = on("NX_REPLAY_SCRATCH");
+        o.resident = on("NX_RESIDENT"); o.resident_read = part("NX_RESIDENT_READ");
+        o.resident_storage = part("NX_RESIDENT_STORAGE");
+#endif
+        return o;
+    }();
+    return options;
+}
+inline bool replay_resident_enabled() {
+    if (replay_options().environment) return replay_options().resident;
+    const char* e = std::getenv("NX_RESIDENT"); return e && std::atoi(e) != 0;
+}
+inline bool replay_resident_part(bool storage) {
+    if (replay_options().environment) return storage ? replay_options().resident_storage : replay_options().resident_read;
+    const char* e = std::getenv(storage ? "NX_RESIDENT_STORAGE" : "NX_RESIDENT_READ");
+    return !e || std::atoi(e) != 0;
+}
+}  // namespace nx::nvn
