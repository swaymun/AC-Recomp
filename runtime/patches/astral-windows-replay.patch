diff --git a/runtime/src/nvn/nvn_command_storage.h b/runtime/src/nvn/nvn_command_storage.h
new file mode 100644
index 0000000..83965f8
--- /dev/null
+++ b/runtime/src/nvn/nvn_command_storage.h
@@ -0,0 +1,60 @@
+// Original immutable command payload arena and bounded final-owner recycling.
+#pragma once
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <vector>
+#include "nvn_replay_options.h"
+namespace nx::nvn {
+struct CommandBlobView {
+    const uint8_t* ptr; size_t bytes;
+    const uint8_t* data() const { return ptr; }
+    size_t size() const { return bytes; }
+};
+class CommandBlobs {
+    struct Span { size_t offset, bytes; };
+    bool packed_ = replay_options().pool;
+    std::vector<std::vector<uint8_t>> legacy_;
+    std::vector<uint8_t> data_;
+    std::vector<Span> spans_;
+public:
+    size_t size() const { return packed_ ? spans_.size() : legacy_.size(); }
+    CommandBlobView operator[](size_t i) const {
+        if (!packed_) return {legacy_[i].data(), legacy_[i].size()};
+        const auto& s = spans_[i]; return {data_.data()+s.offset, s.bytes};
+    }
+    void emplace_back(const uint8_t* first, const uint8_t* last) {
+        if (!packed_) { legacy_.emplace_back(first,last); return; }
+        // Vertex-state replay casts payloads to aligned POD arrays. Offsets survive arena growth.
+        const size_t at = (data_.size()+alignof(std::max_align_t)-1) & ~(alignof(std::max_align_t)-1);
+        data_.resize(at); const size_t count = size_t(last-first);
+        data_.insert(data_.end(),first,last); spans_.push_back({at,count});
+    }
+    void clear() { legacy_.clear(); data_.clear(); spans_.clear(); }
+    size_t retained_bytes() const { return data_.capacity()+spans_.capacity()*sizeof(Span); }
+};
+inline std::atomic<uint64_t> g_replay_created{0}, g_replay_reused{0}, g_replay_released{0};
+template<class T> class CommandListPool {
+    std::mutex lock_;
+    std::vector<std::unique_ptr<T>> free_;
+    size_t bytes_ = 0;
+    static constexpr size_t max_bytes = 32u<<20, max_lists = 256;
+public:
+    std::shared_ptr<T> acquire(const std::shared_ptr<CommandListPool>& owner) {
+        std::unique_ptr<T> item;
+        { std::lock_guard lk(lock_);
+          if (!free_.empty()) { item=std::move(free_.back()); free_.pop_back(); bytes_-=item->retained_bytes(); } }
+        if (item) ++g_replay_reused; else { item=std::make_unique<T>(); ++g_replay_created; }
+        return std::shared_ptr<T>(item.release(),[owner](T* p) { owner->release(std::unique_ptr<T>(p)); });
+    }
+    void release(std::unique_ptr<T> p) {
+        // Called only after the handle, recording and every queued replay release their shared owners.
+        p->reset(); const size_t bytes=p->retained_bytes(); std::lock_guard lk(lock_);
+        if (free_.size()<max_lists && bytes<=max_bytes-bytes_) { bytes_+=bytes; free_.push_back(std::move(p)); }
+        else ++g_replay_released;
+    }
+    size_t retained_bytes() { std::lock_guard lk(lock_); return bytes_; }
+};
+}  // namespace nx::nvn
