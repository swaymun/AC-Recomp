+// loaded it draws on every Metal layer at present, the game's (MoltenVK's) included, and the process cannot switch it
+// off or on again: checked on macOS 26, neither CAMetalLayer.developerHUDProperties nor the HUD's ToggleEnabled
+// notification changed it. Its own menu (Metal HUD > Enable HUD) can; F3 only says so. HUD off at start: nothing is
+// loaded and F3 toggles the built-in HUD for that run. Dumps (NX_DUMP_FRAMES) never contain Apple's HUD.
+namespace metal_hud {
+bool g_loaded = false;   // MTL_HUD_ENABLED=1 before any Metal device: the HUD library is in and shown
+void preload() {
+    if (headless() || nx::hud::capture_run(data_root())) return;  // dumps keep the built-in HUD
+    const char* user = std::getenv("MTL_HUD_ENABLED");
+    if (user && *user) {
+        g_loaded = *user != '0';
+        return;
+    }
+    std::string text;
+    if (FILE* f = std::fopen((data_root() + "/settings.ini").c_str(), "rb")) {
+        char buf[4096];
+        size_t n = std::fread(buf, 1, sizeof buf, f);
+        text.assign(buf, n);
+        std::fclose(f);
+    }
+    if (!nx::hud::native_wanted_at_start(std::getenv("NX_PERF_HUD"), text)) return;
+    setenv("MTL_HUD_ENABLED", "1", 1);
+    g_loaded = true;
+}
+// It stays as loaded: shown. Asking for anything else fails, with a hint.
+bool show(bool on) {
+    if (g_loaded && on) return true;
+    nx::log("perf hud: Apple's Metal HUD cannot be switched while the game runs: use its menu (Metal HUD > Enable "
+            "HUD), or change the Performance HUD setting and restart");
+    return false;
+}
