+// Optional on-screen performance HUD, Astral strict builds only (perf_hud.cpp, docs/ASTRAL_PERF_HUD.md).
+// NX_PERF_HUD=1 shows it from the start; F3 toggles it on desktop. Where the platform has its own overlay (Apple's
+// Metal Performance HUD on macOS, MangoHud on Linux) that is shown instead, unless NX_PERF_HUD=ac. The built-in text
+// is rasterised on the CPU with an 8x8 public domain font into a 4-byte-per-pixel bitmap with an opaque dark
+// background. nvn_hud.cpp copies the bitmap into the top-right corner of the swapchain image before present;
+// nvn_debug.cpp draws it into NX_DUMP_FRAMES dumps.
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace nx::hud {
+
+// ---- text rasteriser ----
+constexpr uint32_t kGlyph = 8;    // font cell, pixels (before scaling)
+constexpr uint32_t kLineGap = 2;  // between lines
+constexpr uint32_t kPad = 4;      // background border around the text
+constexpr uint8_t kBackground[3] = {0x10, 0x10, 0x18};  // R, G, B; alpha 255
+constexpr uint8_t kText[3] = {0xff, 0xff, 0xff};
+
+struct Bitmap {
+    uint32_t width = 0, height = 0;
+    std::vector<uint8_t> px;  // width * height * 4 bytes, rows top first; R,G,B,A (or B,G,R,A when bgra)
+};
+// Lines of ASCII (anything else is drawn as '?'), each font pixel `scale` x `scale`. Empty input: an empty bitmap.
+Bitmap rasterise(const std::vector<std::string>& lines, uint32_t scale, bool bgra);
+// The scale for an output `height` pixels high: 1 at 720p, 2 at 1080p, 4 at 2160p.
+uint32_t scale_for(uint32_t height);
+// Where `b` goes in a `w` x `h` image: the top-right corner, `kPad * scale` from the edges. False: does not fit.
+bool corner(const Bitmap& b, uint32_t w, uint32_t h, uint32_t scale, uint32_t& x, uint32_t& y);
+// Copies `b` into the top-right corner of a `w` x `h` image (4 bytes per pixel, tightly packed, same channel order).
+bool composite(const Bitmap& b, uint32_t scale, uint8_t* px, uint32_t w, uint32_t h);
+
+// ---- what it shows ----
+struct Sample {
+    double fps = 0, avg_ms = 0, max_ms = 0;  // presents per second and the intervals between them, over 1 s
+    int interval = 1;                        // the NVN window's present interval (vsyncs at 60 Hz)
+    double cpu_pct = -1;                     // process CPU time over wall time (100 = one core busy); < 0: n/a
+    unsigned cores = 0;
+    double rss_mb = -1;                      // resident memory; < 0: n/a
+    std::string thermal = "n/a", gpu = "n/a";
+    uint32_t out_w = 0, out_h = 0;           // presented image (0: headless)
+    uint32_t game_w = 0, game_h = 0;         // the game's presented texture
+};
+std::vector<std::string> format(const Sample& s);
+// Game speed in percent: frames per second times the frames each one stands for (interval / 60 s).
+double speed_pct(double fps, int interval);
+
+// ---- state (thread-safe) ----
+bool enabled();  // NX_PERF_HUD=1 at start; F3 toggles
+void toggle();
+void set_gpu(const char* name);
+void note_interval(int interval);  // nvnQueuePresentTexture: the window's present interval
+// One present (windowed or headless): the game texture's size, the output's (0 x 0: headless). Each full second
+// the sample is taken and the text re-made. Does nothing while the HUD is off.
+void on_present(uint32_t game_w, uint32_t game_h, uint32_t out_w, uint32_t out_h);
+std::vector<std::string> lines();
+// The bitmap for an output `height` pixels high, re-rasterised only when the text, scale or channel order changed.
+std::shared_ptr<const Bitmap> bitmap(uint32_t height, bool bgra);
+// Into a dumped frame (CPU, nvn_debug.cpp): false when off or it does not fit.
+bool composite_frame(uint8_t* px, uint32_t w, uint32_t h, bool bgra);
+
+// ---- native overlays (docs/ASTRAL_PERF_HUD.md) ----
+// Where the platform has its own overlay, NX_PERF_HUD shows that instead of the built-in HUD: Apple's Metal
+// Performance HUD on macOS (platform_mac.cpp), MangoHud on Linux when installed (prepare_native_overlay). Windows has
+// none. NX_PERF_HUD=ac (any case) always uses the built-in HUD; headless and capture runs (capture_run) keep it too.
+// A native overlay is drawn when the frame is presented, so it is never in the dumped pixels.
+bool builtin_forced();  // NX_PERF_HUD=ac
+// `show(on)` shows or hides a native overlay (false: it could not). use_native hands it the HUD's on/off state (one
+// show(state) call at once) and F3; the built-in HUD is then off and does no work. Refused (false) with
+// NX_PERF_HUD=ac, without `show`, when another overlay already took over, or when `show(true)` fails (the built-in
+// HUD stays on).
+using NativeShow = bool (*)(bool on);
+bool use_native(NativeShow show, const char* name);
+const char* native_name();  // nullptr: the built-in HUD
+bool native_on();
+// Whether the HUD is on when the process starts: NX_PERF_HUD (`env`, nullptr: unset) not empty, 0 or ac; unset: the
+// launcher's settings.ini says perf_hud = 1/on/true/yes. macOS asks before any Metal device exists (MTL_HUD_ENABLED).
+bool native_wanted_at_start(const char* env, const std::string& settings_ini);
+// MangoHud: its implicit Vulkan layer manifest (MangoHud*.json) in one of `dirs`.
+bool mangohud_installed(const std::vector<std::string>& dirs);
+std::vector<std::string> vulkan_implicit_layer_dirs();  // the Linux loader's implicit-layer search path
+// MANGOHUD_CONFIG when the player set neither it nor MANGOHUD_CONFIGFILE: the player's MangoHud.conf still loads
+// (read_cfg); on top of it F3 toggles, top right, and the rows the built-in HUD has.
+constexpr const char* kMangoHudConfig =
+    "read_cfg,toggle_hud=F3,position=top-right,fps,frametime,frame_timing,cpu_stats,gpu_stats,gpu_name,ram,vram,resolution";
+// HUD on at start, not NX_PERF_HUD=ac, MANGOHUD not 0 and MangoHud in `dirs`: sets MANGOHUD=1 (and MANGOHUD_CONFIG)
+// and hands the HUD to MangoHud. Must run before vkCreateInstance, while no other thread reads the environment.
+bool start_mangohud(const std::vector<std::string>& dirs);
+// A run whose output is captured: NX_DUMP_FRAMES, NX_INPUT_SCRIPT or NX_AUDIO_DUMP set (not empty or 0), or a
+// dump_frames file in `data_root`. Native overlays are skipped there (dumps contain only the built-in HUD).
+bool capture_run(const std::string& data_root);
+// start_mangohud unless `headless` or capture_run(data_root).
+bool start_mangohud_for_run(bool headless, const std::string& data_root, const std::vector<std::string>& dirs);
+// platform_linux.cpp main, right after the launcher exported the settings and before the game thread starts:
+// start_mangohud on Linux desktop runs that are neither headless nor capture runs; elsewhere nothing.
+bool prepare_native_overlay();
+
+// ---- host probes ("n/a" / negative where the platform has none) ----
+double process_cpu_seconds();
+int64_t resident_bytes();
+std::string thermal_state();
+
+}  // namespace nx::hud
