+// ---- text rasteriser ----
+
+Bitmap rasterise(const std::vector<std::string>& lines, uint32_t scale, bool bgra) {
+    Bitmap b;
+    size_t cols = 0;
+    for (const std::string& l : lines) cols = std::max(cols, l.size());
+    if (lines.empty() || !scale) return b;
+    const uint32_t n = uint32_t(lines.size());
+    b.width = (2 * kPad + uint32_t(cols) * kGlyph) * scale;
+    b.height = (2 * kPad + n * kGlyph + (n - 1) * kLineGap) * scale;
+    b.px.resize(size_t(b.width) * b.height * 4);
+    const uint8_t bg[4] = {bgra ? kBackground[2] : kBackground[0], kBackground[1], bgra ? kBackground[0] : kBackground[2],
+                           0xff};
+    const uint8_t fg[4] = {bgra ? kText[2] : kText[0], kText[1], bgra ? kText[0] : kText[2], 0xff};
+    for (size_t k = 0; k < b.px.size(); k += 4) std::memcpy(&b.px[k], bg, 4);
+    for (uint32_t row = 0; row < n; row++) {
+        const std::string& l = lines[row];
+        for (size_t col = 0; col < l.size(); col++) {
+            unsigned char ch = static_cast<unsigned char>(l[col]);
+            const uint8_t* glyph = kFont8x8[(ch >= 0x20 && ch <= 0x7e ? ch : '?') - 0x20];
+            uint32_t x0 = (kPad + uint32_t(col) * kGlyph) * scale, y0 = (kPad + row * (kGlyph + kLineGap)) * scale;
+            for (uint32_t gy = 0; gy < kGlyph; gy++)
+                for (uint32_t gx = 0; gx < kGlyph; gx++) {
+                    if (!(glyph[gy] >> gx & 1)) continue;
+                    for (uint32_t sy = 0; sy < scale; sy++)
+                        for (uint32_t sx = 0; sx < scale; sx++)
+                            std::memcpy(&b.px[(size_t(y0 + gy * scale + sy) * b.width + x0 + gx * scale + sx) * 4], fg, 4);
+                }
+        }
+    }
+    return b;
+}
+
+uint32_t scale_for(uint32_t height) { return std::max(1u, (height + 270) / 540); }
+
+bool corner(const Bitmap& b, uint32_t w, uint32_t h, uint32_t scale, uint32_t& x, uint32_t& y) {
+    uint32_t margin = kPad * scale;
+    if (!b.width || uint64_t(b.width) + margin > w || uint64_t(b.height) + margin > h) return false;
+    x = w - b.width - margin, y = margin;
+    return true;
+}
+
+bool composite(const Bitmap& b, uint32_t scale, uint8_t* px, uint32_t w, uint32_t h) {
+    uint32_t x = 0, y = 0;
+    if (!px || !corner(b, w, h, scale, x, y)) return false;
+    for (uint32_t row = 0; row < b.height; row++)
+        std::memcpy(px + (size_t(y + row) * w + x) * 4, &b.px[size_t(row) * b.width * 4], size_t(b.width) * 4);
+    return true;
+}
+
+// ---- text ----
+
+double speed_pct(double fps, int interval) { return fps * double(std::max(interval, 1)) / 60.0 * 100.0; }
+
+std::vector<std::string> format(const Sample& s) {
+    char b[160];
+    std::vector<std::string> out;
+    auto add = [&](int n) { out.emplace_back(b, size_t(std::clamp(n, 0, int(sizeof b) - 1))); };
+    int target = 60 / std::max(s.interval, 1);
+    add(std::snprintf(b, sizeof b, "FPS %.1f", s.fps));
+    add(std::snprintf(b, sizeof b, "Frame %.1f ms avg, %.1f max", s.avg_ms, s.max_ms));
+    add(std::snprintf(b, sizeof b, "Speed %.0f%% of %d fps", speed_pct(s.fps, s.interval), target));
+    if (s.cpu_pct < 0) add(std::snprintf(b, sizeof b, "CPU n/a"));
+    else add(std::snprintf(b, sizeof b, "CPU %.0f%% (%u cores)", s.cpu_pct, s.cores));
+    if (s.rss_mb < 0) add(std::snprintf(b, sizeof b, "RAM n/a"));
+    else add(std::snprintf(b, sizeof b, "RAM %.0f MB", s.rss_mb));
+    add(std::snprintf(b, sizeof b, "Thermal %s", s.thermal.c_str()));
+    add(std::snprintf(b, sizeof b, "GPU %.40s", s.gpu.c_str()));
+    if (s.out_w && s.out_h)
+        add(std::snprintf(b, sizeof b, "%ux%u, game %ux%u", s.out_w, s.out_h, s.game_w, s.game_h));
+    else
+        add(std::snprintf(b, sizeof b, "headless, game %ux%u", s.game_w, s.game_h));
+    return out;
+}
+
+// ---- host probes ----
+
+double process_cpu_seconds() {
+#if defined(_WIN32)
+    FILETIME created, exited, kernel, user;
+    if (!GetProcessTimes(GetCurrentProcess(), &created, &exited, &kernel, &user)) return -1;
+    auto secs = [](const FILETIME& f) { return double((uint64_t(f.dwHighDateTime) << 32) | f.dwLowDateTime) * 1e-7; };
+    return secs(kernel) + secs(user);
+#else
+    rusage u{};
+    if (getrusage(RUSAGE_SELF, &u) != 0) return -1;
+    return double(u.ru_utime.tv_sec + u.ru_stime.tv_sec) + double(u.ru_utime.tv_usec + u.ru_stime.tv_usec) * 1e-6;
+#endif
+}
+
+int64_t resident_bytes() {
+#if defined(__APPLE__)
+    mach_task_basic_info_data_t info{};
+    mach_msg_type_number_t count = MACH_TASK_BASIC_INFO_COUNT;
+    if (task_info(mach_task_self(), MACH_TASK_BASIC_INFO, reinterpret_cast<task_info_t>(&info), &count) != KERN_SUCCESS)
+        return -1;
+    return int64_t(info.resident_size);
+#elif defined(_WIN32)
+    PROCESS_MEMORY_COUNTERS pmc{};
+    if (!GetProcessMemoryInfo(GetCurrentProcess(), &pmc, sizeof pmc)) return -1;
+    return int64_t(pmc.WorkingSetSize);
+#elif defined(__linux__)
+    long long pages_total = 0, pages_resident = 0;
+    FILE* f = std::fopen("/proc/self/statm", "r");
+    if (!f) return -1;
+    int got = std::fscanf(f, "%lld %lld", &pages_total, &pages_resident);
+    std::fclose(f);
+    return got == 2 ? int64_t(pages_resident) * int64_t(sysconf(_SC_PAGESIZE)) : -1;
+#else
+    return -1;
+#endif
+}
+
+std::string thermal_state() {
+#if defined(__APPLE__)
+    // The system's thermal pressure (what NSProcessInfo.thermalState follows), through notify(3): no Objective-C.
+    static int token = -1;
+    static bool registered = notify_register_check(kOSThermalNotificationPressureLevelName, &token) == NOTIFY_STATUS_OK;
+    uint64_t level = 0;
+    if (!registered || notify_get_state(token, &level) != NOTIFY_STATUS_OK) return "n/a";
+    switch (level) {
+    case kOSThermalPressureLevelNominal: return "nominal";
+#if !TARGET_OS_OSX
+    case kOSThermalPressureLevelLight: return "light";
+#endif
+    case kOSThermalPressureLevelModerate: return "moderate";
+    case kOSThermalPressureLevelHeavy: return "heavy";
+    case kOSThermalPressureLevelTrapping: return "trapping";
+    case kOSThermalPressureLevelSleeping: return "sleeping";
+    default: return "level " + std::to_string(level);
+    }
+#elif defined(__linux__)
+    // The hottest thermal zone the kernel exposes (millidegrees Celsius); none readable: n/a.
+    long hottest = LONG_MIN;
+    for (int k = 0; k < 16; k++) {
+        char path[64];
+        std::snprintf(path, sizeof path, "/sys/class/thermal/thermal_zone%d/temp", k);
+        FILE* f = std::fopen(path, "r");
+        if (!f) continue;
+        long t = 0;
+        if (std::fscanf(f, "%ld", &t) == 1) hottest = std::max(hottest, t);
+        std::fclose(f);
+    }
+    if (hottest == LONG_MIN) return "n/a";
+    char b[32];
+    std::snprintf(b, sizeof b, "%.0f C (hottest zone)", double(hottest) / 1000.0);
+    return b;
+#else
+    return "n/a";  // Windows: no thermal state for an unprivileged process
+#endif
+}
+
+// ---- state ----
+
+namespace {
+
+struct State {
+    std::mutex lock;
+    std::string gpu = "n/a";
+    uint64_t window_from = 0, last = 0, frames = 0, intervals = 0, sum_ns = 0, max_ns = 0;
+    double cpu_from = 0;
+    uint32_t game_w = 0, game_h = 0, out_w = 0, out_h = 0;
+    std::vector<std::string> text;
+    uint64_t version = 1;  // of `text`
+    std::shared_ptr<const Bitmap> bitmap;
+    uint64_t bitmap_version = 0;
+    uint32_t bitmap_scale = 0;
+    bool bitmap_bgra = false;
+};
+
+State& state() {
+    static State s;
+    return s;
+}
+
+std::atomic<bool>& on_flag() {
+    static std::atomic<bool> on = [] {
+        const char* e = std::getenv("NX_PERF_HUD");
+        return e && e[0] && e[0] != '0';
+    }();
+    return on;
+}
+
+std::atomic<int> g_interval{1};
+
+}  // namespace
+
+bool enabled() { return on_flag().load(std::memory_order_relaxed); }
+
+// ---- native overlays ----
+
+namespace {
+std::atomic<NativeShow> g_native{nullptr};
+std::atomic<bool> g_native_on{false};
+std::atomic<const char*> g_native_name{nullptr};
+}  // namespace
+
+static bool is_ac(const char* e) { return e && (e[0] == 'a' || e[0] == 'A') && (e[1] == 'c' || e[1] == 'C') && !e[2]; }
+
+bool builtin_forced() { return is_ac(std::getenv("NX_PERF_HUD")); }
+
+bool native_wanted_at_start(const char* env, const std::string& settings_ini) {
+    if (env) return env[0] && env[0] != '0' && !is_ac(env);
+    // The launcher's settings.ini (input_map.cpp writes it): "perf_hud = 1" in any section, case-insensitive keys.
+    bool on = false;
+    size_t at = 0;
+    while (at < settings_ini.size()) {
+        size_t end = settings_ini.find('\n', at);
+        if (end == std::string::npos) end = settings_ini.size();
+        std::string line = settings_ini.substr(at, end - at);
+        at = end + 1;
+        size_t eq = line.find('=');
+        if (eq == std::string::npos) continue;
+        auto trim = [](std::string s) {
+            size_t a = s.find_first_not_of(" \t\r"), b = s.find_last_not_of(" \t\r");
+            s = a == std::string::npos ? "" : s.substr(a, b - a + 1);
+            for (char& c : s) c = char(std::tolower(static_cast<unsigned char>(c)));
+            return s;
+        };
+        if (trim(line.substr(0, eq)) != "perf_hud") continue;
+        std::string v = trim(line.substr(eq + 1));
+        on = v == "1" || v == "on" || v == "true" || v == "yes";
+    }
+    return on;
+}
+
+bool use_native(NativeShow show, const char* name) {
+    if (!show || builtin_forced() || g_native.load()) return false;
+    bool on = on_flag().exchange(false);  // the built-in HUD stops measuring and drawing
+    if (!show(on) && on) {
+        on_flag().store(true);
+        nx::log("perf hud: %s could not be shown; the built-in HUD stays", name);
+        return false;
+    }
+    g_native_on.store(on);
+    g_native_name.store(name);
+    g_native.store(show);
+    nx::log("perf hud: %s instead of the built-in HUD (%s)", name, on ? "on" : "off");
+    return true;
+}
+
+const char* native_name() { return g_native_name.load(); }
+bool native_on() { return g_native_on.load(); }
+
+bool mangohud_installed(const std::vector<std::string>& dirs) {
+    for (const std::string& d : dirs) {
+        std::error_code ec;
+        for (std::filesystem::directory_iterator it(d, ec), end; !ec && it != end; it.increment(ec)) {
+            std::string n = it->path().filename().string();
+            if (n.rfind("MangoHud", 0) == 0 && n.size() > 5 && n.compare(n.size() - 5, 5, ".json") == 0) return true;
+        }
+    }
+    return false;
+}
+
+std::vector<std::string> vulkan_implicit_layer_dirs() {
+    // The Vulkan loader's implicit-layer search path on Linux (the loader's LoaderLayerInterface documentation).
+    std::vector<std::string> out;
+    auto each = [&](const char* list, const char* fallback) {
+        std::string s = list && *list ? list : fallback;
+        for (size_t at = 0; at <= s.size();) {
+            size_t end = s.find(':', at);
+            if (end == std::string::npos) end = s.size();
+            if (end > at) out.push_back(s.substr(at, end - at) + "/vulkan/implicit_layer.d");
+            at = end + 1;
+        }
+    };
+    const char* home = std::getenv("HOME");
+    const char* config_home = std::getenv("XDG_CONFIG_HOME");
+    if (config_home && *config_home) out.push_back(std::string(config_home) + "/vulkan/implicit_layer.d");
+    else if (home && *home) out.push_back(std::string(home) + "/.config/vulkan/implicit_layer.d");
+    each(std::getenv("XDG_CONFIG_DIRS"), "/etc/xdg");
+    out.push_back("/etc/vulkan/implicit_layer.d");
+    const char* data_home = std::getenv("XDG_DATA_HOME");
+    if (data_home && *data_home) out.push_back(std::string(data_home) + "/vulkan/implicit_layer.d");
+    else if (home && *home) out.push_back(std::string(home) + "/.local/share/vulkan/implicit_layer.d");
+    each(std::getenv("XDG_DATA_DIRS"), "/usr/local/share:/usr/share");
+    return out;
+}
+
+bool start_mangohud(const std::vector<std::string>& dirs) {
+    if (!enabled() || builtin_forced() || g_native.load()) return false;  // off at start: no layer, F3 = built-in
+    const char* user = std::getenv("MANGOHUD");
+    if ((user && user[0] == '0') || !mangohud_installed(dirs)) return false;
+#if defined(_WIN32)
+    return false;  // MangoHud is a Linux layer (and Windows has no setenv)
+#else
+    setenv("MANGOHUD", "1", 0);  // the layer's enable_environment, read by the loader at vkCreateInstance
+    if (!std::getenv("MANGOHUD_CONFIG") && !std::getenv("MANGOHUD_CONFIGFILE"))
+        setenv("MANGOHUD_CONFIG", kMangoHudConfig, 0);
+    // MangoHud reads F3 itself (toggle_hud=F3): our F3 only keeps the state in step.
+    return use_native([](bool) { return true; }, "MangoHud");
+#endif
+}
+
+bool capture_run(const std::string& data_root) {
+    for (const char* name : {"NX_DUMP_FRAMES", "NX_INPUT_SCRIPT", "NX_AUDIO_DUMP"}) {
+        const char* v = std::getenv(name);
+        if (v && v[0] && v[0] != '0') return true;
+    }
+    std::error_code ec;
+    return !data_root.empty() && std::filesystem::exists(data_root + "/dump_frames", ec);
+}
+
+bool start_mangohud_for_run(bool headless, const std::string& data_root, const std::vector<std::string>& dirs) {
+    // Headless and capture runs keep the built-in HUD: it is the one in the dumped frames.
+    return !headless && !capture_run(data_root) && start_mangohud(dirs);
+}
+
+bool prepare_native_overlay() {
+#if defined(__linux__) && !defined(__ANDROID__)
+    return start_mangohud_for_run(plat::headless(), plat::data_root(), vulkan_implicit_layer_dirs());
+#else
+    return false;
+#endif
+}
+
+void toggle() {
+    if (NativeShow show = g_native.load()) {
+        bool now = !g_native_on.load();
+        if (!show(now)) return;  // it could not (show says why): the state stays
+        g_native_on.store(now);
+        nx::log("perf hud: %s %s", g_native_name.load(), now ? "on" : "off");
+        return;
+    }
+    bool now = !on_flag().load();
+    on_flag().store(now);
+    nx::log("perf hud: %s", now ? "on" : "off");
+}
+
+void set_gpu(const char* name) {
+    std::lock_guard lk(state().lock);
+    state().gpu = name && *name ? name : "n/a";
+}
+
+void note_interval(int interval) { g_interval.store(interval, std::memory_order_relaxed); }
+
+void on_present(uint32_t game_w, uint32_t game_h, uint32_t out_w, uint32_t out_h) {
+    State& s = state();
+    std::lock_guard lk(s.lock);
+    if (!enabled()) {
+        s.window_from = s.last = 0;  // a fresh window when it is turned on again
+        return;
+    }
+    uint64_t now = plat::monotonic_ns();
+    s.game_w = game_w, s.game_h = game_h, s.out_w = out_w, s.out_h = out_h;
+    if (!s.window_from) {
+        s.window_from = s.last = now;
+        s.frames = s.intervals = s.sum_ns = s.max_ns = 0;
+        s.cpu_from = process_cpu_seconds();
+        if (s.text.empty()) {
+            Sample first;
+            first.interval = g_interval.load(std::memory_order_relaxed), first.gpu = s.gpu;
+            first.out_w = out_w, first.out_h = out_h, first.game_w = game_w, first.game_h = game_h;
+            s.text = format(first);
+            s.version++;
+        }
+        return;
+    }
+    uint64_t dt = now - s.last;
+    s.last = now;
+    s.frames++, s.intervals++, s.sum_ns += dt, s.max_ns = std::max(s.max_ns, dt);
+    uint64_t wall = now - s.window_from;
+    if (wall < 1'000'000'000ull) return;
+    Sample x;
+    x.fps = double(s.frames) * 1e9 / double(wall);
+    x.avg_ms = s.intervals ? double(s.sum_ns) / double(s.intervals) / 1e6 : 0;
+    x.max_ms = double(s.max_ns) / 1e6;
+    x.interval = g_interval.load(std::memory_order_relaxed);
+    double cpu = process_cpu_seconds();
+    x.cpu_pct = cpu >= 0 && s.cpu_from >= 0 ? (cpu - s.cpu_from) * 1e9 / double(wall) * 100.0 : -1;
+    x.cores = std::thread::hardware_concurrency();
+    int64_t rss = resident_bytes();
+    x.rss_mb = rss >= 0 ? double(rss) / (1024.0 * 1024.0) : -1;
+    x.thermal = thermal_state();
+    x.gpu = s.gpu;
+    x.out_w = out_w, x.out_h = out_h, x.game_w = game_w, x.game_h = game_h;
+    s.text = format(x);
+    s.version++;
+    s.window_from = now, s.cpu_from = cpu;
+    s.frames = s.intervals = s.sum_ns = s.max_ns = 0;
+}
+
+std::vector<std::string> lines() {
+    std::lock_guard lk(state().lock);
+    return state().text;
+}
+
+std::shared_ptr<const Bitmap> bitmap(uint32_t height, bool bgra) {
+    State& s = state();
+    std::lock_guard lk(s.lock);
+    uint32_t scale = scale_for(height);
+    if (!s.bitmap || s.bitmap_version != s.version || s.bitmap_scale != scale || s.bitmap_bgra != bgra) {
+        s.bitmap = std::make_shared<const Bitmap>(rasterise(s.text, scale, bgra));
+        s.bitmap_version = s.version, s.bitmap_scale = scale, s.bitmap_bgra = bgra;
+    }
+    return s.bitmap;
+}
+
+bool composite_frame(uint8_t* px, uint32_t w, uint32_t h, bool bgra) {
+    if (!enabled()) return false;
+    std::shared_ptr<const Bitmap> b = bitmap(h, bgra);
+    return b && composite(*b, scale_for(h), px, w, h);
+}
+
+}  // namespace nx::hud
+#endif
