# Native Windows x64 overlay order: runtime/patches/series.linux unchanged, then windows-native.patch (clang-cl
# policy), astral-windows.patch, astral-windows-desktop.patch, astral-windows-mem.patch, then
# astral-windows-perf.patch,
# astral-windows-resident.patch, astral-windows-writeback.patch and astral-windows-replay.patch
# (docs/ASTRAL_WINDOWS_PERF.md).
# Keep the overlay-order tests in step.
apple-memory.patch
astral-bootstrap.patch
astral-control-import.patch
astral-sqshl.patch
astral-notifications.patch
astral-apm.patch
astral-audio.patch
astral-ipc-buffer.patch
