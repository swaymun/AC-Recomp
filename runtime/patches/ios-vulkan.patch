diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -218,6 +218,34 @@
         message(FATAL_ERROR "iOS requires Astral and the reviewed UIKit adapter")
     endif()
     find_path(NX_VULKAN_INCLUDE vulkan/vulkan.h REQUIRED)
+    # BEGIN PINNED IOS VULKAN DEPENDENCY
+    # Public MoltenVK 1.3.0 all-archive simulator slice, source tag 49b97f26.
+    if(NOT NX_IOS_MOLTENVK_LIBRARY OR NOT EXISTS "${NX_IOS_MOLTENVK_LIBRARY}")
+        message(FATAL_ERROR "missing pinned simulator MoltenVK library")
+    endif()
+    execute_process(COMMAND xcrun otool -arch arm64 -l "${NX_IOS_MOLTENVK_LIBRARY}"
+        RESULT_VARIABLE mvk_status OUTPUT_VARIABLE mvk_load ERROR_VARIABLE mvk_error)
+    string(REGEX MATCHALL "platform[ \t]+[A-Za-z0-9_]+" mvk_platforms "${mvk_load}")
+    if(NOT mvk_status EQUAL 0 OR NOT mvk_platforms)
+        message(FATAL_ERROR "missing arm64 simulator LC_BUILD_VERSION")
+    endif()
+    foreach(platform IN LISTS mvk_platforms)
+        if(NOT platform MATCHES "^platform[ \t]+(7|IOSSIMULATOR)$")
+            message(FATAL_ERROR "wrong-platform MoltenVK: ${platform}")
+        endif()
+    endforeach()
+    file(SHA256 "${NX_IOS_MOLTENVK_LIBRARY}" mvk_hash)
+    if(NOT mvk_hash STREQUAL "c6579190db24f622856c7fbc0bd2bdab7a2338f083945aa1ea0cab8afc38df27")
+        message(FATAL_ERROR "unpinned simulator MoltenVK bytes")
+    endif()
+    if(NOT EXISTS "${NX_VULKAN_INCLUDE}/vulkan/vulkan_core.h")
+        message(FATAL_ERROR "missing pinned Vulkan headers")
+    endif()
+    file(SHA256 "${NX_VULKAN_INCLUDE}/vulkan/vulkan_core.h" mvk_header_hash)
+    if(NOT mvk_header_hash STREQUAL "7895976b1c44a002b0670865d2dce844185530d5f25728fc575f70f941935483")
+        message(FATAL_ERROR "unpinned Vulkan headers")
+    endif()
+    # END PINNED IOS VULKAN DEPENDENCY
     add_executable(${NX_GAME} MACOSX_BUNDLE ${NX_RUNTIME_SOURCES}
         runtime/src/platform_ios.mm runtime/src/memguard_mac.cpp
         "${NX_IOS_HOST_DIR}/App.mm" "${NX_IOS_HOST_DIR}/InputBridge.cpp")
@@ -225,8 +253,8 @@
         "${NX_VULKAN_INCLUDE}" "${NX_IOS_HOST_DIR}")
     target_compile_definitions(${NX_GAME} PRIVATE NX_IOS_RUNTIME=1)
     target_compile_options(${NX_GAME} PRIVATE -fvisibility=hidden "$<$<COMPILE_LANGUAGE:OBJCXX>:-fobjc-arc>")
-    target_link_libraries(${NX_GAME} PRIVATE game_main game_sdk
-        "-framework UIKit" "-framework Metal" "-framework MetalKit" "-framework QuartzCore"
+    target_link_libraries(${NX_GAME} PRIVATE game_main game_sdk "${NX_IOS_MOLTENVK_LIBRARY}"
+        "-framework IOSurface" "-framework UIKit" "-framework Metal" "-framework MetalKit" "-framework QuartzCore"
         "-framework Foundation" "-framework CoreGraphics")
     set_target_properties(${NX_GAME} PROPERTIES MACOSX_BUNDLE_INFO_PLIST "${NX_IOS_HOST_DIR}/Info.plist")
 elseif(APPLE)
diff --git a/runtime/src/platform_ios.mm b/runtime/src/platform_ios.mm
