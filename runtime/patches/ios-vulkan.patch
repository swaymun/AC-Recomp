+extern "C" void* acs_vulkan_get_instance_proc_addr();
+extern "C" int acs_vulkan_create_surface(void*, void*, uint64_t*, void*);
+void* vulkan_get_instance_proc_addr() { return acs_vulkan_get_instance_proc_addr(); }
 const char* vulkan_surface_extension() { return "VK_EXT_metal_surface"; }
