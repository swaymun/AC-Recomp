+// Retired references must be released as they are visited: several entries can own one image.
+#pragma once
+#include <atomic>
+#include <cstdint>
+#include <cstdlib>
+#include <cstddef>
+#include <memory>
+#include <vector>
+
+namespace nx::nvn::detail {
+inline bool memory_trace() {
+    static const bool on = [] { const char* e = std::getenv("NX_MEM_TRACE"); return e && e[0] == '1' && !e[1]; }();
+    return on;
+}
+inline bool image_retirement_on() {
+    static const bool on = [] { const char* e = std::getenv("NX_WINDOWS_IMAGE_RETIRE_FIX"); return e && e[0] == '1' && !e[1]; }();
+    return on;
+}
+inline bool image_cache_on() {
+    static const bool on = [] { const char* e = std::getenv("NX_WINDOWS_IMAGE_CACHE"); return e && e[0] == '1' && !e[1]; }();
+    return on;
+}
+inline bool cold_image_candidate(uint64_t last_use, uint64_t now, uint64_t recording,
+                                 bool restorable, bool uploaded, bool rendered, bool texels) {
+    return restorable && uploaded && !rendered && !texels && last_use && recording &&
+        last_use < recording && now > last_use && now - last_use >= 250'000'000ull;
+}
+template<class Image, class Destroy>
+void release_retired_images(std::vector<std::shared_ptr<Image>>& retired, Destroy destroy) {
+    for (auto& image : retired) {
+        if (!image) continue;
+        if (image.use_count() == 1) destroy(*image);
+        // Another entry in this same batch may be the final owner. Keeping this reference
+        // until vector destruction would make every duplicate look externally owned.
+        image.reset();
+    }
+}
+// Only a new, never-written image can be uploaded ahead of the main replay command buffer.
+inline bool fresh_upload_candidate(bool uploaded, bool defined_layout, bool rendered, bool texels,
+                                   bool decoded_astc, uint64_t bytes) {
+    return !uploaded && !defined_layout && !rendered && !texels && decoded_astc && bytes >= (1ull << 20);
+}
+
+// Opt-in lifetime accounting for compute snapshots, including copies held by in-flight slots.
+struct SnapshotStats {
+    std::atomic<uint64_t> live{0}, peak{0}, total{0}, allocations{0}, frees{0};
+};
+inline std::shared_ptr<std::vector<uint8_t>> snapshot_copy(const uint8_t* p, std::size_t size, SnapshotStats* stats) {
+    if (!stats) return p ? std::make_shared<std::vector<uint8_t>>(p, p + size) : std::make_shared<std::vector<uint8_t>>(size);
+    auto* copy = p ? new std::vector<uint8_t>(p, p + size) : new std::vector<uint8_t>(size);
+    uint64_t live = stats->live.fetch_add(size, std::memory_order_relaxed) + size;
+    uint64_t peak = stats->peak.load(std::memory_order_relaxed);
+    while (live > peak && !stats->peak.compare_exchange_weak(peak, live, std::memory_order_relaxed)) {}
+    stats->total.fetch_add(size, std::memory_order_relaxed);
+    stats->allocations.fetch_add(1, std::memory_order_relaxed);
+    // shared_ptr invokes this deleter even if allocating its control block throws.
