new file mode 100644
--- /dev/null
+++ b/runtime/src/win_mem_vk.h
@@ -0,0 +1,61 @@
+// Install once before the first device allocation; never installed without NX_MEM_TRACE=1.
+#pragma once
+#include "win_mem_account.h"
+#include "vk_gen.h"
+namespace nx::memtrace {
+using namespace nx::vk;
+inline PFN_vkAllocateMemory real_allocate = nullptr;
+inline PFN_vkFreeMemory real_free = nullptr;
+inline PFN_vkCreateShaderModule real_shader = nullptr;
+inline PFN_vkDestroyShaderModule real_destroy_shader = nullptr;
+inline PFN_vkCreateGraphicsPipelines real_graphics = nullptr;
+inline PFN_vkCreateComputePipelines real_compute = nullptr;
+inline PFN_vkDestroyPipeline real_destroy_pipeline = nullptr;
+inline VKAPI_ATTR VkResult VKAPI_CALL allocate(VkDevice d, const VkMemoryAllocateInfo* info,
+                                               const VkAllocationCallbacks* cb, VkDeviceMemory* out) {
+    VkResult result = real_allocate(d, info, cb, out);
+    if (result == VK_SUCCESS) ledger().allocated(Domain::Memory, handle(*out), allocation_pool, info->allocationSize);
+    return result;
+}
+inline VKAPI_ATTR void VKAPI_CALL free_memory(VkDevice d, VkDeviceMemory memory, const VkAllocationCallbacks* cb) {
+    ledger().freed(Domain::Memory, handle(memory));
+    real_free(d, memory, cb);
+}
+inline VKAPI_ATTR VkResult VKAPI_CALL shader(VkDevice d, const VkShaderModuleCreateInfo* info,
+                                             const VkAllocationCallbacks* cb, VkShaderModule* out) {
+    VkResult result = real_shader(d, info, cb, out);
+    if (result == VK_SUCCESS) ledger().allocated(Domain::Shader, handle(*out), Pool::ShaderCode, info->codeSize);
+    return result;
+}
+inline VKAPI_ATTR void VKAPI_CALL destroy_shader(VkDevice d, VkShaderModule m, const VkAllocationCallbacks* cb) {
+    ledger().freed(Domain::Shader, handle(m)); real_destroy_shader(d, m, cb);
+}
+inline VKAPI_ATTR VkResult VKAPI_CALL graphics(VkDevice d, VkPipelineCache cache, uint32_t count,
+    const VkGraphicsPipelineCreateInfo* info, const VkAllocationCallbacks* cb, VkPipeline* out) {
+    VkResult result = real_graphics(d, cache, count, info, cb, out);
+    // Vulkan may return successful individual pipeline handles even when the batch fails.
+    for (uint32_t i = 0; i < count; ++i)
+        if (out[i]) ledger().allocated(Domain::Pipeline, handle(out[i]), Pool::GraphicsPipelines, 1);
+    return result;
+}
+inline VKAPI_ATTR VkResult VKAPI_CALL compute(VkDevice d, VkPipelineCache cache, uint32_t count,
+    const VkComputePipelineCreateInfo* info, const VkAllocationCallbacks* cb, VkPipeline* out) {
+    VkResult result = real_compute(d, cache, count, info, cb, out);
+    for (uint32_t i = 0; i < count; ++i)
+        if (out[i]) ledger().allocated(Domain::Pipeline, handle(out[i]), Pool::ComputePipelines, 1);
+    return result;
+}
+inline VKAPI_ATTR void VKAPI_CALL destroy_pipeline(VkDevice d, VkPipeline p, const VkAllocationCallbacks* cb) {
+    ledger().freed(Domain::Pipeline, handle(p)); real_destroy_pipeline(d, p, cb);
+}
+inline void install_vulkan() {
+    if (!enabled() || real_allocate) return;
+    real_allocate = p_vkAllocateMemory; p_vkAllocateMemory = allocate;
+    real_free = p_vkFreeMemory; p_vkFreeMemory = free_memory;
+    real_shader = p_vkCreateShaderModule; p_vkCreateShaderModule = shader;
+    real_destroy_shader = p_vkDestroyShaderModule; p_vkDestroyShaderModule = destroy_shader;
+    real_graphics = p_vkCreateGraphicsPipelines; p_vkCreateGraphicsPipelines = graphics;
+    real_compute = p_vkCreateComputePipelines; p_vkCreateComputePipelines = compute;
+    real_destroy_pipeline = p_vkDestroyPipeline; p_vkDestroyPipeline = destroy_pipeline;
+}
+}  // namespace nx::memtrace
