new file mode 100644
--- /dev/null
+++ b/runtime/src/win_mem_va.h
@@ -0,0 +1,92 @@
+// Read-only commit inventory. VA commitment, explicit Vulkan bytes and PrivateUsage
+// have different accounting domains; report them separately, never add them together.
+#pragma once
+#include <windows.h>
+#include <map>
+#include "win_mem_account.h"
+#include "nvn/nvn_retire.h"
+
+namespace nx::memtrace {
+inline void report_snapshot(const char* name, const nvn::detail::SnapshotStats& s, uint64_t stamp) {
+    log("memtrace: snapshots ts_ns=%llu name=%s live=%llu peak=%llu total=%llu allocations=%llu frees=%llu",
+        (unsigned long long)stamp, name, (unsigned long long)s.live.load(), (unsigned long long)s.peak.load(),
+        (unsigned long long)s.total.load(), (unsigned long long)s.allocations.load(), (unsigned long long)s.frees.load());
+}
+inline void sample(uint64_t private_bytes) {
+    if (!enabled()) return;
+    const uint64_t stamp = plat::monotonic_ns();
+    const auto s = ledger().snapshot();
+    for (size_t i = 0; i < pool_count; ++i) {
+        const auto& c = s.pools[i];
+        log("memtrace: pool ts_ns=%llu name=%s live=%llu peak=%llu total=%llu allocations=%llu frees=%llu unit=%s",
+            (unsigned long long)stamp, names[i], (unsigned long long)c.live, (unsigned long long)c.peak,
+            (unsigned long long)c.total, (unsigned long long)c.allocations, (unsigned long long)c.frees,
+            i == size_t(Pool::GraphicsPipelines) || i == size_t(Pool::ComputePipelines) ? "objects" : "bytes");
+    }
+    log("memtrace: ownership ts_ns=%llu dropped=%llu unknown_frees=%llu orphaned_images=%llu orphaned_bytes=%llu "
+        "retired_refs=%llu staging_buffers=%llu reusable_images=%llu private_bytes=%llu",
+        (unsigned long long)stamp, (unsigned long long)s.dropped, (unsigned long long)s.unknown_frees,
+        (unsigned long long)s.orphaned_images, (unsigned long long)s.orphaned_bytes,
+        (unsigned long long)s.retired_refs, (unsigned long long)s.staging_buffers,
+        (unsigned long long)s.reusable_images, (unsigned long long)private_bytes);
+    report_snapshot("compute", nvn::detail::compute_snapshots, stamp);
+    report_snapshot("resident", nvn::detail::resident_snapshots, stamp);
+    struct Group { uint64_t reserved = 0, committed = 0; bool guard = false; };
+    std::map<uintptr_t, Group> groups;
+    uint64_t committed_private = 0, committed_mapped = 0, committed_image = 0;
+    uint64_t guest_heap = 0, guest_alias = 0, guest_stack_kernel = 0;
+    uintptr_t address = 0;
+    MEMORY_BASIC_INFORMATION info{};
+    auto in = [](uintptr_t p, uint64_t base, uint64_t size) { return p >= base && p - base < size; };
+    bool query_failed = false;
+    SYSTEM_INFO system{}; GetSystemInfo(&system);
+    const auto maximum = reinterpret_cast<uintptr_t>(system.lpMaximumApplicationAddress);
+    while (address <= maximum) {
+        if (!VirtualQueryEx(GetCurrentProcess(), reinterpret_cast<void*>(address), &info, sizeof info)) {
+            query_failed = true; break;
+        }
+        const auto start = reinterpret_cast<uintptr_t>(info.BaseAddress);
+        if (!info.RegionSize || start > UINTPTR_MAX - info.RegionSize || start + info.RegionSize <= address) {
+            query_failed = true; break;
+        }
+        if (info.State != MEM_FREE) {
+            auto& g = groups[reinterpret_cast<uintptr_t>(info.AllocationBase)];
+            g.reserved += info.RegionSize;
+            if (info.State == MEM_COMMIT) {
+                g.committed += info.RegionSize; g.guard |= (info.Protect & PAGE_GUARD) != 0;
+                if (info.Type == MEM_PRIVATE) committed_private += info.RegionSize;
+                else if (info.Type == MEM_MAPPED) committed_mapped += info.RegionSize;
+                else if (info.Type == MEM_IMAGE) committed_image += info.RegionSize;
+                if (in(start, kHeapBase, kHeapMax)) guest_heap += info.RegionSize;
+                if (in(start, kAliasBase, kAliasSize)) guest_alias += info.RegionSize;
+                if (in(start, kStackBase, kStackSize) || in(start, kKernelBase, kKernelSize))
+                    guest_stack_kernel += info.RegionSize;
+            }
+        }
+        address = start + info.RegionSize;
+    }
+    uint64_t guarded_commit = 0, guarded_reserve = 0, guarded_groups = 0;
+    for (const auto& [base, g] : groups) {
+        if (!g.guard) continue;
+        ++guarded_groups; guarded_commit += g.committed; guarded_reserve += g.reserved;
+    }
+    log("memtrace: va ts_ns=%llu private=%llu mapped=%llu image=%llu guest_heap=%llu guest_alias=%llu "
+        "guest_stack_kernel=%llu guarded_stack_groups=%llu guarded_stack_commit=%llu guarded_stack_reserve=%llu query_failed=%u",
+        (unsigned long long)stamp, (unsigned long long)committed_private, (unsigned long long)committed_mapped,
+        (unsigned long long)committed_image, (unsigned long long)guest_heap, (unsigned long long)guest_alias,
+        (unsigned long long)guest_stack_kernel, (unsigned long long)guarded_groups,
+        (unsigned long long)guarded_commit, (unsigned long long)guarded_reserve, unsigned(query_failed));
+    // Preserve the allocation-base inventory at each new 64 MiB private-byte high.
+    // Small reservations remain in the complete aggregate above.
+    static uint64_t last_peak = 0;
+    if (private_bytes > last_peak && private_bytes - last_peak >= (64ull << 20)) {
+        last_peak = private_bytes;
+        for (const auto& [base, g] : groups) {
+            if (g.committed < (16ull << 20) && !g.guard) continue;
+            log("memtrace: va_peak ts_ns=%llu base=%llx reserved=%llu committed=%llu guard=%u private_bytes=%llu",
+                (unsigned long long)stamp, (unsigned long long)base, (unsigned long long)g.reserved,
+                (unsigned long long)g.committed, unsigned(g.guard), (unsigned long long)private_bytes);
+        }
+    }
+}
+}  // namespace nx::memtrace
