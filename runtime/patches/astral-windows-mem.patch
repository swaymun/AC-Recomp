new file mode 100644
--- /dev/null
+++ b/runtime/src/win_mem_account.h
@@ -0,0 +1,104 @@
+// Optional Windows allocation accounting. Values are explicit payload/reservation sizes,
+// not an estimate of opaque driver memory or process commit. No game inputs required.
+#pragma once
+#include <array>
+#include <cstdint>
+#include <cstddef>
+#include <cstdlib>
+#include <map>
+#include <mutex>
+#include <type_traits>
+
+namespace nx::memtrace {
+enum class Pool { Images, UploadRing, Staging, FreshStaging, Resident, OtherVulkan,
+                  ShaderCode, GraphicsPipelines, ComputePipelines, DecodedPrepared,
+                  DecodedStore, HostStackReserve, Count };
+enum class Domain { Memory, Shader, Pipeline, HostStack };
+inline constexpr size_t pool_count = size_t(Pool::Count);
+inline constexpr const char* names[] = {"images", "upload_ring", "staging", "fresh_staging", "resident",
+    "other_vulkan", "shader_code", "graphics_pipelines", "compute_pipelines", "decoded_prepared",
+    "decoded_store", "host_stack_reserve"};
+struct Counter { uint64_t live = 0, peak = 0, total = 0, allocations = 0, frees = 0; };
+struct Sample {
+    std::array<Counter, pool_count> pools{};
+    uint64_t dropped = 0, unknown_frees = 0, orphaned_images = 0, orphaned_bytes = 0;
+    uint64_t retired_refs = 0, staging_buffers = 0, reusable_images = 0;
+};
+inline bool enabled() {
+    static const bool on = [] { const char* e = std::getenv("NX_MEM_TRACE"); return e && e[0] == '1' && !e[1]; }();
+    return on;
+}
+template<class Handle> uint64_t handle(Handle h) {
+    if constexpr (std::is_pointer_v<Handle>) return uint64_t(reinterpret_cast<uintptr_t>(h));
+    else return uint64_t(h);
+}
+// The ledger never holds its mutex across a Vulkan call, logging, or resource release.
+// Failed diagnostics are visible as dropped records; they must never change an API result.
+class Ledger {
+    struct Allocation { Pool pool; uint64_t bytes; };
+    std::mutex mutex;
+    std::map<std::pair<Domain, uint64_t>, Allocation> live;
+    Sample stats;
+    void add(Pool p, uint64_t bytes) {
+        auto& c = stats.pools[size_t(p)];
+        c.live += bytes; c.total += bytes; ++c.allocations;
+        if (c.live > c.peak) c.peak = c.live;
+    }
+    void sub(Pool p, uint64_t bytes) {
+        auto& c = stats.pools[size_t(p)];
+        if (bytes > c.live) { ++stats.dropped; return; }
+        c.live -= bytes; ++c.frees;
+    }
+public:
+    void allocated(Domain domain, uint64_t token, Pool pool, uint64_t bytes) noexcept {
+        try {
+            std::lock_guard lock(mutex);
+            if (!token || !live.emplace(std::make_pair(domain, token), Allocation{pool, bytes}).second) {
+                ++stats.dropped; return;
+            }
+            add(pool, bytes);
+        } catch (...) { note_drop(); }
+    }
+    void freed(Domain domain, uint64_t token) noexcept {
+        if (!token) return;
+        try {
+            std::lock_guard lock(mutex);
+            auto it = live.find({domain, token});
+            if (it == live.end()) { ++stats.unknown_frees; return; }
+            sub(it->second.pool, it->second.bytes); live.erase(it);
+        } catch (...) { note_drop(); }
+    }
+    void payload_add(Pool pool, uint64_t bytes) noexcept {
+        try { std::lock_guard lock(mutex); add(pool, bytes); } catch (...) { note_drop(); }
+    }
+    void payload_free(Pool pool, uint64_t bytes) noexcept {
+        try { std::lock_guard lock(mutex); sub(pool, bytes); } catch (...) { note_drop(); }
+    }
+    void orphaned_image(uint64_t memory) noexcept {
+        try {
+            std::lock_guard lock(mutex);
+            auto it = live.find({Domain::Memory, memory});
+            if (it != live.end() && it->second.pool == Pool::Images) {
+                ++stats.orphaned_images; stats.orphaned_bytes += it->second.bytes;
+            }
+        } catch (...) { note_drop(); }
+    }
+    void retirement(uint64_t refs, uint64_t staging, uint64_t reusable) noexcept {
+        try {
+            std::lock_guard lock(mutex);
+            stats.retired_refs = refs; stats.staging_buffers = staging; stats.reusable_images = reusable;
+        } catch (...) { note_drop(); }
+    }
+    void note_drop() noexcept {
+        try { std::lock_guard lock(mutex); ++stats.dropped; } catch (...) {}
+    }
+    Sample snapshot() { std::lock_guard lock(mutex); return stats; }
+};
+inline Ledger& ledger() { static auto* value = new Ledger; return *value; }  // process lifetime, including deleters
+inline thread_local Pool allocation_pool = Pool::OtherVulkan;
+struct Tag {
+    Pool previous = allocation_pool;
+    explicit Tag(Pool pool) { allocation_pool = pool; }
+    ~Tag() { allocation_pool = previous; }
+};
+}  // namespace nx::memtrace
