diff --git a/runtime/src/windows_env.h b/runtime/src/windows_env.h
new file mode 100644
index 0000000..bf47223
--- /dev/null
+++ b/runtime/src/windows_env.h
@@ -0,0 +1,9 @@
+// Windows CRT equivalent of POSIX setenv; launcher/settings export only before worker threads start.
+#pragma once
+#if defined(_WIN32)
+#include <cstdlib>
+inline int setenv(const char* name, const char* value, int overwrite) {
+    if (!overwrite && std::getenv(name)) return 0;
+    return _putenv_s(name, value);
+}
+#endif
