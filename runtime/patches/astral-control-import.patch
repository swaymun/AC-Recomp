+// Targeted metadata producer: verify PFS hashes, retain only CNMT/NPDM;
+// Control RomFS uses the pinned IVFC reader and retains only control.nacp.
+std::vector<uint8_t> control_pfs(Nca& n, int i) {
+    auto* st = plain_section(n, i); const auto* fs=n.sec[i].fs;
+    if (n.sec[i].is_patch() || n.sec[i].is_sparse()) fail("metadata: unsupported section mapping");
+    uint32_t bs=rd32(fs+0x28);
+    uint64_t ho=rd64(fs+0x30), hs=rd64(fs+0x38), po=rd64(fs+0x40), ps=rd64(fs+0x48);
+    if (!bs || hs>(64u<<20) || ps>(256u<<20) || ho>st->size || hs>st->size-ho || po>st->size || ps>st->size-po)
+        fail("metadata: invalid PFS extent");
+    std::vector<uint8_t> hashes(hs), pfs(ps); uint8_t d[32];
+    st->read(ho,hashes.data(),hashes.size()); sha256(hashes.data(),hashes.size(),d);
+    if(memcmp(d,fs+8,32)) fail("metadata: PFS master hash mismatch");
+    st->read(po,pfs.data(),pfs.size());
+    for(uint64_t b=0;b*bs<ps;++b) {
+        sha256(pfs.data()+b*bs,size_t(std::min<uint64_t>(bs,ps-b*bs)),d);
+        if((b+1)*32>hs || memcmp(d,hashes.data()+b*32,32)) fail("metadata: PFS block hash mismatch");
+    }
+    return pfs;
+}
+struct MetadataMemory : Storage {
+    const std::vector<uint8_t>& v;
+    explicit MetadataMemory(const std::vector<uint8_t>& x):v(x){size=x.size();}
+    void read(uint64_t off,void* p,size_t n) override {
+        if(off>size || n>size-off) fail("metadata: PFS read extent");
+        memcpy(p,v.data()+off,n);
+    }
+};
+void control_extract(Nca& n, const std::string& root, unsigned index, std::ostream& report) {
+    std::string prefix=std::to_string(index); unsigned retained=0;
+    std::string raw_name;
+    for(int i=0;i<4;++i) if(n.sec[i].present) {
+        if(n.sec[i].partition()==1 && (n.content_type==0 || n.content_type==1)) {
+            auto pfs=control_pfs(n,i); MetadataMemory memory(pfs);
+            for(auto& e:read_pfs(&memory,0,false,"metadata")) {
+                bool wanted=n.content_type==0 ? e.name=="main.npdm" : ends_with(e.name,".cnmt");
+                if(!wanted) continue;
+                if(++retained!=1 || e.size>(4u<<20)) fail("metadata: ambiguous or oversized metadata");
+                raw_name=prefix+(n.content_type==0?".npdm":".cnmt");
+                Writer w(root+"/"+raw_name);w.write(pfs.data()+e.off,size_t(e.size));w.commit();
+            }
+        } else if(n.sec[i].partition()==0 && n.content_type==2) {
+            if(n.sec[i].is_patch() || n.sec[i].is_sparse()) fail("metadata: unsupported Control mapping");
+            auto rom=open_ivfc(plain_section(n,i),n.sec[i].fs,"control");
+            uint8_t h[0x50];rom->read(0,h,sizeof h);
+            uint64_t doff=rd64(h+0x18),ds=rd64(h+0x20),foff=rd64(h+0x38),fs=rd64(h+0x40),data=rd64(h+0x48);
+            if(rd64(h)!=0x50 || ds>(4u<<20) || fs>(4u<<20)) fail("metadata: invalid Control RomFS");
+            std::vector<uint8_t> dirs(ds),files(fs);rom->read(doff,dirs.data(),dirs.size());rom->read(foff,files.data(),files.size());
+            std::vector<RomfsFile> list;std::vector<std::string> dirlist;
+            walk_romfs(dirs,files,0,"",list,dirlist,0);
+            for(auto& f:list) if(f.path=="control.nacp") {
+                if(++retained!=1 || f.size!=0x4000 || data>rom->size || f.off>rom->size-data || f.size>rom->size-data-f.off)
+                    fail("metadata: invalid Control NACP");
+                std::vector<uint8_t> nacp(f.size);rom->read(data+f.off,nacp.data(),nacp.size());
+                raw_name=prefix+".nacp";Writer w(root+"/"+raw_name);w.write(nacp.data(),nacp.size());w.commit();
+            }
+        }
+    }
+    if(retained!=1) fail("metadata: missing metadata");
+    // Hash encrypted content, as referenced by CNMT, rather than plaintext.
+    Sha256 hash;std::vector<uint8_t> chunk(kChunk);uint8_t digest[32];
+    for(uint64_t off=0;off<n.file->size;) {
+        size_t m=size_t(std::min<uint64_t>(chunk.size(),n.file->size-off));n.file->read(off,chunk.data(),m);hash.update(chunk.data(),m);off+=m;
+    }
+    hash.final(digest);
+    report << "{\"type\":" << unsigned(n.content_type) << ",\"program_id\":\"" << tid_str(n.title_id)
+           << "\",\"size\":" << n.file->size << ",\"sha256\":\"" << hex(digest,32) << "\",\"raw\":\"" << raw_name << "\"}";
+}
