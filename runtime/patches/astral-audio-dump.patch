diff --git a/runtime/src/wav_stream.h b/runtime/src/wav_stream.h
new file mode 100644
--- /dev/null
+++ b/runtime/src/wav_stream.h
@@ -0,0 +1,99 @@
+// A WAV file written while the audio is produced (hle_audio.cpp: NX_AUDIO_DUMP with NX_AUDIO_DUMP_SECONDS, Astral
+// strict; docs/ASTRAL_AUDIO_DUMP.md). s16 stereo 48 kHz. The RIFF and data sizes in the header are fixed up every
+// `fixup_frames` frames and at close, each time followed by a flush, so a process killed at any moment leaves a
+// playable file holding at least everything up to the last fix-up. Not thread-safe: the caller serialises.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+
+namespace nx {
+
+class WavStream {
+public:
+    static constexpr uint32_t kRate = 48000, kChannels = 2, kFrameBytes = 4, kHeaderBytes = 44;
+    // The data chunk's size is a u32: at most this many frames (about 6.2 hours) go into one file.
+    static constexpr uint64_t kMaxFrames = (0xffffffffull - 36) / kFrameBytes;
+
+    ~WavStream() { close(); }
+
+    // limit_frames 0: no limit but kMaxFrames. False: the file could not be created.
+    bool open(const char* path, uint64_t limit_frames, uint32_t fixup_frames = kRate / 4) {
+        close();
+        f_ = std::fopen(path, "wb");
+        if (!f_) return false;
+        frames_ = since_fixup_ = 0;
+        limit_ = limit_frames && limit_frames < kMaxFrames ? limit_frames : kMaxFrames;
+        every_ = fixup_frames ? fixup_frames : 1;
+        uint8_t h[kHeaderBytes] = {'R', 'I', 'F', 'F', 0, 0, 0, 0, 'W', 'A', 'V', 'E', 'f', 'm', 't', ' '};
+        put32(h + 16, 16);
+        put16(h + 20, 1);  // PCM
+        put16(h + 22, kChannels);
+        put32(h + 24, kRate);
+        put32(h + 28, kRate * kFrameBytes);
+        put16(h + 32, kFrameBytes);
+        put16(h + 34, 16);
+        h[36] = 'd', h[37] = 'a', h[38] = 't', h[39] = 'a';
+        if (std::fwrite(h, 1, sizeof h, f_) != sizeof h) return fail();
+        fixup();  // sizes 36 and 0: an empty but valid file from the start
+        return f_ != nullptr;
+    }
+
+    // Appends `frames` interleaved stereo frames, cut at the limit. False once the limit is reached or a write failed
+    // (the file is then closed, its header final).
+    bool write(const int16_t* pcm, size_t frames) {
+        if (!f_) return false;
+        uint64_t n = frames < limit_ - frames_ ? frames : limit_ - frames_;
+        if (n && std::fwrite(pcm, kFrameBytes, size_t(n), f_) != n) return fail();
+        frames_ += n, since_fixup_ += n;
+        if (frames_ >= limit_) {
+            close();
+            return false;
+        }
+        if (since_fixup_ >= every_) fixup();
+        return f_ != nullptr;
+    }
+
+    // The header's sizes become what was written so far; everything is flushed to the OS.
+    void fixup() {
+        if (!f_) return;
+        uint8_t riff[4], data[4];
+        uint64_t bytes = frames_ * kFrameBytes;
+        put32(riff, uint32_t(36 + bytes));
+        put32(data, uint32_t(bytes));
+        bool ok = std::fflush(f_) == 0 && std::fseek(f_, 4, SEEK_SET) == 0 && std::fwrite(riff, 1, 4, f_) == 4 &&
+                  std::fseek(f_, 40, SEEK_SET) == 0 && std::fwrite(data, 1, 4, f_) == 4 &&
+                  std::fseek(f_, 0, SEEK_END) == 0 && std::fflush(f_) == 0;
+        since_fixup_ = 0;
+        if (!ok) fail();
+    }
+
+    void close() {
+        if (!f_) return;
+        fixup();
+        if (f_) std::fclose(f_);
+        f_ = nullptr;
+    }
+
+    bool is_open() const { return f_ != nullptr; }
+    uint64_t frames() const { return frames_; }
+    bool failed() const { return failed_; }
+
+private:
+    static void put16(uint8_t* p, uint32_t v) { p[0] = uint8_t(v), p[1] = uint8_t(v >> 8); }
+    static void put32(uint8_t* p, uint32_t v) { put16(p, v), put16(p + 2, v >> 16); }
+    bool fail() {
+        if (f_) std::fclose(f_);
+        f_ = nullptr;
+        failed_ = true;
+        return false;
+    }
+
+    FILE* f_ = nullptr;
+    uint64_t frames_ = 0, since_fixup_ = 0, limit_ = 0;
+    uint32_t every_ = kRate / 4;
+    bool failed_ = false;
+};
+
+}  // namespace nx
diff --git a/runtime/src/audio_probe.h b/runtime/src/audio_probe.h
new file mode 100644
--- /dev/null
+++ b/runtime/src/audio_probe.h
@@ -0,0 +1,53 @@
+// Non-blocking diagnostic handoff: one host callback producer, one PCM dump consumer.
+// No file I/O, allocation or logging in the callback. Overflow is counted explicitly.
+#pragma once
+#include <atomic>
+#include <cstdint>
+namespace nx::audio_probe {
+struct Event {
+    uint64_t frame, monotonic_ns, missing_frames, underrun_callbacks, late_ns;
+    bool startup;
+};
+inline constexpr unsigned kCapacity = 1024;
+inline Event events[kCapacity];
+inline std::atomic<unsigned> head{0}, tail{0};
+inline std::atomic<uint64_t> callbacks{0}, requested{0}, underruns{0}, missing{0}, lost{0};
+inline std::atomic<uint64_t> late_callbacks{0};
+inline std::atomic<bool> submitted{false};
+inline bool enabled = false;  // set before the device is resumed
+inline uint64_t previous_ns = 0, previous_frames = 0;
+inline uint64_t cursor = 0;  // callback thread only
+inline void callback(uint64_t frames, uint64_t absent, uint64_t now) {
+    if (!enabled) return;
+    callbacks.fetch_add(1, std::memory_order_relaxed);
+    requested.fetch_add(frames, std::memory_order_relaxed);
+    uint64_t late = 0;
+    if (frames) {
+        const uint64_t expected = previous_frames * 1000000000ull / 48000;
+        if (previous_frames && now > previous_ns && now - previous_ns > expected + 20000000ull)
+            late = now - previous_ns - expected;
+        previous_ns = now, previous_frames = frames;
+    }
+    if (late) late_callbacks.fetch_add(1, std::memory_order_relaxed);
+    if (absent || late) {
+        uint64_t count = absent ? underruns.fetch_add(1, std::memory_order_relaxed) + 1
+                                : underruns.load(std::memory_order_relaxed);
+        missing.fetch_add(absent, std::memory_order_relaxed);
+        unsigned h = head.load(std::memory_order_relaxed), next = (h + 1) % kCapacity;
+        if (next == tail.load(std::memory_order_acquire))
+            lost.fetch_add(1, std::memory_order_relaxed);
+        else {
+            events[h] = {cursor, now, absent, count, late, !submitted.load(std::memory_order_relaxed)};
+            head.store(next, std::memory_order_release);
+        }
+    }
+    cursor += frames;
+}
+inline bool pop(Event& event) {
+    unsigned t = tail.load(std::memory_order_relaxed);
+    if (t == head.load(std::memory_order_acquire)) return false;
+    event = events[t];
+    tail.store((t + 1) % kCapacity, std::memory_order_release);
+    return true;
+}
+}  // namespace nx::audio_probe
