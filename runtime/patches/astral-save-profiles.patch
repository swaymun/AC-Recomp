diff --git a/runtime/src/save_profile.h b/runtime/src/save_profile.h
new file mode 100644
index 0000000..2e6e7ef
--- /dev/null
+++ b/runtime/src/save_profile.h
@@ -0,0 +1,127 @@
+// Save profiles (Astral strict, docs/ASTRAL_LAUNCHER.md): separate save folders the launcher's PLAY picker chooses
+// from. "Default" is <data root>/user/save, where saves have always been (never moved or deleted); every other
+// profile <name> is <data root>/user/profiles/<name>/save. The choice reaches the runtime as NX_SAVE_PROFILE
+// (hle_fs.cpp MountSaveData) and is remembered in settings.ini (`save_profile`). Names are 1 to 32 letters, digits,
+// spaces, '-' or '_', not starting or ending with a space: never a path separator, "." or "..", so a profile's folder
+// is always inside <data root>/user/profiles.
+#pragma once
+#if defined(NX_ASTRAL_STRICT)
+#include <algorithm>
+#include <cctype>
+#include <chrono>
+#include <cstdint>
+#include <ctime>
+#include <filesystem>
+#include <string>
+#include <system_error>
+#include <vector>
+
+namespace nx::saves {
+
+constexpr const char* kDefault = "Default";
+constexpr size_t kMaxName = 32;
+
+inline bool is_default(const std::string& name) {
+    static const char kLower[] = "default";
+    if (name.size() != sizeof kLower - 1) return false;
+    for (size_t i = 0; i < name.size(); i++)
+        if (std::tolower(static_cast<unsigned char>(name[i])) != kLower[i]) return false;
+    return true;
+}
+
+// A profile name as given (any case of "Default" included), or not one.
+inline bool valid_name(const std::string& name) {
+    if (name.empty() || name.size() > kMaxName || name.front() == ' ' || name.back() == ' ') return false;
+    for (char c : name) {
+        unsigned char u = static_cast<unsigned char>(c);
+        if (!(std::isalnum(u) || c == ' ' || c == '-' || c == '_') || u >= 0x80) return false;
+    }
+    return true;
+}
+
+// The name a request stands for: "Default" for unset, empty, invalid or any case of "default".
+inline std::string normalise(const char* requested) {
+    std::string n = requested ? requested : "";
+    if (!valid_name(n) || is_default(n)) return kDefault;
+    return n;
+}
+
+// The save folder of a profile (normalise()d), always beneath <data root>/user.
+inline std::filesystem::path save_dir(const std::filesystem::path& data_root, const std::string& profile) {
+    std::string n = normalise(profile.c_str());
+    if (n == kDefault) return data_root / "user" / "save";
+    return data_root / "user" / "profiles" / std::filesystem::path(n) / "save";
+}
+
+struct Profile {
+    std::string name;
+    int64_t modified = 0;  // newest save file's modification time, seconds since the epoch; 0: no saves yet
+};
+
+// The newest modification time of the files in `dir` (one level of folders below too); 0 when there are none.
+inline int64_t newest(const std::filesystem::path& dir) {
+    namespace fs = std::filesystem;
+    std::error_code ec;
+    fs::file_time_type best = fs::file_time_type::min();
+    bool any = false;
+    for (fs::recursive_directory_iterator it(dir, ec), end; !ec && it != end; it.increment(ec)) {
+        if (it.depth() > 1) continue;
+        std::error_code e2;
+        if (!it->is_regular_file(e2)) continue;
+        fs::file_time_type t = it->last_write_time(e2);
+        if (!e2 && (!any || t > best)) best = t, any = true;
+    }
+    if (!any) return 0;
+    auto sys = std::chrono::time_point_cast<std::chrono::seconds>(
+        best - fs::file_time_type::clock::now() + std::chrono::system_clock::now());
+    return int64_t(sys.time_since_epoch().count());
+}
+
+// Default first, then every valid folder in <data root>/user/profiles, by name.
+inline std::vector<Profile> list(const std::filesystem::path& data_root) {
+    namespace fs = std::filesystem;
+    std::vector<Profile> out{{kDefault, newest(save_dir(data_root, kDefault))}};
+    std::vector<std::string> names;
+    std::error_code ec;
+    for (fs::directory_iterator it(data_root / "user" / "profiles", ec), end; !ec && it != end; it.increment(ec)) {
+        std::error_code e2;
+        if (it->is_symlink(e2) || !it->is_directory(e2)) continue;  // a link could lead out of the data root
+        std::string n = it->path().filename().string();  // valid names are ASCII
+        if (valid_name(n) && !is_default(n)) names.push_back(n);
+    }
+    std::sort(names.begin(), names.end());
+    for (const std::string& n : names) out.push_back({n, newest(save_dir(data_root, n))});
+    return out;
+}
+
+// "Profile 2", "Profile 3", ...: the first not in `have` (case-insensitively).
+inline std::string next_name(const std::vector<Profile>& have) {
+    auto lower = [](std::string s) {
+        for (char& c : s) c = char(std::tolower(static_cast<unsigned char>(c)));
+        return s;
+    };
+    for (int k = 2;; k++) {
+        std::string n = "Profile " + std::to_string(k);
+        bool used = false;
+        for (const Profile& p : have) used = used || lower(p.name) == lower(n);
+        if (!used) return n;
+    }
+}
+
+// "Last played 2026-10-19 15:44" (local time), or "No saves yet".
+inline std::string modified_text(int64_t t) {
+    if (t <= 0) return "No saves yet";
+    std::time_t tt = std::time_t(t);
+    std::tm tm{};
+#if defined(_WIN32)
+    localtime_s(&tm, &tt);
+#else
+    localtime_r(&tt, &tm);
+#endif
+    char buf[64];
+    std::strftime(buf, sizeof buf, "Last played %Y-%m-%d %H:%M", &tm);
+    return buf;
+}
+
+}  // namespace nx::saves
+#endif
