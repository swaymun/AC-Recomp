diff --git a/runtime/src/nvn/nvn_gap_helpers.h b/runtime/src/nvn/nvn_gap_helpers.h
new file mode 100644
index 0000000..697fc22
--- /dev/null
+++ b/runtime/src/nvn/nvn_gap_helpers.h
@@ -0,0 +1,109 @@
+// Original NVN gap helpers. No guest shader bytes or game constants belong here.
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <map>
+#include <vector>
+
+namespace nx::nvn {
+constexpr uint32_t kAlphaRefSpecId = 0xAC14;
+inline float supported_line_width(float requested, bool wide, float lo, float hi) {
+    if (!std::isfinite(requested) || requested <= 0) fatal("nvn: invalid line width");
+    return wide ? std::clamp(requested, lo, hi) : 1.0f;
+}
+
+// Reject impossible compute-copy ranges before pointer arithmetic or host allocations.
+inline bool written_range_fits(uint64_t address, uint64_t size, uint64_t padded, uint64_t capacity) {
+    return address && size && size <= UINTPTR_MAX - address && padded >= size && padded <= capacity;
+}
+inline bool written_copy_fits(uint64_t size, uint64_t off, uint64_t padded, uint64_t capacity) {
+    constexpr uint64_t tail = 0x10000 + 16, align = 256;
+    return capacity >= tail + align && size <= capacity - tail - align &&
+           padded <= capacity - align && off <= capacity - align - padded;
+}
+
+// Add a specialization-controlled alpha comparison at each normal exit of the fragment entry point.
+// The translator emits location 0 as a float4 Output variable. Unrecognized active layouts fail visibly.
+inline bool patch_alpha_test(std::vector<uint32_t>& code, uint32_t func) {
+    if (func == 0 || func == 8) return true;  // unbound/default state, ALWAYS
+    if (func > 8 || code.size() < 5) return false;
+    uint32_t entry = 0, output = 0, float_t = 0, bool_t = 0, vector_t = 0;
+    size_t types_at = 0, functions_at = 0;
+    std::map<uint32_t, uint32_t> locations, pointers, variables;
+    std::map<uint32_t, std::pair<uint32_t, uint32_t>> vectors;
+    for (size_t i = 5; i < code.size();) {
+        const uint32_t wc = code[i] >> 16, op = code[i] & 0xffff;
+        if (!wc || i + wc > code.size()) return false;
+        if (!types_at && op >= 19 && op <= 39) types_at = i;
+        if (!functions_at && op == 54) functions_at = i;
+        if (op == 15 && wc >= 4 && code[i+1] == 4) {
+            if (entry) return false;  // multiple fragment entry points need per-entry interface selection
+            entry = code[i+2];
+        }
+        if (op == 71 && wc >= 4 && code[i+2] == 30) locations[code[i+1]] = code[i+3];
+        if (op == 71 && wc >= 4 && code[i+2] == 1 && code[i+3] == kAlphaRefSpecId) return false;
+        if (op == 20 && wc == 2) bool_t = code[i+1];
+        if (op == 22 && wc == 3 && code[i+2] == 32) float_t = code[i+1];
+        if (op == 23 && wc == 4) vectors[code[i+1]] = {code[i+2], code[i+3]};
+        if (op == 32 && wc == 4 && code[i+2] == 3) pointers[code[i+1]] = code[i+3];
+        if (op == 59 && wc >= 4 && code[i+3] == 3) variables[code[i+2]] = code[i+1];
+        i += wc;
+    }
+    if (!entry || !types_at || !functions_at) return false;
+    for (const auto& [id, loc] : locations) {
+        auto var = variables.find(id);
+        if (loc || var == variables.end()) continue;
+        auto ptr = pointers.find(var->second);
+        if (ptr == pointers.end()) return false;
+        auto vec = vectors.find(ptr->second);
+        if (vec == vectors.end() || vec->second.first != float_t || vec->second.second != 4) return false;
+        output = id, vector_t = ptr->second;
+    }
+    uint32_t bound = code[3];
+    auto id = [&] { return bound++; };
+    std::vector<uint32_t> declarations, annotations, out(code.begin(), code.begin()+5);
+    auto emit = [](std::vector<uint32_t>& dst, uint32_t op, std::initializer_list<uint32_t> args) {
+        dst.push_back((uint32_t(args.size()+1) << 16) | op);
+        dst.insert(dst.end(), args.begin(), args.end());
+    };
+    if (!bool_t) { bool_t = id(); emit(declarations, 20, {bool_t}); }
+    if (!float_t) { float_t = id(); emit(declarations, 22, {float_t, 32}); }
+    uint32_t ref = id(), one = id();
+    emit(declarations, 50, {float_t, ref, 0});  // OpSpecConstant float, default 0
+    emit(declarations, 43, {float_t, one, 0x3f800000});
+    emit(annotations, 71, {ref, 1, kAlphaRefSpecId});
+    uint32_t function = 0;
+    const uint32_t compare[] = {0, 0, 184, 180, 188, 186, 183, 190};
+    for (size_t i = 5; i < code.size();) {
+        uint32_t wc = code[i] >> 16, op = code[i] & 0xffff;
+        if (i == types_at) out.insert(out.end(), annotations.begin(), annotations.end());
+        if (i == functions_at) out.insert(out.end(), declarations.begin(), declarations.end());
+        if (op == 54) function = code[i+2];
+        // Fixed-function alpha test discards before depth/stencil writes. EarlyFragmentTests would defeat it.
+        if (op == 16 && wc == 3 && code[i+1] == entry && code[i+2] == 9) { i += wc; continue; }
+        if (op == 253 && function == entry) {
+            if (func == 1) { emit(out, 252, {}); i += wc; continue; }  // NEVER
+            uint32_t alpha = one;
+            if (output) {
+                uint32_t value = id(); alpha = id();
+                emit(out, 61, {vector_t, value, output});
+                emit(out, 81, {float_t, alpha, value, 3});
+            }
+            uint32_t pass = id(), merge = id(), kill = id();
+            emit(out, compare[func], {bool_t, pass, alpha, ref});
+            emit(out, 247, {merge, 0});
+            emit(out, 250, {pass, merge, kill});
+            emit(out, 248, {kill}); emit(out, 252, {});
+            emit(out, 248, {merge});
+        }
+        out.insert(out.end(), code.begin()+i, code.begin()+i+wc);
+        if (op == 56) function = 0;
+        i += wc;
+    }
+    out[3] = bound;
+    code.swap(out);
+    return true;
+}
+}  // namespace nx::nvn
