+// One retained completion per command-fence execution. A reused list receives a fresh completion on
+// each submission, so an older queued execution cannot release a wait on a newer one.
+struct FenceCompletion {
+    std::mutex mutex;
+    std::condition_variable cv;
+    bool done = false;
+    void signal() { { std::lock_guard lk(mutex); done = true; } cv.notify_all(); }
+    uint32_t wait(uint64_t timeout) {
+        std::unique_lock lk(mutex);
+        if (done) return 0;  // ALREADY_SIGNALED
+        if (!timeout) return 2;  // TIMEOUT_EXPIRED
+        if (timeout == UINT64_MAX) cv.wait(lk, [&] { return done; });
+        else if (!cv.wait_for(lk, std::chrono::nanoseconds(std::min<uint64_t>(timeout, INT64_MAX)),
+                              [&] { return done; })) return 2;
+        return 1;  // CONDITION_SATISFIED
+    }
+};
+struct CommandFence {
+    uint64_t guest = 0;
+    bool submitted = false;
+    std::shared_ptr<FenceCompletion> completion = std::make_shared<FenceCompletion>();
+};
