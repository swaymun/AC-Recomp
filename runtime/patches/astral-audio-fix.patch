+                    std::memory_order_release, std::memory_order_relaxed)) {}
+    }
+    Packet* take() noexcept {
+        Packet* list = head_.exchange(nullptr, std::memory_order_acquire);
+        Packet* ordered = nullptr;
+        while (list) {
+            Packet* next = list->next;
+            list->next = ordered;
+            ordered = list;
+            list = next;
+        }
+        return ordered;
+    }
