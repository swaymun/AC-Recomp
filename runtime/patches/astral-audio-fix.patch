diff --git a/runtime/src/audio_clock.h b/runtime/src/audio_clock.h
new file mode 100644
--- /dev/null
+++ b/runtime/src/audio_clock.h
@@ -0,0 +1,19 @@
+// A timer fallback paced by cumulative sample duration, with bounded catch-up after a stall.
+#pragma once
+#include <chrono>
+namespace nx {
+class AudioClock {
+public:
+    using Clock = std::chrono::steady_clock;
+    Clock::time_point advance(Clock::time_point now, Clock::duration duration) {
+        if (!active_ || now > next_ + duration) next_ = now;
+        active_ = true;
+        next_ += duration;
+        return next_;
+    }
+    void reset() { active_ = false; }
+private:
+    Clock::time_point next_{};
+    bool active_ = false;
+};
+}  // namespace nx
